<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Roblox.Thumbnails.Relay.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
    </sectionGroup>
    <section name="robloxConfigurationProvider" type="Roblox.Configuration.ProviderConfigSection, Roblox.Configuration" requirePermission="false"/>
  </configSections>
  <robloxConfigurationProvider configSource="Roblox.Configuration.config"/>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="RelayBindingConfiguration" maxBufferPoolSize="524288" maxBufferSize="5242880" maxReceivedMessageSize="5242880">
          <readerQuotas maxStringContentLength="5242880" maxArrayLength="5242880" maxBytesPerRead="4096" maxDepth="32" maxNameTableCharCount="16384"/>
        </binding>
      </basicHttpBinding>
    </bindings>
    <services>
      <service name="Roblox.Thumbnails.Relay.ThumbnailsRelay" behaviorConfiguration="relayBehaviorConfiguration">
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:64988"/>
          </baseAddresses>
        </host>
        <endpoint name="ThumbnailsRelay" address="" binding="basicHttpBinding" bindingConfiguration="RelayBindingConfiguration" contract="ThumbnailsRelay"/>
        <endpoint contract="IMetadataExchange" binding="mexHttpBinding" address="mex"/>
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior name="relayBehaviorConfiguration">
          <serviceThrottling maxConcurrentCalls="2147483647" maxConcurrentInstances="2147483647" maxConcurrentSessions="2147483647"/>
          <serviceMetadata/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
  <applicationSettings>
    <Roblox.Thumbnails.Relay.Properties.Settings>
      <setting name="LogLevel" serializeAs="String">
        <value>Information</value>
      </setting>
      <setting name="LogName" serializeAs="String">
        <value>RTR1.Roblox.Thumbnails.Relay</value>
      </setting>
      <setting name="ArbiterEndpoint" serializeAs="String">
        <value>http://localhost:64989</value>
      </setting>
      <setting name="RccJobLeaseDurationPerThumbnailTypeJsonString" serializeAs="String">
        <value>{}</value>
      </setting>
      <setting name="RccJobLeaseDuration" serializeAs="String">
        <value>00:01:00</value>
      </setting>
    </Roblox.Thumbnails.Relay.Properties.Settings>
  </applicationSettings>
</configuration>

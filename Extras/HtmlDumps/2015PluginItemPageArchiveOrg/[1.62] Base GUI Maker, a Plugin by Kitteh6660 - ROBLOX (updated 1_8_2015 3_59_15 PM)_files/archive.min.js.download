        @keyframes dot {
          0% {
            opacity: 0;
          }
          25% {
            opacity: 1;
          }
          100% {
            opacity: 0;
          }
        }
      `]}};F([Ci({type:String})],ho.prototype,"loadingTitle",void 0);F([Ci({type:String})],ho.prototype,"successTitle",void 0);F([Ci({type:String})],ho.prototype,"errorTitle",void 0);F([Ci({type:String})],ho.prototype,"loadingStyle",void 0);F([Ci({type:String})],ho.prototype,"mode",void 0);ho=F([Gr("ia-status-indicator")],ho);var dh={CategoryChanged:"categoryChanged",SearchRequested:"searchRequested"},on=class extends dn{constructor(){super(...arguments),this.categories=[],this.placeholder=ue("Search"),this.useMobileView=!1,this.hideDropdown=!1,this.loading=!1}get resolvedCategory(){var t,i,a,c;return(c=(a=this.selectedCategory)!=null?a:(i=(t=this.categories)==null?void 0:t[0])==null?void 0:i.id)!=null?c:""}render(){return ki`

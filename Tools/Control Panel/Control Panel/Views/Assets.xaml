<UserControl x:Class="Control_Panel.AssetsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Control_Panel"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Background="{DynamicResource Background}">
    <UserControl.Resources>
        <DataTemplate x:Key="CatalogBoxTemplate">
            <Button x:Name="ItemRoot" Margin="5" Width="125" Cursor="Hand" Background="Transparent" BorderThickness="0" 
                    Click="CatalogItem_Click" Tag="{Binding Id}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" ClipToBounds="False">
                            <Border x:Name="CatalogItemBorder" BorderThickness="1" 
                                    Height="195" VerticalAlignment="Top" ClipToBounds="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ItemRoot}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SubtleText}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="120"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{DynamicResource Background}" CornerRadius="4,4,0,0">
                                        <Image Source="{Binding ThumbnailUrl}" 
                                               Stretch="Uniform" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Center"
                                               Margin="5">
                                        </Image>
                                    </Border>
                                    <TextBlock Grid.Row="1" 
                                               Text="{Binding Name}" 
                                               FontSize="12" 
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" 
                                               TextTrimming="CharacterEllipsis"
                                               Margin="8,6,8,2"
                                               VerticalAlignment="Top"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource Foreground}"/>
                                    <Border Grid.Row="2" Background="{DynamicResource Background}" CornerRadius="0,0,4,4" Margin="0,2,0,0">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="R$ " FontSize="11" FontWeight="Bold" Foreground="#008000"/>
                                                <TextBlock Text="{Binding Price}" FontSize="11" FontWeight="Bold" Foreground="#008000" Margin="2,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TixPrice}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TixPrice}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="Tx$ " FontSize="11" FontWeight="Bold" Foreground="#FFD700"/>
                                                <TextBlock Text="{Binding TixPrice}" FontSize="11" FontWeight="Bold" Foreground="#FFD700" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="HoverOverlay" 
                                    Background="{DynamicResource Background}"
                                    BorderBrush="{DynamicResource SubtleText}" 
                                    BorderThickness="1,0,1,1" 
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="9999">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="194"/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ItemRoot}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Margin="6,4,6,6">
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="Creator: " FontSize="11" Foreground="{DynamicResource SubtleText}" FontWeight="SemiBold"/>
                                        <Button x:Name="CreatorLinkButton" 
                                                Content="{Binding Creator}" 
                                                FontSize="11" 
                                                Foreground="{DynamicResource AccentPrimary}" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                Padding="0" 
                                                Cursor="Hand"
                                                Click="CreatorLinkButton_Click"
                                                Tag="{Binding Creator}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <TextBlock Text="{TemplateBinding Content}" 
                                                                           TextDecorations="None"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <TextBlock Text="{TemplateBinding Content}" 
                                                                                   TextDecorations="Underline"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="Updated: " FontSize="11" Foreground="{DynamicResource SubtleText}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding UpdatedTime}" FontSize="11" Foreground="{DynamicResource Foreground}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="Type: " FontSize="11" Foreground="{DynamicResource SubtleText}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{DynamicResource Foreground}"/>
                                        </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <local:SettingsOverlay x:Name="GlobalSettingsOverlay" Grid.RowSpan="2" Panel.ZIndex="9999"/>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <StackPanel Margin="0,0,0,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Control Panel - Assets" Style="{StaticResource DashboardTitle}" 
                                       Foreground="{DynamicResource AccentPrimary}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Roblox Webserver Asset Management" 
                                       Style="{StaticResource DashboardSubtitle}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="Both"
                          CanContentScroll="False">
                <StackPanel ClipToBounds="False">
                    <StackPanel Margin="20,0,20,0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="AssetUploadTabButton" Content="Asset Upload" 
                                Style="{StaticResource ModernButton}" 
                                Background="{DynamicResource AccentPrimary}"
                                Foreground="White"
                                Height="40" Width="120" Margin="0,0,5,0"
                                Click="AssetUploadTabButton_Click"/>
                        <Button x:Name="AssetConfigTabButton" Content="Asset Configuration" 
                                Height="40" Width="160" Margin="5,0,0,0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource SubtleText}"
                                Foreground="{DynamicResource Foreground}"
                                Click="AssetConfigTabButton_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="AssetSearchTabButton" Content="Asset Catalog" 
                                Height="40" Width="120" Margin="5,0,0,0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource SubtleText}"
                                Foreground="{DynamicResource Foreground}"
                                Click="AssetSearchTabButton_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Line X1="20" Y1="0" X2="1" Y2="0" Stretch="Fill" 
                          Stroke="{DynamicResource SubtleText}" StrokeThickness="1" 
                          Margin="20,0,20,0"/>
                    <Grid x:Name="AssetUploadTab" Margin="20,20,20,0" Visibility="Visible">
                        <Border Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                BorderThickness="1" Padding="15" MinHeight="300">
                            <StackPanel>
                                <TextBlock Text="Asset Upload" Style="{StaticResource DashboardSectionTitle}" 
                                           Foreground="{DynamicResource AccentBlue}"/>
                                <TextBlock Text="Asset ID: (By Default leave blank)" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <TextBox x:Name="AssetIdTextBox" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="30" Margin="0,0,0,15"
                                         Padding="4,2,8,0" FontSize="14"
                                         Tag="Enter asset ID..."/>
                                <TextBlock Text="Asset Name:" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <TextBox x:Name="AssetNameTextBox" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="30" Margin="0,0,0,15"
                                         Padding="4,2,8,0" FontSize="14"
                                         Tag="Enter asset name..."/>
                                <TextBlock Text="Description:" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <TextBox x:Name="AssetDescriptionTextBox" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="80" Margin="0,0,0,15"
                                         Padding="4,2,8,0" FontSize="14"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Tag="Enter asset description..."/>
                                <TextBlock Text="Asset Type:" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="AssetTypeComboBox" 
                                          Style="{StaticResource ModernComboBox}"
                                          Height="30" Margin="0,0,0,15"
                                          SelectionChanged="AssetTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Decal (1)"/>
                                    <ComboBoxItem Content="T-Shirt (2)"/>
                                    <ComboBoxItem Content="Place (9) (Wont be added for some time)" IsEnabled="False" Foreground="Gray"/>
                                    <ComboBoxItem Content="Shirt (11)"/>
                                    <ComboBoxItem Content="Pants (12)"/>
                                </ComboBox>
                                <StackPanel x:Name="PriceFieldsPanel" Margin="0,0,0,15" Visibility="Collapsed">
                                    <TextBlock Text="Price:" Style="{StaticResource LabelText}" 
                                               Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Robux:" Style="{StaticResource LabelText}" 
                                                       Foreground="{DynamicResource Foreground}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="RobuxPriceTextBox" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Height="30" Padding="4,2,8,0" FontSize="14"
                                                     Tag="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tix:" Style="{StaticResource LabelText}" 
                                                       Foreground="{DynamicResource Foreground}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TixPriceTextBox" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Height="30" Padding="4,2,8,0" FontSize="14"
                                                     Tag="0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel x:Name="ItemOptionsPanel" Margin="0,0,0,15" Visibility="Collapsed">
                                    <TextBlock Text="Item Options:" Style="{StaticResource LabelText}" 
                                               Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="IsLimitedCheckBox" Content="Is Limited" 
                                                  Style="{StaticResource ModernCheckBox}"
                                                  Grid.Column="0"
                                                  Checked="IsLimitedCheckBox_Checked" 
                                                  Unchecked="IsLimitedCheckBox_Unchecked"/>
                                        <CheckBox x:Name="PutOnSaleCheckBox" Content="Put on sale" 
                                                  Style="{StaticResource ModernCheckBox}"
                                                  Grid.Column="2"
                                                  IsChecked="True"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel x:Name="LimitedFieldsPanel" Margin="0,0,0,15" Visibility="Collapsed">
                                    <Grid x:Name="LimitedFieldsGrid" IsEnabled="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Available Until:" Style="{StaticResource LabelText}" 
                                                       Foreground="{DynamicResource Foreground}" Margin="0,0,0,3"/>
                                            <DatePicker x:Name="LimitedUntilDatePicker" 
                                                       Height="30" FontSize="14"
                                                       DisplayDateStart="{x:Static sys:DateTime.Today}">
                                                <DatePicker.Resources>
                                                    <sys:DateTime x:Key="Today">2025-02-22</sys:DateTime>
                                                </DatePicker.Resources>
                                                <DatePicker.Style>
                                                    <Style TargetType="{x:Type DatePicker}">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DatePicker.Style>
                                            </DatePicker>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Quantity:" Style="{StaticResource LabelText}" 
                                                       Foreground="{DynamicResource Foreground}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="LimitedQuantityTextBox" 
                                             Height="30" Padding="4,2,8,0" FontSize="14"
                                             Tag="0">
                                                <TextBox.Style>
                                                    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource ModernTextBox}">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Text="Select File:" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SelectedFileTextBox" 
                                             Style="{StaticResource ModernTextBox}" 
                                             Height="30" Grid.Column="0"
                                             Padding="4,2,8,0" FontSize="14"
                                             IsReadOnly="True"
                                             Tag="No file selected..."/>
                                    <Button Grid.Column="1" Content="Browse" 
                                            Style="{StaticResource ModernButton}" 
                                            Background="{DynamicResource AccentPrimary}"
                                            Width="80" Height="30" Margin="5,0,0,0"
                                            Click="BrowseButton_Click"/>
                                </Grid>
                                <Button x:Name="UploadButton" Content="Upload" 
                                        Style="{StaticResource ModernButton}" 
                                        Background="{DynamicResource AccentPrimary}"
                                        Width="80" Height="35" HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        Click="UploadButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid x:Name="AssetConfigTab" Margin="20,20,20,0" Visibility="Collapsed">
                        <Border Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                BorderThickness="1" Padding="15">
                                <StackPanel>
                                <TextBlock Text="Asset Configuration" Style="{StaticResource DashboardSectionTitle}" 
                                           Foreground="{DynamicResource AccentOrange}"/>
                                <TextBlock Text="Configure asset upload paths and URLs." 
                                           Style="{StaticResource DashboardSectionDescription}" 
                                           Margin="0,0,0,20"/>
                                <Border Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                        BorderThickness="1" Padding="15" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="File Paths Configuration" Style="{StaticResource DashboardSectionTitle}" 
                                                   Foreground="{DynamicResource AccentBlue}" FontSize="14"/>
                                        <TextBlock Text="Assets Directory:" Style="{StaticResource LabelText}" 
                                                   Foreground="{DynamicResource Foreground}" Margin="0,10,0,5"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="AssetsDirectoryTextBox" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Height="30" Grid.Column="0"
                                                     Padding="4,2,8,0" FontSize="14"/>
                                            <Button Grid.Column="1" Content="Browse" 
                                                    Style="{StaticResource ModernButton}" 
                                                    Background="{DynamicResource AccentPrimary}"
                                                    Width="80" Height="30" Margin="5,0,0,0"
                                                    Click="BrowseAssetsDirectory_Click"/>
                                        </Grid>
                                        <TextBlock Text="T-Shirt Template Image:" Style="{StaticResource LabelText}" 
                                                   Foreground="{DynamicResource Foreground}" Margin="0,10,0,5"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TshirtTemplatePathTextBox" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Height="30" Grid.Column="0"
                                                     Padding="4,2,8,0" FontSize="14"/>
                                            <Button Grid.Column="1" Content="Browse" 
                                                    Style="{StaticResource ModernButton}" 
                                                    Background="{DynamicResource AccentPrimary}"
                                                    Width="80" Height="30" Margin="5,0,0,0"
                                                    Click="BrowseTshirtTemplate_Click"/>
                                        </Grid>
                                        <TextBlock Text="T-Shirt High-Res Template Image:" Style="{StaticResource LabelText}" 
                                                   Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TshirtTemplateHighResPathTextBox" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Height="30" Grid.Column="0"
                                                     Padding="4,2,8,0" FontSize="14"/>
                                            <Button Grid.Column="1" Content="Browse" 
                                                    Style="{StaticResource ModernButton}" 
                                                    Background="{DynamicResource AccentPrimary}"
                                                    Width="80" Height="30" Margin="5,0,0,0"
                                                    Click="BrowseTshirtTemplateHighRes_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                        BorderThickness="1" Padding="15" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="URL Configuration" Style="{StaticResource DashboardSectionTitle}" 
                                                   Foreground="{DynamicResource AccentBlue}" FontSize="14"/>
                                        <TextBlock Text="CDN Base URL:" Style="{StaticResource LabelText}" 
                                                   Foreground="{DynamicResource Foreground}" Margin="0,10,0,5"/>
                                        <TextBox x:Name="CDNUrlTextBox" 
                                                 Style="{StaticResource ModernTextBox}" 
                                                 Height="30" Margin="0,0,0,10"
                                                 Padding="4,2,8,0" FontSize="14"
                                                 ToolTip="CDN Base URL (e.g., https://cdn.example.com). HTTP/HTTPS will be added automatically if missing."/>
                                        <TextBlock Text="Public Base URL:" Style="{StaticResource LabelText}" 
                                                   Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="PublicBaseUrlTextBox" 
                                                 Style="{StaticResource ModernTextBox}" 
                                                 Height="30" Margin="0,0,0,10"
                                                 Padding="4,2,8,0" FontSize="14"
                                                 ToolTip="Public Base URL (e.g., https://example.com). HTTP/HTTPS will be added automatically if missing."/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                        BorderThickness="1" Padding="15" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Upload Configuration" Style="{StaticResource DashboardSectionTitle}" 
                                                   Foreground="{DynamicResource AccentBlue}" FontSize="14"/>
                                        <TextBlock Text="Default Owner User ID:" Style="{StaticResource LabelText}" 
                                                   Foreground="{DynamicResource Foreground}" Margin="0,10,0,5"/>
                                        <TextBox x:Name="DefaultOwnerUserIdTextBox" 
                                                 Style="{StaticResource ModernTextBox}" 
                                                 Height="30" Margin="0,0,0,10"
                                                 Padding="4,2,8,0" FontSize="14"
                                                 Tag="Enter user ID (default: 1)"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                        BorderThickness="1" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="Status" Style="{StaticResource DashboardSectionTitle}" 
                                                   Foreground="{DynamicResource AccentBlue}" FontSize="14"/>
                                        <Button x:Name="SaveConfigButton" Content="Save Configuration" 
                                                Style="{StaticResource ModernButton}" 
                                                Background="{DynamicResource AccentPrimary}"
                                                Foreground="White"
                                                Width="150" Height="35" HorizontalAlignment="Left"
                                                Click="SaveConfigButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid x:Name="AssetSearchTab" Margin="20,20,20,0" Visibility="Collapsed" ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                                <Grid Margin="0,0,0,10" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="AssetTypeFilter" 
                                              Height="30" Margin="0,0,5,0" Width="100"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="AssetTypeFilter_SelectionChanged">
                                        <ComboBoxItem Content="All Types" IsSelected="True"/>
                                        <ComboBoxItem Content="Decal"/>
                                        <ComboBoxItem Content="T-Shirt"/>
                                        <ComboBoxItem Content="Shirt"/>
                                        <ComboBoxItem Content="Pants"/>
                                    </ComboBox>
                                    <ComboBox Grid.Column="1" x:Name="DateFilter" 
                                              Height="30" Margin="2.5,0" Width="100"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="DateFilter_SelectionChanged">
                                        <ComboBoxItem Content="Any Time" IsSelected="True"/>
                                        <ComboBoxItem Content="Today"/>
                                        <ComboBoxItem Content="This Week"/>
                                        <ComboBoxItem Content="This Month"/>
                                        <ComboBoxItem Content="This Year"/>
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" x:Name="SortFilter" 
                                              Height="30" Margin="5,0,0,0" Width="120"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="SortFilter_SelectionChanged">
                                        <ComboBoxItem Content="Most Recent" IsSelected="True"/>
                                        <ComboBoxItem Content="The Oldest"/>
                                        <ComboBoxItem Content="Name A-Z"/>
                                        <ComboBoxItem Content="Name Z-A"/>
                                        <ComboBoxItem Content="Asset ID"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="AssetSearchTextBox" 
                                             Style="{StaticResource ModernTextBox}" 
                                             Height="30" Margin="0,0,5,0"
                                             TextChanged="AssetSearchTextBox_TextChanged"
                                             Padding="4,1,8,0" ToolTip="Search by Asset Name" FontSize="16"
                                             HorizontalContentAlignment="Stretch" TextWrapping="NoWrap"
                                             Tag="Search by Asset Name"
                                             GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                                    <TextBox Grid.Column="1" x:Name="AssetIdSearchTextBox" 
                                             Style="{StaticResource ModernTextBox}" 
                                             Height="30" Margin="0"
                                             TextChanged="AssetIdSearchTextBox_TextChanged"
                                             KeyDown="AssetIdSearchTextBox_KeyDown"
                                             Padding="4,1,8,0" ToolTip="Enter ID to manage asset"
                                             HorizontalContentAlignment="Stretch" TextWrapping="NoWrap"
                                             Tag="Enter asset ID"
                                             GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                                </Grid>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,10,0,0" ClipToBounds="False">
                            <ItemsControl x:Name="AssetItemsControl" ClipToBounds="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ClipToBounds="False" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Panel.ZIndex" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Panel.ZIndex" Value="100"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button x:Name="SearchItemRoot" Margin="5" Width="125" Cursor="Hand" Background="Transparent" BorderThickness="0" 
                                                    Click="CatalogItem_Click" Tag="{Binding Id}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Background="Transparent" ClipToBounds="False">
                                                            <Border x:Name="SearchItemBorder" Height="195" 
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Top" ClipToBounds="False">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=SearchItemRoot}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource SubtleText}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <Border Width="100" Height="100" Margin="10" Background="{DynamicResource Background}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Image Source="{Binding ThumbnailUrl}" Stretch="Uniform"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}" 
                                                                               TextWrapping="Wrap" TextAlignment="Left"
                                                                               Margin="5,5,5,0" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                                                    <StackPanel Orientation="Vertical" Margin="5,2,5,5">
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                                            <TextBlock Text="R$" Foreground="#008000" FontWeight="Bold" FontSize="12"/>
                                                                            <TextBlock Text="{Binding Price}" Foreground="#008000" FontWeight="Bold" FontSize="12" Margin="2,0,0,0"/>
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding TixPrice}" Value="{x:Null}">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding TixPrice}" Value="0">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            <TextBlock Text="Tx$" Foreground="#FFD700" FontWeight="Bold" FontSize="12"/>
                                                                            <TextBlock Text="{Binding TixPrice}" Foreground="#FFD700" FontWeight="Bold" FontSize="12" Margin="2,0,0,0"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="SearchHoverOverlay" 
                                                                    Background="{DynamicResource Background}"
                                                                    BorderBrush="{DynamicResource SubtleText}" 
                                                                    BorderThickness="1,0,1,1" 
                                                                    VerticalAlignment="Top"
                                                                    Panel.ZIndex="9999">
                                                                <Border.RenderTransform>
                                                                    <TranslateTransform Y="194"/>
                                                                </Border.RenderTransform>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=SearchItemRoot}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel Margin="6,4,6,6">
                                                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                        <TextBlock Text="Creator: " FontSize="11" Foreground="{DynamicResource SubtleText}" FontWeight="SemiBold"/>
                                                                        <Button x:Name="SearchCreatorLinkButton" 
                                                                                Content="{Binding Creator}" 
                                                                                FontSize="11" 
                                                                                Foreground="{DynamicResource AccentPrimary}" 
                                                                                Background="Transparent" 
                                                                                BorderThickness="0" 
                                                                                Padding="0" 
                                                                                Cursor="Hand"
                                                                                Click="CreatorLinkButton_Click"
                                                                                Tag="{Binding Creator}">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button">
                                                                                    <Setter Property="Template">
                                                                                        <Setter.Value>
                                                                                            <ControlTemplate TargetType="Button">
                                                                                                <TextBlock Text="{TemplateBinding Content}" 
                                                                                                           TextDecorations="None"
                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                            </ControlTemplate>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                    <Style.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter Property="Template">
                                                                                                <Setter.Value>
                                                                                                    <ControlTemplate TargetType="Button">
                                                                                                        <TextBlock Text="{TemplateBinding Content}" 
                                                                                                                   TextDecorations="Underline"
                                                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                                                    </ControlTemplate>
                                                                                                </Setter.Value>
                                                                                            </Setter>
                                                                                        </Trigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                        <TextBlock Text="Updated: " FontSize="11" Foreground="{DynamicResource SubtleText}" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding UpdatedTime}" FontSize="11" Foreground="{DynamicResource Foreground}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                        <TextBlock Text="Type: " FontSize="11" Foreground="{DynamicResource SubtleText}" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{DynamicResource Foreground}"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="Control_Panel.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Console Output" Height="400" Width="600"
        Background="{DynamicResource Background}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource AccentPrimary}" 
                Padding="10,5">
            <Grid Height="70">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Console Output" FontSize="20" FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundLight}" 
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ClearButton" Content="Clear" 
                            Style="{DynamicResource ConsoleButton}"
                            Click="ClearButton_Click" Height="40" Width="70" Margin="0,0,5,0"/>
                    <Button x:Name="SaveButton" Content="Save" 
                            Style="{DynamicResource ConsoleButton}"
                            Click="SaveButton_Click" Height="40" Width="70"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="Black" BorderBrush="{DynamicResource AccentPrimary}" 
                BorderThickness="1" Margin="5">
            <ScrollViewer x:Name="ConsoleScrollViewer" 
                        VerticalScrollBarVisibility="Auto" 
                        HorizontalScrollBarVisibility="Auto"
                        CanContentScroll="False">
                <TextBox x:Name="ConsoleTextBox" 
                         Background="Black" 
                         Foreground="White"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="5"/>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource Background}" 
                Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Ready" FontSize="10" 
                           Foreground="{DynamicResource SubtleText}" 
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusTextBlock" Text="| Console ready" 
                           FontSize="10" 
                           Foreground="{DynamicResource SubtleText}" 
                           VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

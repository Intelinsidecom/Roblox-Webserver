<Window x:Class="Control_Panel.Views.UserCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Control_Panel.Views"
        mc:Ignorable="d"
        Title="Create User" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Create New User" 
                   Style="{StaticResource DashboardTitle}"
                   Foreground="{DynamicResource AccentPrimary}"
                   Margin="0,0,0,30"/>
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="Username:" 
                       Style="{StaticResource LabelText}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,10"/>
            <TextBox Grid.Column="1" Grid.Row="0" 
                     Name="UsernameTextBox"
                     Height="30"
                     Margin="0,0,0,10"
                     Padding="5,1"
                     Style="{StaticResource ModernTextBox}"
                     Text=""/>
            <TextBlock Grid.Column="0" Grid.Row="1" Text="Password:" 
                       Style="{StaticResource LabelText}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,10"/>
            <TextBox Grid.Column="1" Grid.Row="1" 
                     Name="PasswordTextBox"
                     Height="30"
                     Margin="0,0,0,10"
                     Padding="5,1"
                     Style="{StaticResource ModernTextBox}"
                     Text=""/>
            <Button Grid.Column="2" Grid.Row="1" 
                    Content="Random" 
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource AccentPrimary}"
                    Foreground="White"
                    Width="70"
                    Height="30"
                    Margin="10,0,0,10"
                    Click="RandomPasswordButton_Click"/>
            <TextBlock Grid.Column="0" Grid.Row="2" Text="Gender:" 
                       Style="{StaticResource LabelText}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1" Grid.Row="2" 
                      Name="GenderComboBox"
                      Height="30"
                      Padding="5,1"
                      Margin="0,0,0,0"
                      Style="{StaticResource ModernComboBox}">
                <ComboBoxItem Content="Male"/>
                <ComboBoxItem Content="Female"/>
                <ComboBoxItem Content="Unknown"/>
            </ComboBox>
        </Grid>
        <TextBlock Grid.Row="2" 
                   Name="StatusText"
                   Text=""
                   Style="{StaticResource LabelText}"
                   Foreground="{DynamicResource AccentPrimary}"
                   Margin="0,0,0,15"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Cancel" 
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource SubtleText}"
                    Foreground="White"
                    Width="80"
                    Height="35"
                    Click="CancelButton_Click"/>
            <Button Grid.Column="3" Content="Create" 
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource AccentPrimary}"
                    Foreground="White"
                    Width="80"
                    Height="35"
                    Click="CreateButton_Click"/>
        </Grid>
    </Grid>
</Window>

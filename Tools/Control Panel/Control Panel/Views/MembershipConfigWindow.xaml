<Window x:Class="Control_Panel.Views.MembershipConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Control_Panel.Views"
        mc:Ignorable="d"
        Title="Edit Membership" Height="200" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background}"
        ResizeMode="NoResize">
    <Grid Margin="20,20,20,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Set Membership Level" 
                   Style="{StaticResource DashboardSubtitle}"
                   Foreground="{DynamicResource AccentPrimary}"
                   Margin="0,0,0,15"/>
        <ComboBox Grid.Row="1" Name="MembershipComboBox"
                  Style="{StaticResource ModernComboBox}"
                  Height="30" Margin="0,0,0,15"
                  VerticalContentAlignment="Center">
            <ComboBoxItem Content="Free" IsSelected="True"/>
            <ComboBoxItem Content="Builders Club"/>
            <ComboBoxItem Content="Turbo Builders Club"/>
            <ComboBoxItem Content="Outrageous Builders Club"/>
        </ComboBox>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Set" 
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource AccentPrimary}"
                    Foreground="White"
                    Height="35"
                    Margin="0,0,5,0"
                    Click="SetMembershipButton_Click"/>
            <Button Grid.Column="1" Content="Exit" 
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource AccentPrimary}"
                    Foreground="White"
                    Height="35"
                    Margin="5,0,0,0"
                    Click="ExitButton_Click"/>
        </Grid>
    </Grid>
</Window>

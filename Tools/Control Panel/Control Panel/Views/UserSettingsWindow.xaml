<Window x:Class="Control_Panel.Views.UserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Control_Panel.Views"
        mc:Ignorable="d"
        Title="User Settings" Height="620" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background}"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BackgroundSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,3"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleText}"/>
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Background="{DynamicResource BackgroundSecondary}"/>
                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    Background="{DynamicResource Background}"
                                    BorderBrush="{DynamicResource SubtleText}"
                                    BorderThickness="0,1,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="User Settings"
                   Style="{StaticResource DashboardTitle}"
                   Foreground="{DynamicResource AccentPrimary}"
                   Margin="0,0,0,15"/>
        <TabControl Grid.Row="1" Style="{StaticResource SettingsTabControl}">
            <TabItem Header="Account Info" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Email:"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,10"/>
                             <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                 <TextBlock x:Name="EmailText"
                                            Style="{StaticResource LabelText}"
                                            Foreground="{DynamicResource Foreground}"
                                            VerticalAlignment="Center"/>
                                 <TextBlock x:Name="EmailVerifiedBadge"
                                            Style="{StaticResource LabelText}"
                                            FontWeight="Bold"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"/>
                                 <Button x:Name="VerifyEmailButton"
                                         Content="Verify"
                                         Style="{StaticResource ModernButton}"
                                         Background="{DynamicResource AccentPrimary}"
                                         Foreground="White"
                                         Width="70" Height="28"
                                         FontSize="13"
                                         Padding="10,4"
                                         Margin="12,0,0,0"
                                         VerticalAlignment="Center"
                                         Click="VerifyEmailButton_Click"/>
                                 <Button x:Name="UnverifyEmailButton"
                                         Content="Unverify"
                                         Style="{StaticResource ModernButton}"
                                         Background="{DynamicResource SubtleText}"
                                         Foreground="White"
                                         Width="80" Height="28"
                                         FontSize="13"
                                         Padding="10,4"
                                         Margin="6,0,0,0"
                                         VerticalAlignment="Center"
                                         Click="UnverifyEmailButton_Click"/>
                                 <Button x:Name="EditEmailButton"
                                         Content="Edit"
                                         Style="{StaticResource ModernButton}"
                                         Background="{DynamicResource AccentPrimary}"
                                         Foreground="White"
                                         Width="60" Height="28"
                                         FontSize="13"
                                         Padding="10,4"
                                         Margin="6,0,0,0"
                                         VerticalAlignment="Center"
                                         Click="EditEmailButton_Click"/>
                             </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Status:"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       VerticalAlignment="Center"/>
                             <TextBox Grid.Row="1" Grid.Column="1"
                                      x:Name="StatusTextBox"
                                      Style="{StaticResource ModernTextBox}"
                                      Height="36"
                                      Padding="5,3"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Gender:"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      x:Name="GenderComboBox"
                                      Style="{StaticResource ModernComboBox}"
                                      Height="36"
                                      Width="180"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,10">
                                <ComboBoxItem Content="Unknown" Tag="none"/>
                                <ComboBoxItem Content="Male" Tag="male"/>
                                <ComboBoxItem Content="Female" Tag="female"/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Birthday:"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="BirthMonthComboBox"
                                          Style="{StaticResource ModernComboBox}"
                                          Height="36"
                                          Width="110"
                                          Margin="0,0,6,0"/>
                                <ComboBox x:Name="BirthDayComboBox"
                                          Style="{StaticResource ModernComboBox}"
                                          Height="36"
                                          Width="60"
                                          Margin="0,0,6,0"/>
                                <ComboBox x:Name="BirthYearComboBox"
                                          Style="{StaticResource ModernComboBox}"
                                          Height="36"
                                          Width="90"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Description"
                                   Style="{StaticResource LabelText}"
                                   Foreground="{DynamicResource Foreground}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="DescriptionTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="100"
                                 Padding="5,3"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxLength="1000"/>
                        <Button x:Name="SaveInfoButton"
                                Content="Save"
                                Style="{StaticResource ModernButton}"
                                Background="{DynamicResource AccentPrimary}"
                                Foreground="White"
                                Width="80" Height="35"
                                HorizontalAlignment="Left"
                                Margin="0,15,0,0"
                                Click="SaveInfoButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Social Networks" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Facebook:"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     x:Name="FacebookTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="36"
                                     Padding="5,3"
                                     Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Twitter:"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     x:Name="TwitterTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="36"
                                     Padding="5,3"
                                     Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Google+:"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     x:Name="GooglePlusTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="36"
                                     Padding="5,3"
                                     Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="YouTube:"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     x:Name="YouTubeTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="36"
                                     Padding="5,3"
                                     Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="Twitch:"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     x:Name="TwitchTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="36"
                                     Padding="5,3"/>
                        </Grid>
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Visible to:"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      x:Name="SocialVisibilityComboBox"
                                      Style="{StaticResource ModernComboBox}"
                                      Height="36"
                                      Width="260"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="Everyone" Tag="6"/>
                                <ComboBoxItem Content="Friends, Users I Follow, and Followers" Tag="5"/>
                                <ComboBoxItem Content="Friends and Users I Follow" Tag="4"/>
                                <ComboBoxItem Content="Friends" Tag="3"/>
                                <ComboBoxItem Content="No one" Tag="0"/>
                            </ComboBox>
                        </Grid>
                        <Button x:Name="SaveSocialButton"
                                Content="Save"
                                Style="{StaticResource ModernButton}"
                                Background="{DynamicResource AccentPrimary}"
                                Foreground="White"
                                Width="80" Height="35"
                                HorizontalAlignment="Left"
                                Margin="0,15,0,0"
                                Click="SaveSocialButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Security" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Security settings are displayed for reference. Use the website to change them."
                                   Style="{StaticResource DescriptionText}"
                                   Foreground="{DynamicResource SubtleText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="2 Step Verification:"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       x:Name="TwoStepText"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Account PIN:"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       x:Name="PinText"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Account Restrictions:"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       x:Name="RestrictionsText"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource Foreground}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Privacy" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Configure who can interact with this account."
                                   Style="{StaticResource DescriptionText}"
                                   Foreground="{DynamicResource SubtleText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>
                        <TextBlock Text="Contact Settings"
                                   Style="{StaticResource DashboardTitle}"
                                   Foreground="{DynamicResource AccentPrimary}"
                                   FontSize="16"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Who can message me?"
                                   Style="{StaticResource LabelText}"
                                   Foreground="{DynamicResource Foreground}"
                                   Margin="0,0,4,0"/>
                        <ComboBox x:Name="PrivateMessagePrivacyComboBox"
                                  Style="{StaticResource ModernComboBox}"
                                  Height="36" Width="320"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,12">
                            <ComboBoxItem Content="Everyone" Tag="All"/>
                            <ComboBoxItem Content="Friends, Users I Follow, and Followers" Tag="Followers"/>
                            <ComboBoxItem Content="Friends and Users I Follow" Tag="Following"/>
                            <ComboBoxItem Content="Friends" Tag="Friends"/>
                            <ComboBoxItem Content="No one" Tag="NoOne"/>
                        </ComboBox>
                        <TextBlock Text="Who can chat with me in app?"
                                   Style="{StaticResource LabelText}"
                                   Foreground="{DynamicResource Foreground}"
                                   Margin="0,0,4,0"/>
                        <ComboBox x:Name="AppChatPrivacyComboBox"
                                  Style="{StaticResource ModernComboBox}"
                                  Height="36" Width="320"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,12">
                            <ComboBoxItem Content="Friends" Tag="Friends"/>
                            <ComboBoxItem Content="No one" Tag="NoOne"/>
                        </ComboBox>
                        <TextBlock Text="Who can chat with me in game?"
                                   Style="{StaticResource LabelText}"
                                   Foreground="{DynamicResource Foreground}"
                                   Margin="0,0,4,0"/>
                        <ComboBox x:Name="GameChatPrivacyComboBox"
                                  Style="{StaticResource ModernComboBox}"
                                  Height="36" Width="320"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,12">
                            <ComboBoxItem Content="Everyone" Tag="AllUsers"/>
                            <ComboBoxItem Content="No one" Tag="NoOne"/>
                        </ComboBox>
                        <TextBlock Text="Other Settings"
                                   Style="{StaticResource DashboardTitle}"
                                   Foreground="{DynamicResource AccentPrimary}"
                                   FontSize="16"
                                   Margin="0,10,0,10"/>
                        <TextBlock Text="Who can invite me to VIP Servers?"
                                   Style="{StaticResource LabelText}"
                                   Foreground="{DynamicResource Foreground}"
                                   Margin="0,0,4,0"/>
                        <ComboBox x:Name="PrivateServerInvitePrivacyComboBox"
                                  Style="{StaticResource ModernComboBox}"
                                  Height="36" Width="320"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,12">
                            <ComboBoxItem Content="Everyone" Tag="AllUsers"/>
                            <ComboBoxItem Content="Friends, Users I Follow, and Followers" Tag="FriendsFollowingAndFollowers"/>
                            <ComboBoxItem Content="Friends and Users I Follow" Tag="FriendsAndFollowing"/>
                            <ComboBoxItem Content="Friends" Tag="Friends"/>
                            <ComboBoxItem Content="No one" Tag="NoOne"/>
                        </ComboBox>
                        <TextBlock Text="Who can join me in game?"
                                   Style="{StaticResource LabelText}"
                                   Foreground="{DynamicResource Foreground}"
                                   Margin="0,0,4,0"/>
                        <ComboBox x:Name="FollowMePrivacyComboBox"
                                  Style="{StaticResource ModernComboBox}"
                                  Height="36" Width="320"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,12">
                            <ComboBoxItem Content="Everyone" Tag="All"/>
                            <ComboBoxItem Content="Friends, Users I Follow, and Followers" Tag="Followers"/>
                            <ComboBoxItem Content="Friends and Users I Follow" Tag="Following"/>
                            <ComboBoxItem Content="Friends" Tag="Friends"/>
                            <ComboBoxItem Content="No one" Tag="NoOne"/>
                        </ComboBox>
                        <Button x:Name="SavePrivacyButton"
                                Content="Save"
                                Style="{StaticResource ModernButton}"
                                Background="{DynamicResource AccentPrimary}"
                                Foreground="White"
                                Width="80" Height="35"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,0"
                                Click="SavePrivacyButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Notifications" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Notification settings are displayed for reference. Use the website to change them."
                                   Style="{StaticResource DescriptionText}"
                                   Foreground="{DynamicResource SubtleText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Receive Newsletter:" Style="{StaticResource LabelText}" Foreground="{DynamicResource Foreground}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="NewsletterText" Style="{StaticResource LabelText}" Foreground="{DynamicResource Foreground}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="StatusText"
                       Text=""
                       Style="{StaticResource LabelText}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <Button Grid.Column="1"
                    Content="Close"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource SubtleText}"
                    Foreground="White"
                    Width="80" Height="35"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>

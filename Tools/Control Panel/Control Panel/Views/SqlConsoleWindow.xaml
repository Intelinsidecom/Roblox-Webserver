<Window x:Class="Control_Panel.SqlConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Console" Height="500" Width="700"
        Background="{DynamicResource Background}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource AccentPrimary}" 
                Padding="10,5">
            <Grid Height="70">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SQL Console" FontSize="20" FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundLight}" 
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ClearOutputButton" Content="Clear Output" 
                            Style="{DynamicResource ConsoleButton}"
                            Click="ClearOutputButton_Click" Height="40" Width="100" Margin="0,0,5,0"/>
                    <Button x:Name="SaveButton" Content="Save" 
                            Style="{DynamicResource ConsoleButton}"
                            Click="SaveButton_Click" Height="40" Width="70"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="Black" BorderBrush="{DynamicResource AccentPrimary}" 
                BorderThickness="1" Margin="5">
            <ScrollViewer x:Name="ConsoleScrollViewer" 
                        VerticalScrollBarVisibility="Auto" 
                        HorizontalScrollBarVisibility="Auto"
                        CanContentScroll="False">
                <TextBox x:Name="ConsoleTextBox" 
                         Background="Black" 
                         Foreground="White"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="5"/>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource Background}" 
                BorderBrush="{DynamicResource AccentPrimary}" 
                BorderThickness="1" Margin="5,0,5,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="SQL Command:" FontSize="12" FontWeight="Bold" 
                           Foreground="{DynamicResource Foreground}" 
                           Margin="5,5,0,0"/>
                <Grid Grid.Row="1" Margin="5,5,5,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SqlInputTextBox" 
                             Grid.Column="0"
                             Background="Black" 
                             Foreground="White"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="5"
                             Height="80"
                             Text="Enter SQL command here..."
                             GotFocus="SqlInputTextBox_GotFocus"
                             LostFocus="SqlInputTextBox_LostFocus"/>
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="5,0,0,0">
                        <Button x:Name="ExecuteButton" Content="Execute" 
                                Style="{DynamicResource ConsoleButton}"
                                Click="ExecuteButton_Click" Height="35" Width="80" Margin="0,0,0,5"/>
                        <Button x:Name="ClearInputButton" Content="Clear" 
                                Style="{DynamicResource ConsoleButton}"
                                Click="ClearInputButton_Click" Height="35" Width="80"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="3" Background="{DynamicResource Background}" 
                Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Ready" FontSize="10" 
                           Foreground="{DynamicResource SubtleText}" 
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusTextBlock" Text="| SQL Console ready" 
                           FontSize="10" 
                           Foreground="{DynamicResource SubtleText}" 
                           VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="Control_Panel.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Control_Panel"
             mc:Ignorable="d"
             Background="{DynamicResource Background}">
    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <local:SettingsOverlay x:Name="GlobalSettingsOverlay" Grid.RowSpan="2" Panel.ZIndex="9999"/>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <StackPanel Margin="0,0,0,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Control Panel - Clients" Style="{StaticResource DashboardTitle}" 
                                       Foreground="{DynamicResource AccentPrimary}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Roblox Webserver Management" 
                                       Style="{StaticResource DashboardSubtitle}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Refresh" Style="{StaticResource ModernButton}" 
                                    Background="{DynamicResource AccentPrimary}"
                                    Width="80" Height="35" Margin="0,0,10,0"
                                    Click="RefreshButton_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="Both"
                          CanContentScroll="False">
                <StackPanel ClipToBounds="False">
                    <StackPanel Margin="20,0,20,0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="ClientUploadTabButton" Content="Client Upload" 
                                Style="{StaticResource ModernButton}" 
                                Background="{DynamicResource AccentPrimary}"
                                Foreground="White"
                                Height="40" Width="130" Margin="0,0,5,0"
                                Click="ClientUploadTabButton_Click"/>
                        <Button x:Name="ClientConfigurationTabButton" Content="Upload Configuration" 
                                Height="40" Width="160" Margin="5,0,0,0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource SubtleText}"
                                Foreground="{DynamicResource Foreground}"
                                Click="ClientConfigurationTabButton_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Line X1="20" Y1="0" X2="1" Y2="0" Stretch="Fill" 
                          Stroke="{DynamicResource SubtleText}" StrokeThickness="1" 
                          Margin="20,0,20,0"/>
                    <Grid x:Name="ClientUploadTab" Margin="20,20,20,0" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                BorderThickness="1" Padding="15" MinHeight="300">
                            <StackPanel>
                                <TextBlock Text="Client Upload" Style="{StaticResource DashboardSectionTitle}" 
                                           Foreground="{DynamicResource AccentBlue}"/>
                                <TextBlock Text="Client Folder:" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ClientFolderTextBox" 
                                             Style="{StaticResource ModernTextBox}" 
                                             Height="30" Grid.Column="0"
                                             Padding="4,2,8,0" FontSize="14"
                                             Tag="Select client folder..."/>
                                    <Button Content="Browse" Grid.Column="1" 
                                            Style="{StaticResource ModernButton}"
                                            Background="{DynamicResource AccentPrimary}"
                                            Width="80" Height="30" Margin="10,0,0,0"
                                            Click="BrowseClientFolderButton_Click"/>
                                </Grid>
                                <TextBlock x:Name="BootstrapperLabel" Text="Choose Player Bootstrapper:" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BootstrapperTextBox" 
                                             Style="{StaticResource ModernTextBox}" 
                                             Height="30" Grid.Column="0"
                                             Padding="4,2,8,0" FontSize="14"
                                             Tag="Select bootstrapper file..."/>
                                    <Button Content="Browse" Grid.Column="1" 
                                            Style="{StaticResource ModernButton}"
                                            Background="{DynamicResource AccentPrimary}"
                                            Width="80" Height="30" Margin="10,0,0,0"
                                            Click="BrowseBootstrapperButton_Click"/>
                                </Grid>
                                <TextBlock Text="Bootstrapper Version:" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <TextBox x:Name="BootstrapperVersionInputTextBox" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="30" Margin="0,0,0,15"
                                         Padding="4,2,8,0" FontSize="14"
                                         Tag="Enter bootstrapper version..."/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SeeBootstrapperVersionButton" Grid.Column="0" 
                                            Content="See bootstrapper version" 
                                            Style="{StaticResource HyperlinkButton}"
                                            Width="150" Height="25" Margin="0,0,10,0"
                                            HorizontalAlignment="Left"
                                            Click="SeeBootstrapperVersionButton_Click"/>
                                    <TextBlock x:Name="BootstrapperVersionText" Grid.Column="1" 
                                             Style="{StaticResource LabelText}" 
                                             Foreground="{DynamicResource SubtleText}" 
                                             VerticalAlignment="Center"
                                             Padding="4,2,8,0"/>
                                </Grid>
                                <TextBlock Text="Client Type:" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <RadioButton x:Name="PlayerClientRadioButton" 
                                                     Content="Player"
                                                     GroupName="ClientType"
                                                     IsChecked="True"
                                                     Foreground="{DynamicResource Foreground}"
                                                     Checked="PlayerClientRadioButton_Checked"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                        <RadioButton x:Name="StudioClientRadioButton" 
                                                     Content="Studio"
                                                     GroupName="ClientType"
                                                     Foreground="{DynamicResource Foreground}"
                                                     Checked="StudioClientRadioButton_Checked"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                        <RadioButton x:Name="RccClientRadioButton" 
                                                     Content="RCC"
                                                     GroupName="ClientType"
                                                     Foreground="{DynamicResource Foreground}"
                                                     Checked="RccClientRadioButton_Checked"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Upload" 
                                        Style="{StaticResource ModernButton}"
                                        Background="{DynamicResource AccentPrimary}"
                                        Width="150" Height="35" HorizontalAlignment="Left"
                                        Click="UploadClientsButton_Click"/>
                                <TextBlock x:Name="UploadStatusText" 
                                           Text="" 
                                           Style="{StaticResource LabelText}"
                                           Foreground="{DynamicResource SubtleText}"
                                           Margin="0,10,0,0"
                                           Visibility="Collapsed"/>
                                <TextBlock Margin="0,10,0,0">
                                    <Hyperlink x:Name="DeployHistoryHyperlink" 
                                              NavigateUri="about:blank"
                                              RequestNavigate="DeployHistoryHyperlink_RequestNavigate"
                                              Foreground="{DynamicResource AccentPrimary}">
                                        View Deploy History
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                BorderThickness="1" Padding="15" Margin="0,20,0,0" MinHeight="200">
                            <StackPanel>
                                <TextBlock Text="Revert Client" Style="{StaticResource DashboardSectionTitle}" 
                                           Foreground="{DynamicResource AccentBlue}"/>
                                <TextBlock Text="Client Hash:" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <TextBox x:Name="ClientHashTextBox" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="30" Margin="0,0,0,15"
                                         Padding="4,2,8,0" FontSize="14"
                                         Tag="Enter client hash..."/>
                                <TextBlock Text="Revert Type:" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <RadioButton x:Name="RevertPlayerRadioButton" 
                                                     Content="Player"
                                                     GroupName="RevertType"
                                                     IsChecked="True"
                                                     Foreground="{DynamicResource Foreground}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                        <RadioButton x:Name="RevertStudioRadioButton" 
                                                     Content="Studio"
                                                     GroupName="RevertType"
                                                     Foreground="{DynamicResource Foreground}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                        <RadioButton x:Name="RevertRccRadioButton" 
                                                     Content="RCC"
                                                     GroupName="RevertType"
                                                     Foreground="{DynamicResource Foreground}"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Revert" 
                                        Style="{StaticResource ModernButton}"
                                        Background="{DynamicResource AccentPrimary}"
                                        Width="150" Height="35" HorizontalAlignment="Left"
                                        Click="RevertClientButton_Click"/>
                                <TextBlock x:Name="RevertStatusText" 
                                           Text="" 
                                           Style="{StaticResource LabelText}"
                                           Foreground="{DynamicResource SubtleText}"
                                           Margin="0,10,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid x:Name="ClientConfigurationTab" Margin="20,20,20,0" Visibility="Collapsed">
                        <Border Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                BorderThickness="1" Padding="15" MinHeight="300">
                            <StackPanel>
                                <TextBlock Text="Upload Configuration" Style="{StaticResource DashboardSectionTitle}" 
                                           Foreground="{DynamicResource AccentBlue}"/>
                                <TextBlock Text="Setup Service Host:" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <TextBox x:Name="SetupHostTextBox" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="30" Margin="0,0,0,15"
                                         Padding="4,2,8,0" FontSize="14"
                                         Tag="Enter setup service host..."/>
                                <TextBlock Text="Setup Service Port:" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <TextBox x:Name="ServiceHostPortTextBox" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="30" Margin="0,0,0,15"
                                         Padding="4,2,8,0" FontSize="14"
                                         Tag="Enter setup service port..."/>
                                <TextBlock Text="Setup Service Location (Folder):" Style="{StaticResource LabelText}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SetupServiceLocationTextBox" 
                                             Style="{StaticResource ModernTextBox}" 
                                             Height="30" Grid.Column="0"
                                             Padding="4,2,8,0" FontSize="14"
                                             Tag="Select setup service location folder..."/>
                                    <Button Content="Browse" Grid.Column="1" 
                                            Style="{StaticResource ModernButton}"
                                            Background="{DynamicResource AccentPrimary}"
                                            Width="80" Height="30" Margin="10,0,0,0"
                                            Click="BrowseSetupServiceLocationButton_Click"/>
                                </Grid>
                                <Button Content="Save Configuration" 
                                        Style="{StaticResource ModernButton}"
                                        Background="{DynamicResource AccentPrimary}"
                                        Width="150" Height="35" HorizontalAlignment="Left"
                                        Click="SaveConfigButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="Control_Panel.UniverseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Control_Panel"
        mc:Ignorable="d"
        Title="Configure Game" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Background}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="VerticalTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="157"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource SubtleText}" BorderThickness="0,0,1,0">
                <StackPanel x:Name="TabNavBar" Margin="0,20,0,0">
                    <RadioButton x:Name="BasicSettingsTab" GroupName="UniverseEditTabs"
                                 Style="{StaticResource VerticalTabStyle}"
                                 IsChecked="True"
                                 Content="Basic Settings"
                                 Click="Tab_Click"/>
                    <RadioButton x:Name="AvatarSettingsTab" GroupName="UniverseEditTabs"
                                 Style="{StaticResource VerticalTabStyle}"
                                 Content="Avatar Settings"
                                 Click="Tab_Click"/>
                    <RadioButton x:Name="PlacesTab" GroupName="UniverseEditTabs"
                                 Style="{StaticResource VerticalTabStyle}"
                                 Content="Places"
                                 Click="Tab_Click"/>
                    <RadioButton x:Name="DevProductsTab" GroupName="UniverseEditTabs"
                                 Style="{StaticResource VerticalTabStyle}"
                                 Content="Developer Products"
                                 Click="Tab_Click"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="20,20,20,0">
                <StackPanel>
                    <Border x:Name="BasicSettingsContent" Padding="0" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Text="Basic Settings" Style="{StaticResource DashboardTitle}"
                                       Foreground="{StaticResource AccentPrimary}"
                                       Margin="0,0,0,20"/>
                            <TextBlock Text="Name:" Style="{StaticResource DashboardSubtitle}"
                                       Foreground="{StaticResource Foreground}"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="UniverseNameTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     MaxLength="50"
                                     Margin="0,0,0,15"/>
                            <TextBlock Text="Privacy:" Style="{StaticResource DashboardSubtitle}"
                                       Foreground="{StaticResource Foreground}"
                                       Margin="0,0,0,5"/>
                            <RadioButton x:Name="PublicRadio" GroupName="PrivacyLevel"
                                         Content="Public - Everyone can see your game"
                                         Margin="0,0,0,5" IsChecked="True"/>
                            <RadioButton x:Name="FriendsRadio" GroupName="PrivacyLevel"
                                         Content="Friends - Only friends can see your game"
                                         Margin="0,0,0,5"/>
                            <RadioButton x:Name="PrivateRadio" GroupName="PrivacyLevel"
                                         Content="Private - Only you can see your game"
                                         Margin="0,0,0,5"/>
                            <TextBlock Text="Attention! Making a game private will shut down any running instances."
                                       Foreground="Red" FontSize="12" Margin="0,5,0,15" TextWrapping="Wrap"/>
                            <Border BorderBrush="{StaticResource SubtleText}" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>
                            <TextBlock Text="Studio Access to API Services:" Style="{StaticResource DashboardSubtitle}"
                                       Foreground="{StaticResource Foreground}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="StudioAccessToApisCheckBox"
                                      Content="Enable Studio Access to API Services"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,15"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="AvatarSettingsContent" Padding="0" BorderThickness="0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Avatar Settings" Style="{StaticResource DashboardTitle}"
                                       Foreground="{StaticResource AccentPrimary}"
                                       Margin="0,0,0,20"/>
                            <TextBlock Text="Avatar Type Options:" Style="{StaticResource DashboardSubtitle}"
                                       Foreground="{StaticResource Foreground}"
                                       Margin="0,0,0,5"/>
                            <RadioButton x:Name="AvatarStandardRadio" GroupName="AvatarType"
                                         Content="Standard" Margin="0,0,0,5" IsChecked="True"/>
                            <RadioButton x:Name="AvatarPlayerChoiceRadio" GroupName="AvatarType"
                                         Content="Player Choice" Margin="0,0,0,5" IsEnabled="False"/>
                            <RadioButton x:Name="AvatarMorphR15Radio" GroupName="AvatarType"
                                         Content="Morph to R15" Margin="0,0,0,15" IsEnabled="False"/>
                            <TextBlock Text="Avatar Scaling Options:" Style="{StaticResource DashboardSubtitle}"
                                       Foreground="{StaticResource Foreground}"
                                       Margin="0,0,0,5"/>
                            <RadioButton x:Name="ScaleStandardRadio" GroupName="AvatarScaling"
                                         Content="Standard" Margin="0,0,0,5" IsChecked="True" IsEnabled="False"/>
                            <RadioButton x:Name="ScalePlayerChoiceRadio" GroupName="AvatarScaling"
                                         Content="Player Choice" Margin="0,0,0,15" IsEnabled="False"/>
                            <TextBlock Text="These options are not yet fully supported."
                                       Foreground="{DynamicResource SubtleText}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="PlacesContent" Padding="0" BorderThickness="0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Places" Style="{StaticResource DashboardTitle}"
                                       Foreground="{StaticResource AccentPrimary}"
                                       Margin="0,0,0,20"/>
                            <TextBlock Text="TODO" Style="{StaticResource NormalText}"
                                       Foreground="{DynamicResource SubtleText}"
                                       FontSize="16"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="DevProductsContent" Padding="0" BorderThickness="0" Visibility="Collapsed">
                        <StackPanel>
                             <Grid Margin="0,0,0,20" HorizontalAlignment="Left" VerticalAlignment="Center">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*"/>
                                     <ColumnDefinition Width="Auto"/>
                                 </Grid.ColumnDefinitions>
                                 <TextBlock Grid.Column="0" Text="Developer Products" Style="{StaticResource DashboardTitle}"
                                            Foreground="{StaticResource AccentPrimary}"
                                            VerticalAlignment="Center"/>
                                 <Button Grid.Column="1" x:Name="CreateNewDevProductButton"
                                         Content="Create New"
                                         Margin="20,0,0,0"
                                         Style="{StaticResource ModernButton}"
                                         Width="120" Height="35"/>
                             </Grid>
                             <ListView x:Name="DevProductsListView"
                                       Height="250"
                                       Background="{StaticResource Background}"
                                       BorderBrush="{DynamicResource SubtleText}"
                                       Margin="0,0,0,15">
                                 <ListView.View>
                                     <GridView>
                                         <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                         <GridViewColumn Header="Price" Width="100" DisplayMemberBinding="{Binding Price}"/>
                                         <GridViewColumn Header="ID" Width="100" DisplayMemberBinding="{Binding Id}"/>
                                         <GridViewColumn Header="Actions" Width="150">
                         <GridViewColumn.CellTemplate>
                             <DataTemplate>
                                 <Button Content="Edit"
                                         Style="{StaticResource ModernButton}"
                                         Width="80" Height="25"
                                         Tag="{Binding Id}"
                                         Click="EditDevProduct_Click"/>
                             </DataTemplate>
                         </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                                     </GridView>
                                 </ListView.View>
                             </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{StaticResource SubtleText}" BorderThickness="0,1,0,0"
                Background="{StaticResource Background}" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SaveButton"
                        Content="Save"
                        Style="{StaticResource ModernButton}"
                        Width="100" Height="35"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource ModernButton}"
                        Width="100" Height="35"
                        Background="{StaticResource SubtleText}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="Control_Panel.UsersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Control_Panel"
        mc:Ignorable="d"
        Background="{DynamicResource Background}">
    <UserControl.Resources>
        <DataTemplate x:Key="UserResultTemplate">
            <Grid>
                <Grid.Background>
                    <SolidColorBrush Color="Transparent"/>
                </Grid.Background>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF333333"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Id}" 
                           Margin="5,5,0,0" VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Style="{DynamicResource DefaultTextStyle}"
                           Foreground="{DynamicResource Foreground}"
                           FontSize="14"/>
                <Line Grid.Column="1" X1="0" Y1="0" X2="0" Y2="1" 
                      Stretch="Fill" Stroke="{DynamicResource SubtleText}" 
                      StrokeThickness="1" VerticalAlignment="Stretch"/>
                <TextBlock Grid.Column="2" Text="{Binding Username}" 
                           Margin="5"
                           Style="{DynamicResource DefaultTextStyle}"
                           Foreground="{DynamicResource Foreground}"
                           VerticalAlignment="Center"
                           FontSize="14"/>
                <Button Grid.Column="3" Content="More info" 
                        Style="{DynamicResource ModernButton}"
                        Foreground="{DynamicResource AccentPrimaryForeground}"
                        Margin="5,5,5,5"
                        Padding="8,4"
                        FontSize="12"
                        MinWidth="70"
                        Height="25"
                        Click="MoreInfoButton_Click"
                        Tag="{Binding Id}"/>
                <Line Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                      X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" 
                      Stroke="{DynamicResource SubtleText}" StrokeThickness="1" 
                      Margin="0,0,0,0"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <local:SettingsOverlay x:Name="GlobalSettingsOverlay" Grid.RowSpan="2" Panel.ZIndex="9999"/>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <StackPanel Margin="0,0,0,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Control Panel - Users" Style="{StaticResource DashboardTitle}" 
                                       Foreground="{DynamicResource AccentPrimary}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Roblox Webserver Management" 
                                       Style="{StaticResource DashboardSubtitle}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh" Style="{StaticResource ModernButton}" 
                                Background="{DynamicResource AccentPrimary}"
                                Width="80" Height="35" HorizontalAlignment="Right"
                                Click="RefreshButton_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Auto"
                          PanningMode="Both"
                          CanContentScroll="False">
                <StackPanel>
                    <Grid Margin="0,0,0,10" MaxWidth="800" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="UsernameSearchTextBox" 
                                 Style="{StaticResource ModernTextBox}" 
                                 Height="30" Margin="0,0,5,0"
                                 TextChanged="UsernameSearchTextBox_TextChanged"
                                 Padding="4,1,8,0" ToolTip="Search by Username" FontSize="16"
                                 HorizontalContentAlignment="Stretch" TextWrapping="NoWrap" MaxWidth="500"
                                 Tag="Search by Username"
                                 GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        <TextBox Grid.Column="1" x:Name="IdSearchTextBox" 
                                 Style="{StaticResource ModernTextBox}" 
                                 Height="30" Margin="0"
                                 TextChanged="IdSearchTextBox_TextChanged"
                                 KeyDown="IdSearchTextBox_KeyDown"
                                 Padding="4,1,8,0" ToolTip="Enter ID to manage user"
                                 HorizontalContentAlignment="Stretch" TextWrapping="NoWrap" MaxWidth="500"
                                 Tag="Enter user ID"
                                 GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                    </Grid>
                    <Border Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                            BorderThickness="1" Padding="0" MinHeight="300" MaxHeight="400">
                        <StackPanel>
                            <Grid x:Name="ResultsHeader" Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource DashboardSubtitle}" FontWeight="Bold" Margin="5,5,0,0" HorizontalAlignment="Left"/>
                                <Line Grid.Column="1" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" 
                                      Stroke="{DynamicResource SubtleText}" StrokeThickness="1" 
                                      Margin="0" VerticalAlignment="Stretch"/>
                                <TextBlock Grid.Column="2" Text="Username" Style="{StaticResource DashboardSubtitle}" FontWeight="Bold" Margin="5"/>
                            </Grid>
                            <Line x:Name="ResultsSeparator" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" 
                                  Stroke="{DynamicResource SubtleText}" StrokeThickness="1" 
                                  Margin="0"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ResultsContainer" Visibility="Collapsed"
                                            ItemTemplate="{StaticResource UserResultTemplate}">
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

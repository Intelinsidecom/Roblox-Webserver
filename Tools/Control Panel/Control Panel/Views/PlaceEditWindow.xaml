<Window x:Class="Control_Panel.PlaceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Control_Panel"
        mc:Ignorable="d"
        Title="Configure Place" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Background}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="VerticalTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
        </Style>
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="Background" Value="{DynamicResource Background}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" TextElement.Foreground="{TemplateBinding Foreground}">
                            <Border x:Name="CheckBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Width="16" Height="16"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Stroke="{DynamicResource AccentPrimary}"
                                      StrokeThickness="2"
                                      Data="M 2,6 L 6,10 L 14,2"
                                      Visibility="Collapsed"
                                      Stretch="Uniform"
                                      Margin="2"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentSecondary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                <Setter TargetName="CheckMark" Property="Stroke" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentSecondary}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentSecondary}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBorder" Property="Opacity" Value="0.5"/>
                                <Setter Property="Foreground" Value="{DynamicResource SubtleText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="157"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource SubtleText}" BorderThickness="0,0,1,0">
                <StackPanel x:Name="TabNavBar" Margin="0,20,0,0">
                    <RadioButton x:Name="BasicSettingsTab" GroupName="PlaceEditTabs"
                                 Style="{StaticResource VerticalTabStyle}"
                                 IsChecked="True"
                                 Content="Basic Settings"
                                 Click="Tab_Click"/>
                    <RadioButton x:Name="GameIconTab" GroupName="PlaceEditTabs"
                                 Style="{StaticResource VerticalTabStyle}"
                                 Content="Game Icon"
                                 Click="Tab_Click"/>
                    <RadioButton x:Name="ThumbnailsTab" GroupName="PlaceEditTabs"
                                 Style="{StaticResource VerticalTabStyle}"
                                 Content="Thumbnails"
                                 Click="Tab_Click"/>
                    <RadioButton x:Name="AccessTab" GroupName="PlaceEditTabs"
                                 Style="{StaticResource VerticalTabStyle}"
                                 Content="Access"
                                 Click="Tab_Click"/>
                    <RadioButton x:Name="PermissionsTab" GroupName="PlaceEditTabs"
                                 Style="{StaticResource VerticalTabStyle}"
                                 Content="Permissions"
                                 Click="Tab_Click"/>
                    <RadioButton x:Name="DeveloperProductsTab" GroupName="PlaceEditTabs"
                                 Style="{StaticResource VerticalTabStyle}"
                                 Content="Developer Products"
                                 Click="Tab_Click"/>
                    <RadioButton x:Name="GamesTab" GroupName="PlaceEditTabs"
                                 Style="{StaticResource VerticalTabStyle}"
                                 Content="Games"
                                 Click="Tab_Click"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="20,20,20,0">
                <StackPanel>
                    <Border x:Name="BasicSettingsContent" Padding="0" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Text="Basic Settings" Style="{StaticResource DashboardTitle}"
                                       Foreground="{StaticResource AccentPrimary}"
                                       Margin="0,0,0,20"/>
                            <TextBlock Text="Name:" Style="{StaticResource DashboardSubtitle}"
                                       Foreground="{StaticResource Foreground}"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="PlaceNameTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     MaxLength="50"
                                     Margin="0,0,0,15"/>
                            <TextBlock Text="Description:" Style="{StaticResource DashboardSubtitle}"
                                       Foreground="{StaticResource Foreground}"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="PlaceDescriptionTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     MaxLength="1000"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="100"
                                     Margin="0,0,0,15"/>
                            <TextBlock Text="Genre:" Style="{StaticResource DashboardSubtitle}"
                                       Foreground="{StaticResource Foreground}"
                                       Margin="0,0,0,5"/>
                            <ComboBox x:Name="GenreComboBox"
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,15"
                                      Width="200" HorizontalAlignment="Left">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Adventure"/>
                                <ComboBoxItem Content="Building"/>
                                <ComboBoxItem Content="Comedy"/>
                                <ComboBoxItem Content="Fighting"/>
                                <ComboBoxItem Content="FPS"/>
                                <ComboBoxItem Content="Horror"/>
                                <ComboBoxItem Content="Medieval"/>
                                <ComboBoxItem Content="Military"/>
                                <ComboBoxItem Content="Naval"/>
                                <ComboBoxItem Content="RPG"/>
                                <ComboBoxItem Content="Sci-Fi"/>
                                <ComboBoxItem Content="Sports"/>
                                <ComboBoxItem Content="Town and City"/>
                                <ComboBoxItem Content="Western"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border x:Name="GameIconContent" Padding="0" BorderThickness="0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Game Icon" Style="{StaticResource DashboardTitle}"
                                       Foreground="{StaticResource AccentPrimary}"
                                       Margin="0,0,0,20"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,30,0">
                                    <Border BorderBrush="{StaticResource SubtleText}" BorderThickness="1" Width="400" Height="400" HorizontalAlignment="Left" Margin="0,0,0,15">
                                        <Image x:Name="GameIconImage" Width="400" Height="400" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="Note: You can only have 1 icon per game."
                                               Style="{StaticResource DescriptionText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Change Icon" Style="{StaticResource DashboardSectionTitle}"
                                               Foreground="{StaticResource AccentPrimary}"
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="Media type:" Style="{StaticResource LabelText}"
                                               Margin="0,0,0,5"/>
                                    <RadioButton x:Name="IconImageRadio" GroupName="IconType"
                                                 Content="Image" Margin="0,0,0,3"
                                                 IsChecked="True"
                                                 Checked="IconType_Changed"/>
                                    <RadioButton x:Name="IconAutoGeneratedRadio" GroupName="IconType"
                                                 Content="Auto generated Image" Margin="0,0,0,15"
                                                 Checked="IconType_Changed"/>
                                    <Border x:Name="IconImageUploadSection" BorderBrush="{StaticResource SubtleText}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                        <StackPanel x:Name="ImageUploadPanel">
                                            <TextBlock Text="Select image:" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" x:Name="SelectImageButton"
                                                        Content="Select Image"
                                                        Style="{StaticResource ModernButton}"
                                                        Width="120" Height="30"/>
                                                <TextBlock Grid.Column="1" x:Name="SelectedImageIndicator"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0"
                                                           Style="{StaticResource DescriptionText}"/>
                                            </Grid>
                                            <Button x:Name="UploadIconButton"
                                                    Content="Upload Icon"
                                                    Style="{StaticResource ModernButton}"
                                                    Width="120" Height="30"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Text="Icon must be square."
                                                       Style="{StaticResource DescriptionText}"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel x:Name="AutoGeneratedPanel" Visibility="Collapsed" Margin="0,15,0,0">
                                        <Border BorderBrush="{StaticResource SubtleText}" BorderThickness="1" Width="120" Height="120" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <Image x:Name="AutoGeneratedIconImage" Width="120" Height="120" Stretch="Uniform"/>
                                        </Border>
                                        <Button x:Name="SetAutoGeneratedIconButton"
                                                Content="Set Icon"
                                                Style="{StaticResource ModernButton}"
                                                Width="70" Height="30"
                                                HorizontalAlignment="Left"
                                                Click="SetAutoGeneratedIconButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ThumbnailsContent" Padding="0" BorderThickness="0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Thumbnails" Style="{StaticResource DashboardTitle}"
                                       Foreground="{StaticResource AccentPrimary}"
                                       Margin="0,0,0,20"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,30,0">
                                    <Border BorderBrush="{StaticResource SubtleText}" BorderThickness="1" Height="250" HorizontalAlignment="Left" Width="445" Margin="0,0,0,10">
                                        <Image x:Name="ThumbnailPreviewImage" Height="250" Width="445" Stretch="Uniform"/>
                                    </Border>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ListBox x:Name="ThumbnailGalleryListBox"
                                                 Height="80"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 AllowDrop="True"
                                                 PreviewMouseMove="ThumbnailGalleryListBox_PreviewMouseMove"
                                                 Drop="ThumbnailGalleryListBox_Drop"
                                                 DragOver="ThumbnailGalleryListBox_DragOver"
                                                 MouseLeftButtonUp="ThumbnailGalleryListBox_MouseLeftButtonUp">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource SubtleText}" BorderThickness="1" Width="120" Height="60" Margin="0,0,10,0">
                                                        <Grid>
                                                            <Image Source="{Binding ImageSource}" Stretch="Uniform"/>
                                                            <Button Content="X" Width="20" Height="20"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Style="{StaticResource ModernButton}"
                                                                    FontSize="10" Padding="0"
                                                                    Tag="{Binding}"
                                                                    Click="DeleteThumbnail_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                </StackPanel>
                                <Border Grid.Column="1" BorderBrush="{StaticResource SubtleText}" BorderThickness="0,0,0,0" Padding="20,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Add a New Thumbnail" Style="{StaticResource DashboardSectionTitle}"
                                                   Foreground="{StaticResource AccentPrimary}"
                                                   Margin="0,0,0,15"/>
                                        <TextBlock Text="Media type:" Style="{StaticResource LabelText}"
                                                   Margin="0,0,0,5"/>
                                        <RadioButton x:Name="ThumbnailImageRadio" GroupName="ThumbnailType"
                                                     Content="Image" Margin="0,0,0,3"
                                                     IsChecked="True"
                                                     Checked="ThumbnailType_Changed"/>
                                        <RadioButton x:Name="ThumbnailVideoRadio" GroupName="ThumbnailType"
                                                     Content="Video" Margin="0,0,0,3"
                                                     Checked="ThumbnailType_Changed"/>
                                        <RadioButton x:Name="ThumbnailAutoRadio" GroupName="ThumbnailType"
                                                     Content="Auto generated" Margin="0,0,0,15"
                                                     Checked="ThumbnailType_Changed"/>
                                        <Border BorderBrush="{StaticResource SubtleText}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                            <StackPanel>
                                                <StackPanel x:Name="ThumbnailImageUploadPanel">
                                                    <TextBlock Text="Select image:" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" x:Name="SelectThumbnailImageButton"
                                                                Content="Select Image"
                                                                Style="{StaticResource ModernButton}"
                                                                Width="120" Height="30"/>
                                                        <TextBlock Grid.Column="1" x:Name="SelectedThumbnailIndicator"
                                                                   VerticalAlignment="Center"
                                                                   Margin="10,0,0,0"
                                                                   Style="{StaticResource DescriptionText}"/>
                                                    </Grid>
                                                    <Button x:Name="UploadThumbnailImageButton"
                                                            Content="Upload Image"
                                                            Style="{StaticResource ModernButton}"
                                                            Width="120" Height="30"
                                                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <StackPanel x:Name="ThumbnailVideoUploadPanel" Visibility="Collapsed">
                                                    <TextBlock Text="Link to Video:" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                                    <TextBox x:Name="ThumbnailVideoLinkTextBox"
                                                             Style="{StaticResource ModernTextBox}"
                                                             Width="180"
                                                             Margin="0,0,0,5"
                                                             HorizontalAlignment="Left"/>
                                                    <Button x:Name="UploadThumbnailVideoButton"
                                                            Content="Upload Video"
                                                            Style="{StaticResource ModernButton}"
                                                            Width="120" Height="30"
                                                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <StackPanel x:Name="ThumbnailAutoPanel" Visibility="Collapsed">
                                                    <TextBlock Text="Auto generated thumbnail:" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                                    <Border BorderBrush="{StaticResource SubtleText}" BorderThickness="1" Width="125" Height="75" HorizontalAlignment="Left" Margin="0,0,0,10">
                                                        <Image x:Name="AutoGeneratedThumbnailImage" Width="125" Height="75" Stretch="Uniform"/>
                                                    </Border>
                                                    <Button x:Name="SetAutoGeneratedThumbnailButton"
                                                            Content="Set Thumbnail"
                                                            Style="{StaticResource ModernButton}"
                                                            Width="120" Height="30"
                                                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="AccessContent" Padding="0" BorderThickness="0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Access" Style="{StaticResource DashboardTitle}"
                                       Foreground="{StaticResource AccentPrimary}"
                                       Margin="0,0,0,20"/>
                            <TextBlock Text="Playable devices:" Style="{StaticResource DashboardSubtitle}"
                                       Foreground="{StaticResource Foreground}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="DeviceComputerCheckBox" Content="Computer"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,3"/>
                            <CheckBox x:Name="DevicePhoneCheckBox" Content="Phone"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,3"/>
                            <CheckBox x:Name="DeviceTabletCheckBox" Content="Tablet"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,3"/>
                            <CheckBox x:Name="DeviceConsoleCheckBox" Content="Console"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,15"/>
                            <Border BorderBrush="{StaticResource SubtleText}" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>
                            <TextBlock Text="Game Access:" Style="{StaticResource DashboardSubtitle}"
                                       Foreground="{StaticResource Foreground}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="SellGameAccessCheckBox" Content="Sell access to this game"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                            <Border x:Name="PricingPanel" BorderBrush="{StaticResource SubtleText}" BorderThickness="1" Padding="10" Margin="0,0,0,15" IsEnabled="False">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Price:" Style="{StaticResource NormalText}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="PriceTextBox"
                                                 Style="{StaticResource ModernTextBox}" Width="100" HorizontalAlignment="Left"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Marketplace Fee:" Style="{StaticResource DescriptionText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="MarketplaceFeeText" Text="0" Style="{StaticResource NormalText}" Foreground="Green"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="You Earn:" Style="{StaticResource DescriptionText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="ProfitText" Text="0" Style="{StaticResource NormalText}" Foreground="Green"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Maximum Visitor Count:" Style="{StaticResource LabelText}"
                                           Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="MaxPlayersComboBox"
                                          Style="{StaticResource ModernComboBox}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                <TextBlock Text="Server Fill:" Style="{StaticResource LabelText}"
                                           Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                    <RadioButton x:Name="ServerFillAutomaticRadio" GroupName="ServerFill"
                                                 Content="Roblox optimizes server fill for me" Margin="0,0,0,3"/>
                                    <RadioButton x:Name="ServerFillEmptyRadio" GroupName="ServerFill"
                                                 Content="Fill each server as full as possible" Margin="0,0,0,3"/>
                                    <RadioButton x:Name="ServerFillCustomRadio" GroupName="ServerFill"
                                                 Content="Customize how many server slots to reserve"/>
                                </StackPanel>
                                <TextBlock Text="Access:" Style="{StaticResource LabelText}"
                                           Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="AccessComboBox"
                                          Style="{StaticResource ModernComboBox}" Width="150" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Everyone"/>
                                    <ComboBoxItem Content="Friends"/>
                                </ComboBox>
                            </Grid>
                                <StackPanel>
                                    <TextBlock Text="Private Servers:" Style="{StaticResource LabelText}"
                                               Margin="0,0,0,10"/>
                                    <CheckBox x:Name="AllowPrivateServersCheckBox"
                                              Content="Allow Private Servers"
                                              Style="{StaticResource ModernCheckBox}" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="ActivePrivateServersCount"
                                               Style="{StaticResource DescriptionText}"
                                               Text="There are currently 0 private servers active for this place."
                                               Margin="22,0,0,5"/>
                                    <TextBlock x:Name="ActivePrivateServerSubscriptions"
                                               Style="{StaticResource DescriptionText}"
                                               Text="There are currently 0 private server subscriptions active for this place."
                                               Margin="22,0,0,10"/>
                                    <Border x:Name="PrivateServerDetails" BorderBrush="{StaticResource SubtleText}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="22,0,0,0" IsEnabled="False">
                                        <StackPanel>
                                            <TextBlock Text="Private Server Pricing:" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                            <RadioButton x:Name="PrivateServerFreeRadio" GroupName="PrivateServerPrice"
                                                         Content="Free" Margin="0,0,0,3"/>
                                            <RadioButton x:Name="PrivateServerPaidRadio" GroupName="PrivateServerPrice"
                                                         Content="Paid" Margin="0,0,0,10"/>
                                            <Border x:Name="PrivateServerPricePanel" BorderBrush="{StaticResource SubtleText}" BorderThickness="1" Padding="12" IsEnabled="False">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Price:" Style="{StaticResource NormalText}" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" x:Name="PrivateServerPriceTextBox"
                                                                 Style="{StaticResource ModernTextBox}" Width="120" HorizontalAlignment="Left"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Marketplace Fee:" Style="{StaticResource DescriptionText}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" x:Name="PrivateServerFeeText" Text="0" Style="{StaticResource NormalText}" Foreground="Green"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="You Earn:" Style="{StaticResource DescriptionText}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" x:Name="PrivateServerProfitText" Text="0" Style="{StaticResource NormalText}" Foreground="Green"/>
                                                    </Grid>
                                                    <TextBlock Text="Warning: Changing the price of private servers will cancel all existing subscriptions."
                                                               Style="{StaticResource DescriptionText}"
                                                               Foreground="Red"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="PermissionsContent" Padding="0" BorderThickness="0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Gear Permissions" Style="{StaticResource DashboardTitle}"
                                       Foreground="{StaticResource AccentPrimary}"
                                       Margin="0,0,0,20"/>
                            <TextBlock Text="Allowed Genre:" Style="{StaticResource DashboardSubtitle}"
                                       Foreground="{StaticResource Foreground}"
                                       Margin="0,0,0,5"/>
                            <RadioButton x:Name="GenreGearRadio" GroupName="GearGenre"
                                         Content="Game genre (All)" Margin="0,0,0,3"/>
                            <RadioButton x:Name="AllGenresGearRadio" GroupName="GearGenre"
                                         Content="All genres" Margin="0,0,0,15"/>
                            <TextBlock Text="Gear types:" Style="{StaticResource DashboardSubtitle}"
                                       Foreground="{StaticResource Foreground}"
                                       Margin="0,0,0,5"/>
                            <WrapPanel MaxWidth="500" Margin="0,0,0,15">
                                <CheckBox x:Name="GearMeleeCheckBox" Content="Melee"
                                          Style="{StaticResource ModernCheckBox}" Width="140" Margin="0,0,0,3"/>
                                <CheckBox x:Name="GearPowerUpsCheckBox" Content="Power ups"
                                          Style="{StaticResource ModernCheckBox}" Width="140" Margin="0,0,0,3"/>
                                <CheckBox x:Name="GearRangedCheckBox" Content="Ranged"
                                          Style="{StaticResource ModernCheckBox}" Width="140" Margin="0,0,0,3"/>
                                <CheckBox x:Name="GearNavigationCheckBox" Content="Navigation"
                                          Style="{StaticResource ModernCheckBox}" Width="140" Margin="0,0,0,3"/>
                                <CheckBox x:Name="GearExplosivesCheckBox" Content="Explosives"
                                          Style="{StaticResource ModernCheckBox}" Width="140" Margin="0,0,0,3"/>
                                <CheckBox x:Name="GearMusicalCheckBox" Content="Musical"
                                          Style="{StaticResource ModernCheckBox}" Width="140" Margin="0,0,0,3"/>
                                <CheckBox x:Name="GearSocialCheckBox" Content="Social"
                                          Style="{StaticResource ModernCheckBox}" Width="140" Margin="0,0,0,3"/>
                                <CheckBox x:Name="GearTransportCheckBox" Content="Transport"
                                          Style="{StaticResource ModernCheckBox}" Width="140" Margin="0,0,0,3"/>
                                <CheckBox x:Name="GearBuildingCheckBox" Content="Building"
                                          Style="{StaticResource ModernCheckBox}" Width="140" Margin="0,0,0,3"/>
                            </WrapPanel>
                            <Border BorderBrush="{StaticResource SubtleText}" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>
                            <TextBlock Text="Other Permissions" Style="{StaticResource DashboardTitle}"
                                       Foreground="{StaticResource AccentPrimary}"
                                       Margin="0,0,0,10"/>
                            <CheckBox x:Name="AllowCopyingCheckBox" Content="Allow Copying"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,15"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="DeveloperProductsContent" Padding="0" BorderThickness="0" Visibility="Collapsed">
                        <StackPanel>
                             <Grid Margin="0,0,0,20" HorizontalAlignment="Left" VerticalAlignment="Center">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*"/>
                                     <ColumnDefinition Width="Auto"/>
                                 </Grid.ColumnDefinitions>
                                 <TextBlock Grid.Column="0" Text="Developer Products" Style="{StaticResource DashboardTitle}"
                                            Foreground="{StaticResource AccentPrimary}"
                                            VerticalAlignment="Center"/>
                                 <Button Grid.Column="1" x:Name="CreateNewDevProductButton"
                                         Content="Create New"
                                         Margin="20,0,0,0"
                                         Style="{StaticResource ModernButton}"
                                         Width="120" Height="35"/>
                             </Grid>
                             <ListView x:Name="DevProductsListView"
                                       Height="250"
                                       Background="{StaticResource Background}"
                                       BorderBrush="{StaticResource SubtleText}"
                                       Margin="0,0,0,15">
                                 <ListView.View>
                                     <GridView>
                                         <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                         <GridViewColumn Header="Price" Width="100" DisplayMemberBinding="{Binding Price}"/>
                                         <GridViewColumn Header="ID" Width="100" DisplayMemberBinding="{Binding Id}"/>
                                         <GridViewColumn Header="Actions" Width="150">
                         <GridViewColumn.CellTemplate>
                             <DataTemplate>
                                 <Button Content="Edit"
                                         Style="{StaticResource ModernButton}"
                                         Width="80" Height="25"
                                         Tag="{Binding Id}"
                                         Click="EditDevProduct_Click"/>
                             </DataTemplate>
                         </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                                     </GridView>
                                 </ListView.View>
                             </ListView>
                        </StackPanel>
                    </Border>
                    <Border x:Name="GamesContent" Padding="0" BorderThickness="0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Game" Style="{StaticResource DashboardTitle}"
                                       Foreground="{StaticResource AccentPrimary}"
                                       Margin="0,0,0,20"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,15"
                                       Style="{StaticResource NormalText}">
                                This place is part of the Game:
                                <Hyperlink x:Name="GameLink" NavigateUri="">gamename</Hyperlink>
                            </TextBlock>
                            <Border BorderBrush="{StaticResource SubtleText}" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>
                            <TextBlock Text="In-Game Permissions" Style="{StaticResource DashboardTitle}"
                                       Foreground="{StaticResource AccentPrimary}"
                                       Margin="0,0,0,15"/>
                            <CheckBox x:Name="AllowCopyInGameCheckBox"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,10">
                                <TextBlock TextWrapping="Wrap">
                                    Allow this place to be copied as a template using the
                                    Create Place API
                                    in your game.
                                </TextBlock>
                            </CheckBox>
                            <CheckBox x:Name="AllowUpdateInGameCheckBox"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,15">
                                <TextBlock TextWrapping="Wrap">
                                    Allow this place to be updated using the
                                    Save Place API
                                    in your game.
                                </TextBlock>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{StaticResource SubtleText}" BorderThickness="0,1,0,0"
                Background="{StaticResource Background}" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SaveButton"
                        Content="Save"
                        Style="{StaticResource ModernButton}"
                        Width="100" Height="35"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource SubtleText}"
                        Width="100" Height="35"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

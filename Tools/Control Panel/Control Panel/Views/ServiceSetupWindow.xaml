<Window x:Class="Control_Panel.ServiceSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Control_Panel"
        mc:Ignorable="d"
        Title="Service Setup" Height="650" Width="600"
        Background="{DynamicResource Background}"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                  CanContentScroll="False">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Service Setup" Style="{DynamicResource HeaderText}" 
                       Foreground="{DynamicResource AccentPrimary}"/>
            <TextBlock Text="Configure the ports and URLs for Roblox Webserver services" 
                       Style="{DynamicResource NormalText}" 
                       Foreground="{DynamicResource SubtleText}" 
                       Margin="0,10,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                BorderThickness="1" Padding="30">
            <StackPanel>
                <TextBlock Text="Service Configuration" Style="{DynamicResource TitleText}" 
                           Margin="0,0,0,20"/>
                <Border Background="{DynamicResource BackgroundSecondary}" BorderBrush="{DynamicResource SubtleText}" 
                        BorderThickness="1" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Arbiter Service" Style="{DynamicResource SubtitleText}" 
                                   Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,15"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Host:" Style="{DynamicResource LabelText}" 
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="ArbiterHostTextBox" Style="{DynamicResource ModernTextBox}" 
                                     Text="localhost" Margin="10,0,0,0" Padding="8,4,8,6"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Port:" Style="{DynamicResource LabelText}" 
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="ArbiterPortTextBox" Style="{DynamicResource ModernTextBox}" 
                                     Text="5000" Margin="10,0,0,0" Height="40" Padding="8,4,8,0"/>
                        </Grid>
                        <TextBlock Text="Handles game server coordination and RCC communication" 
                                   Style="{DynamicResource DescriptionText}" 
                                   Foreground="{DynamicResource SubtleText}" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BackgroundSecondary}" BorderBrush="{DynamicResource SubtleText}" 
                        BorderThickness="1" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Website Service" Style="{DynamicResource SubtitleText}" 
                                   Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,15"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Host:" Style="{DynamicResource LabelText}" 
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="WebsiteHostTextBox" Style="{DynamicResource ModernTextBox}" 
                                     Text="localhost" Margin="10,0,0,0" Padding="8,4,8,6"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Port:" Style="{DynamicResource LabelText}" 
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="WebsitePortTextBox" Style="{DynamicResource ModernTextBox}" 
                                     Text="5077" Margin="10,0,0,0" Height="40" Padding="8,4,8,0"/>
                        </Grid>
                        
                        <TextBlock Text="Main web interface for users" 
                                   Style="{DynamicResource DescriptionText}" 
                                   Foreground="{DynamicResource SubtleText}" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BackgroundSecondary}" BorderBrush="{DynamicResource SubtleText}" 
                        BorderThickness="1" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="API Service" Style="{DynamicResource SubtitleText}" 
                                   Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,15"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Host:" Style="{DynamicResource LabelText}" 
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="ApiServiceHostTextBox" Style="{DynamicResource ModernTextBox}" 
                                     Text="localhost" Margin="10,0,0,0" Padding="8,4,8,6"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Port:" Style="{DynamicResource LabelText}" 
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="ApiServicePortTextBox" Style="{DynamicResource ModernTextBox}" 
                                     Text="5081" Margin="10,0,0,0" Height="40" Padding="8,4,8,0"/>
                        </Grid>
                        
                        <TextBlock Text="Special Service for Handling Client API requests." 
                                   Style="{DynamicResource DescriptionText}" 
                                   Foreground="{DynamicResource SubtleText}" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BackgroundSecondary}" BorderBrush="{DynamicResource SubtleText}" 
                        BorderThickness="1" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Data Service" Style="{DynamicResource SubtitleText}" 
                                   Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,15"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Host:" Style="{DynamicResource LabelText}" 
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="RccLogHostTextBox" Style="{DynamicResource ModernTextBox}" 
                                     Text="localhost" Margin="10,0,0,0" Padding="8,4,8,6"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Port:" Style="{DynamicResource LabelText}" 
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="RccLogPortTextBox" Style="{DynamicResource ModernTextBox}" 
                                     Text="5080" Margin="10,0,0,0" Height="40" Padding="8,4,8,0"/>
                        </Grid>
                        
                        <TextBlock Text="RCC crash log service for collecting RCC Crash Logs." 
                                   Style="{DynamicResource DescriptionText}" 
                                   Foreground="{DynamicResource SubtleText}" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BackgroundSecondary}" BorderBrush="{DynamicResource SubtleText}" 
                        BorderThickness="1" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="CDN Service" Style="{DynamicResource SubtitleText}" 
                                   Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,15"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Host:" Style="{DynamicResource LabelText}" 
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="CdnHostTextBox" Style="{DynamicResource ModernTextBox}" 
                                     Text="localhost" Margin="10,0,0,0" Padding="8,4,8,6"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Port:" Style="{DynamicResource LabelText}" 
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="CdnPortTextBox" Style="{DynamicResource ModernTextBox}" 
                                     Text="5079" Margin="10,0,0,0" Height="40" Padding="8,4,8,0"/>
                        </Grid>
                        
                        <TextBlock Text="Content delivery network for assets" 
                                   Style="{DynamicResource DescriptionText}" 
                                   Foreground="{DynamicResource SubtleText}" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Button x:Name="TestServicesButton" Content="Test All Services" 
                        Style="{DynamicResource ModernButton}" 
                        HorizontalAlignment="Left" 
                        Width="150" Height="40"
                        Click="TestServicesButton_Click"/>
                <StackPanel Margin="0,15,0,0" x:Name="ServiceStatusPanel">
                    <TextBlock x:Name="ArbiterStatusText" Text="" Style="{DynamicResource NormalText}" Margin="0,2"/>
                    <TextBlock x:Name="WebsiteStatusText" Text="" Style="{DynamicResource NormalText}" Margin="0,2"/>
                    <TextBlock x:Name="ApiServiceStatusText" Text="" Style="{DynamicResource NormalText}" Margin="0,2"/>
                    <TextBlock x:Name="RccLogStatusText" Text="" Style="{DynamicResource NormalText}" Margin="0,2"/>
                    <TextBlock x:Name="CdnStatusText" Text="" Style="{DynamicResource NormalText}" Margin="0,2"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock x:Name="StatusTextBlock" Text="Configure service ports and URLs" 
                       Style="{DynamicResource NormalText}" 
                       Foreground="{DynamicResource Success}" 
                       Margin="0,0,0,15"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveSettingsButton" Content="Save Settings" 
                        Style="{DynamicResource ModernButton}" 
                        Width="150" Height="40" Margin="0,0,15,0"
                        Click="SaveSettingsButton_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" 
                        Style="{DynamicResource ModernButton}" 
                        Width="150" Height="40"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>

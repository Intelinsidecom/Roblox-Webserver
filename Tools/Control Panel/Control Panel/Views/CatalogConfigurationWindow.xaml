<Window x:Class="Control_Panel.CatalogConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Control_Panel"
        mc:Ignorable="d"
        Title="Catalog Configuration - Featured Items"
        Height="350" Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="IdTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="4,2,8,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Catalog Featured Items" 
                       Style="{StaticResource DashboardTitle}"
                       Foreground="{DynamicResource AccentPrimary}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="Enter the Asset IDs for the four featured slots (1-4) displayed at the top of the catalog." 
                       Style="{StaticResource DashboardSectionDescription}"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" 
                Background="{DynamicResource Background}" 
                BorderBrush="{DynamicResource SubtleText}" 
                BorderThickness="1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Slot 1" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FeaturedId1" Style="{StaticResource IdTextBox}" Tag="Asset ID"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5,0">
                    <TextBlock Text="Slot 2" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FeaturedId2" Style="{StaticResource IdTextBox}" Tag="Asset ID"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="5,0">
                    <TextBlock Text="Slot 3" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FeaturedId3" Style="{StaticResource IdTextBox}" Tag="Asset ID"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="5,0,0,0">
                    <TextBlock Text="Slot 4" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FeaturedId4" Style="{StaticResource IdTextBox}" Tag="Asset ID"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="SaveButton"
                        Content="Save"
                        Style="{StaticResource ModernButton}"
                        Width="100" Height="35"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource SubtleText}"
                        Width="100" Height="35"
                        Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

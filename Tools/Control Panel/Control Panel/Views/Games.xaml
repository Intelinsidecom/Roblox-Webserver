<UserControl x:Class="Control_Panel.GamesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Control_Panel"
        mc:Ignorable="d"
        Background="{DynamicResource Background}">
    <UserControl.Resources>
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <local:SettingsOverlay x:Name="GlobalSettingsOverlay" Grid.RowSpan="2" Panel.ZIndex="9999"/>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <StackPanel Margin="0,0,0,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Control Panel - Games" Style="{StaticResource DashboardTitle}" 
                                       Foreground="{DynamicResource AccentPrimary}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Roblox Webserver Management" 
                                       Style="{StaticResource DashboardSubtitle}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh" 
                                Style="{StaticResource ModernButton}"
                                Background="{DynamicResource AccentPrimary}"
                                Foreground="White"
                                Width="80" Height="35"
                                VerticalAlignment="Bottom"
                                Click="RefreshButton_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="Both"
                          CanContentScroll="False"
                          ScrollChanged="GamesScrollViewer_ScrollChanged">
                <StackPanel ClipToBounds="False">
                    <StackPanel Margin="20,0,20,0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="GameServersTabButton" Content="Game Servers"
                                Style="{StaticResource ModernButton}"
                                Background="{DynamicResource AccentPrimary}"
                                Foreground="White"
                                Height="40" Width="140"
                                Click="GameServersTabButton_Click"/>
                        <Button x:Name="GamesTabButton" Content="Games"
                                Style="{StaticResource ModernButton}"
                                Height="40" Width="80" Margin="0"
                                Background="Transparent"
                                Foreground="{DynamicResource Foreground}"
                                Click="GamesTabButton_Click"/>
                    </StackPanel>
                    <Line X1="20" Y1="0" X2="1" Y2="0" Stretch="Fill" 
                          Stroke="{DynamicResource SubtleText}" StrokeThickness="1" 
                          Margin="20,0,20,0"/>
                    <Grid x:Name="GameServersTab" Margin="20,20,20,0" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <Button Content="Kill All" Style="{StaticResource ModernButton}" 
                            Background="#FF4444" Foreground="White"
                            Width="80" Height="35"
                            Click="KillAllButton_Click"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                BorderThickness="1" Padding="15" Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Total Servers" Style="{StaticResource DashboardSectionTitle}" 
                                               Foreground="{DynamicResource AccentBlue}" FontSize="14"/>
                                    <TextBlock x:Name="TotalServersText" Text="0" Style="{StaticResource DashboardSectionTitle}" 
                                               Foreground="{DynamicResource AccentPrimary}" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Active Players" Style="{StaticResource DashboardSectionTitle}" 
                                               Foreground="{DynamicResource AccentGreen}" FontSize="14"/>
                                    <TextBlock x:Name="TotalPlayersText" Text="0" Style="{StaticResource DashboardSectionTitle}" 
                                               Foreground="{DynamicResource AccentPrimary}" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Running" Style="{StaticResource DashboardSectionTitle}" 
                                               Foreground="{DynamicResource AccentGreen}" FontSize="14"/>
                                    <TextBlock x:Name="RunningServersText" Text="0" Style="{StaticResource DashboardSectionTitle}" 
                                               Foreground="{DynamicResource AccentPrimary}" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Starting" Style="{StaticResource DashboardSectionTitle}" 
                                               Foreground="{DynamicResource AccentBlue}" FontSize="14"/>
                                    <TextBlock x:Name="ExpiredServersText" Text="0" Style="{StaticResource DashboardSectionTitle}" 
                                               Foreground="{DynamicResource AccentPrimary}" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                        BorderThickness="1" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Running Game Servers" Style="{StaticResource DashboardSectionTitle}" 
                                   Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,15"/>
                        <DataGrid x:Name="ServersDataGrid" Grid.Row="1"
                                 AutoGenerateColumns="False"
                                 CanUserAddRows="False"
                                 CanUserDeleteRows="False"
                                 CanUserReorderColumns="False"
                                 CanUserResizeColumns="True"
                                 CanUserResizeRows="False"
                                 CanUserSortColumns="True"
                                 GridLinesVisibility="Horizontal"
                                 HeadersVisibility="Column"
                                 SelectionMode="Single"
                                 SelectionChanged="ServersDataGrid_SelectionChanged"
                                 Background="{DynamicResource Background}"
                                 Foreground="{DynamicResource PrimaryText}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Game ID" Binding="{Binding GameId}" Width="200" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Place ID" Binding="{Binding PlaceId}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Players" Binding="{Binding PlayerCount}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Max Players" Binding="{Binding MaxPlayers}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Expires" Binding="{Binding Expiration, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="140" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                              Background="{DynamicResource SubtleText}" ShowsPreview="False"/>
                <Border Grid.Column="2" Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                        BorderThickness="1" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="CreateServerPanel" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" 
                                    Panel.ZIndex="100" IsEnabled="True">
                            <TextBlock Text="Create New Server" Style="{StaticResource DashboardSectionTitle}" 
                                       Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,15"/>
                            <Border Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                    BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Server Configuration" FontWeight="Bold" 
                                               Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Column="0" Grid.Row="0" Text="Place ID:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0"/>
                                        <TextBox x:Name="CreatePlaceIdTextBox" Grid.Column="1" Grid.Row="0" Text="1818" 
                                                Foreground="{DynamicResource Foreground}"
                                                Background="{DynamicResource Background}"
                                                BorderBrush="{DynamicResource SubtleText}"
                                                FontSize="16" FontFamily="Segoe UI"
                                                Height="25" Margin="5,2,0,10"
                                                Padding="8,0"
                                                IsReadOnly="False" IsEnabled="True" Focusable="True" TabIndex="1"/>
                                <TextBlock Grid.Column="0" Grid.Row="1" Text="Expiration (minutes):" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0"/>
                                <TextBox x:Name="CreateExpirationTextBox" Grid.Column="1" Grid.Row="1" Text="60" 
                                                Foreground="{DynamicResource Foreground}"
                                                Background="{DynamicResource Background}"
                                                BorderBrush="{DynamicResource SubtleText}"
                                                FontSize="16" FontFamily="Segoe UI"
                                                Height="25" Margin="5,2,0,10"
                                                Padding="8,0"
                                                IsReadOnly="False" IsEnabled="True" Focusable="True" TabIndex="2"/>
                                <TextBlock Grid.Column="0" Grid.Row="2" Text="Max Players:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0"/>
                                <TextBox x:Name="CreateMaxPlayersTextBox" Grid.Column="1" Grid.Row="2" Text="10" 
                                                Foreground="{DynamicResource Foreground}"
                                                Background="{DynamicResource Background}"
                                                BorderBrush="{DynamicResource SubtleText}"
                                                FontSize="16" FontFamily="Segoe UI"
                                                Height="25" Margin="5,2,0,10"
                                                Padding="8,0"
                                                IsReadOnly="False" IsEnabled="True" Focusable="True" TabIndex="3"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Button x:Name="CreateServerButton" Content="Create Server" 
                                    Style="{StaticResource ModernButton}" 
                                    Background="{DynamicResource AccentPrimary}" Foreground="White" 
                                    Height="35" Margin="0,10,0,0"
                                    Click="CreateServerButton_Click" IsEnabled="True"
                                    Focusable="True" TabIndex="4"/>
                        </StackPanel>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ServerDetailsHeader" Grid.Column="0" Text="Server Details" Style="{StaticResource DashboardSectionTitle}" 
                                       Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center"/>
                            <Button x:Name="CloseServerDetailsButton" Grid.Column="1" Content="✕" Style="{StaticResource SettingsButton}" 
                                    Background="Transparent" Foreground="{DynamicResource SubtleText}" FontSize="16" Width="30" Height="30"
                                    VerticalAlignment="Center"
                                    Click="CloseServerDetailsButton_Click" ToolTip="Close Server Details"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                            <StackPanel x:Name="ServerDetailsPanel">
                                <Border x:Name="ServerInfoPanel" Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                        BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Server Information" FontWeight="Bold" 
                                                   Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Column="0" Grid.Row="0" Text="Game ID:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="DetailGameIdText" Grid.Column="1" Grid.Row="0" Text="N/A" Style="{StaticResource LabelText}" Margin="5,2,0,0"/>
                                            <TextBlock Grid.Column="0" Grid.Row="1" Text="Place ID:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="DetailPlaceIdText" Grid.Column="1" Grid.Row="1" Text="N/A" Style="{StaticResource LabelText}" Margin="5,2,0,0"/>
                                            <TextBlock Grid.Column="0" Grid.Row="2" Text="Port:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="DetailPortText" Grid.Column="1" Grid.Row="2" Text="N/A" Style="{StaticResource LabelText}" Margin="5,2,0,0"/>
                                            <TextBlock Grid.Column="0" Grid.Row="3" Text="Players:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="DetailPlayersText" Grid.Column="1" Grid.Row="3" Text="N/A" Style="{StaticResource LabelText}" Margin="5,2,0,0"/>
                                            <TextBlock Grid.Column="0" Grid.Row="4" Text="Private Server:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="DetailPrivateServerText" Grid.Column="1" Grid.Row="4" Text="N/A" Style="{StaticResource LabelText}" Margin="5,2,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="TimingInfoPanel" Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                        BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Timing Information" FontWeight="Bold" 
                                                   Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Column="0" Grid.Row="0" Text="Start Time:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="DetailStartTimeText" Grid.Column="1" Grid.Row="0" Text="N/A" Style="{StaticResource LabelText}" Margin="5,2,0,0"/>
                                            <TextBlock Grid.Column="0" Grid.Row="1" Text="Expiration:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="DetailExpirationText" Grid.Column="1" Grid.Row="1" Text="N/A" Style="{StaticResource LabelText}" Margin="5,2,0,0"/>
                                            <TextBlock Grid.Column="0" Grid.Row="2" Text="Last Activity:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="DetailLastActivityText" Grid.Column="1" Grid.Row="2" Text="N/A" Style="{StaticResource LabelText}" Margin="5,2,0,0"/>
                                            <TextBlock Grid.Column="0" Grid.Row="3" Text="Inactivity Timeout:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="DetailInactivityTimeoutText" Grid.Column="1" Grid.Row="3" Text="N/A" Style="{StaticResource LabelText}" Margin="5,2,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="AuthenticationPanel" Background="{DynamicResource Background}" BorderBrush="{DynamicResource SubtleText}" 
                                        BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Authentication Ticket" FontWeight="Bold" 
                                                   Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,10"/>
                                        <Button x:Name="GenerateTicketButton" Content="Generate Authentication Ticket" 
                                                Style="{StaticResource ModernButton}" 
                                                Background="{DynamicResource AccentPrimary}" Foreground="White" 
                                                Height="30" Margin="0,0,0,10"
                                                Click="GenerateTicketButton_Click"/>
                                        <StackPanel x:Name="TicketInfoPanel" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Join Script:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0" VerticalAlignment="Top"/>
                                                <TextBox x:Name="JoinScriptUrlTextBox" Grid.Column="1" Grid.Row="0" 
                                                        Foreground="{DynamicResource Foreground}"
                                                        Background="{DynamicResource Background}"
                                                        BorderBrush="{DynamicResource SubtleText}"
                                                        FontSize="12" FontFamily="Consolas"
                                                        Height="60" Margin="5,2,5,5"
                                                        Padding="8,4"
                                                        TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                        IsReadOnly="True" Focusable="False"/>
                                                <Button x:Name="CopyJoinScriptButton" Grid.Column="2" Grid.Row="0" Content="📋" 
                                                        Style="{StaticResource SettingsButton}" 
                                                        Background="Transparent" Foreground="{DynamicResource SubtleText}" 
                                                        Width="30" Height="30" Margin="0,2,0,5"
                                                        VerticalAlignment="Top"
                                                        Click="CopyJoinScriptButton_Click" ToolTip="Copy Join Script URL"/>
                                                <TextBlock Grid.Column="0" Grid.Row="1" Text="Auth Ticket:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0" VerticalAlignment="Top"/>
                                                <TextBox x:Name="AuthTicketTextBox" Grid.Column="1" Grid.Row="1" 
                                                        Foreground="{DynamicResource Foreground}"
                                                        Background="{DynamicResource Background}"
                                                        BorderBrush="{DynamicResource SubtleText}"
                                                        FontSize="12" FontFamily="Consolas"
                                                        Height="60" Margin="5,2,5,5"
                                                        Padding="8,4"
                                                        TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                        IsReadOnly="True" Focusable="False"/>
                                                <Button x:Name="CopyAuthTicketButton" Grid.Column="2" Grid.Row="1" Content="📋" 
                                                        Style="{StaticResource SettingsButton}" 
                                                        Background="Transparent" Foreground="{DynamicResource SubtleText}" 
                                                        Width="30" Height="30" Margin="0,2,0,5"
                                                        VerticalAlignment="Top"
                                                        Click="CopyAuthTicketButton_Click" ToolTip="Copy Authentication Ticket"/>
                                                <TextBlock Grid.Column="0" Grid.Row="2" Text="Auth URL:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0" VerticalAlignment="Top"/>
                                                <TextBox x:Name="AuthUrlTextBox" Grid.Column="1" Grid.Row="2" 
                                                        Foreground="{DynamicResource Foreground}"
                                                        Background="{DynamicResource Background}"
                                                        BorderBrush="{DynamicResource SubtleText}"
                                                        FontSize="12" FontFamily="Consolas"
                                                        Height="60" Margin="5,2,5,5"
                                                        Padding="8,4"
                                                        TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                        IsReadOnly="True" Focusable="False"/>
                                                <Button x:Name="CopyAuthUrlButton" Grid.Column="2" Grid.Row="2" Content="📋" 
                                                        Style="{StaticResource SettingsButton}" 
                                                        Background="Transparent" Foreground="{DynamicResource SubtleText}" 
                                                        Width="30" Height="30" Margin="0,2,0,5"
                                                        VerticalAlignment="Top"
                                                        Click="CopyAuthUrlButton_Click" ToolTip="Copy Authentication URL"/>
                                                <TextBlock Grid.Column="0" Grid.Row="3" Text="Expires:" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,2,0,0"/>
                                                <TextBlock x:Name="TicketExpirationText" Grid.Column="1" Grid.Row="3" Text="N/A" Style="{StaticResource LabelText}" Margin="5,2,0,0"/>
                                            </Grid>
                                            <Border Background="{DynamicResource Background}" BorderBrush="{DynamicResource AccentPrimary}" 
                                                    BorderThickness="1" Padding="8" Margin="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Command Line Arguments:" FontWeight="Bold" 
                                                               Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,5"/>
                                                    <TextBox x:Name="CommandLineArgsTextBox" 
                                                            Foreground="{DynamicResource Foreground}"
                                                            Background="{DynamicResource Background}"
                                                            BorderBrush="Transparent"
                                                            FontSize="11" FontFamily="Consolas"
                                                            Height="40" Margin="0,0,0,5"
                                                            Padding="0"
                                                            TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                            IsReadOnly="True" Focusable="False"/>
                                                    <Button x:Name="CopyCommandLineButton" Content="📋 Copy Command Line" 
                                                            Style="{StaticResource ModernButton}" 
                                                            Background="{DynamicResource AccentPrimary}" Foreground="White" 
                                                            Height="25" FontSize="11"
                                                            Click="CopyCommandLineButton_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,15,0,0">
                            <StackPanel x:Name="ServerActionButtons">
                                <Button x:Name="KillServerButton" Content="Kill Server" Style="{StaticResource ModernButton}" 
                                        Background="#FF4444" Foreground="White" Height="35" Margin="0,0,0,10"
                                        Click="KillServerButton_Click" IsEnabled="False"/>
                                <Button x:Name="RefreshServerButton" Content="Refresh Status" Style="{StaticResource ModernButton}" 
                                        Background="{DynamicResource AccentPrimary}" Height="35"
                                        Click="RefreshServerButton_Click" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
                    </Grid>
                    <Grid x:Name="GamesTab" Margin="20,20,20,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,10" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="GameTypeFilter" 
                                          Height="30" Margin="0,0,5,0" Width="120"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="GameTypeFilter_SelectionChanged">
                                    <ComboBoxItem Content="All" IsSelected="True"/>
                                    <ComboBoxItem Content="Town &amp; City"/>
                                    <ComboBoxItem Content="Fantasy"/>
                                    <ComboBoxItem Content="Sci-Fi"/>
                                    <ComboBoxItem Content="Ninja"/>
                                    <ComboBoxItem Content="Scary"/>
                                    <ComboBoxItem Content="Pirate"/>
                                    <ComboBoxItem Content="Adventure"/>
                                    <ComboBoxItem Content="Sports"/>
                                    <ComboBoxItem Content="Funny"/>
                                    <ComboBoxItem Content="Wild West"/>
                                    <ComboBoxItem Content="War"/>
                                    <ComboBoxItem Content="Skate Park"/>
                                    <ComboBoxItem Content="Tutorial"/>
                                    <ComboBoxItem Content="RPG"/>
                                    <ComboBoxItem Content="FPS"/>
                                    <ComboBoxItem Content="Fighting"/>
                                    <ComboBoxItem Content="Building"/>
                                    <ComboBoxItem Content="Military"/>
                                    <ComboBoxItem Content="Naval"/>
                                    <ComboBoxItem Content="Medieval"/>
                                </ComboBox>
                                <ComboBox Grid.Column="1" x:Name="GameDateFilter" 
                                          Height="30" Margin="2.5,0" Width="100"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="GameDateFilter_SelectionChanged">
                                    <ComboBoxItem Content="Any Time" IsSelected="True"/>
                                    <ComboBoxItem Content="Today"/>
                                    <ComboBoxItem Content="This Week"/>
                                    <ComboBoxItem Content="This Month"/>
                                    <ComboBoxItem Content="This Year"/>
                                </ComboBox>
                                <ComboBox Grid.Column="2" x:Name="GameSortFilter" 
                                          Height="30" Margin="5,0,0,0" Width="120"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="GameSortFilter_SelectionChanged">
                                    <ComboBoxItem Content="Most Recent" IsSelected="True"/>
                                    <ComboBoxItem Content="The Oldest"/>
                                    <ComboBoxItem Content="Name A-Z"/>
                                    <ComboBoxItem Content="Name Z-A"/>
                                    <ComboBoxItem Content="Most Players"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="GameSearchTextBox" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="30" Margin="0,0,5,0"
                                         TextChanged="GameSearchTextBox_TextChanged"
                                         Padding="4,1,8,0" ToolTip="Search by Game Name" FontSize="16"
                                         HorizontalContentAlignment="Stretch" TextWrapping="NoWrap"
                                         Tag="Search by Game Name"
                                         GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                                <TextBox Grid.Column="1" x:Name="GameIdSearchTextBox" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="30" Margin="0"
                                         KeyDown="GameIdSearchTextBox_KeyDown"
                                         Padding="4,1,8,0" ToolTip="Enter Game ID"
                                         HorizontalContentAlignment="Stretch" TextWrapping="NoWrap"
                                         Tag="Enter Game ID"
                                         GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                            </Grid>
                            <ItemsControl x:Name="GameCardsItemsControl" ClipToBounds="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ClipToBounds="False" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Panel.ZIndex" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Panel.ZIndex" Value="100"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="GameCardRoot" Margin="0,0,11,12" Width="161" Height="223" Cursor="Hand" 
                                                Background="Transparent" BorderThickness="0" Click="GameCard_Click" Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent" ClipToBounds="False">
                                                        <Border x:Name="GameCardBorder" Width="161" Height="223"
                                                                Background="{DynamicResource Background}"
                                                                BorderBrush="{DynamicResource BorderColor}"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                ToolTip="{Binding Name}"
                                                                VerticalAlignment="Top" ClipToBounds="False">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Border Grid.Row="0" Width="150" Height="150" Margin="6,6,6,0"
                                                                        CornerRadius="3,3,0,0" ClipToBounds="True"
                                                                        HorizontalAlignment="Center">
                                                                    <Border.Background>
                                                                        <ImageBrush ImageSource="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                                    </Border.Background>
                                                                </Border>
                                                                <StackPanel Grid.Row="1" Margin="6,0,6,0">
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Foreground}"
                                                                               FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding SecondaryText}" Foreground="{DynamicResource SubtleText}"
                                                                               FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Grid.Row="0" FontSize="11" Foreground="{DynamicResource SubtleText}" Margin="6,0,0,5">
                                                                        <Run Text="{Binding PlayerCount, Mode=OneWay, StringFormat=N0}"/>
                                                                        <Run Text=" playing"/>
                                                                    </TextBlock>
                                                                    <Grid Grid.Row="1" Height="6" Background="#d86868" Margin="6,2,6,6">
                                                                        <Border Background="#02B757" HorizontalAlignment="Left"
                                                                            Width="{Binding UpVoteBarWidth}"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="GameCardHoverOverlay"
                                                                Background="{DynamicResource Background}"
                                                                BorderBrush="{DynamicResource BorderColor}"
                                                                BorderThickness="1,0,1,1"
                                                                CornerRadius="0,0,3,3"
                                                                Width="161"
                                                                VerticalAlignment="Top"
                                                                Panel.ZIndex="9999">
                                                            <Border.RenderTransform>
                                                                <TranslateTransform Y="222"/>
                                                            </Border.RenderTransform>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=GameCardRoot}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Margin="8,6,8,8">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                    <TextBlock Text="By " FontSize="12" Foreground="{DynamicResource SubtleText}"/>
                                                                    <Button x:Name="CreatorLinkButton" 
                                                                            Content="{Binding Creator}" 
                                                                            FontSize="12" 
                                                                            Foreground="{DynamicResource AccentPrimary}" 
                                                                            Background="Transparent" 
                                                                            BorderThickness="0" 
                                                                            Padding="0" 
                                                                            Cursor="Hand"
                                                                            Click="CreatorLink_Click"
                                                                            Tag="{Binding CreatorUserId}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="Button">
                                                                                            <TextBlock Text="{TemplateBinding Content}" 
                                                                                                       TextDecorations="None"/>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Style.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Template">
                                                                                            <Setter.Value>
                                                                                                <ControlTemplate TargetType="Button">
                                                                                                    <TextBlock Text="{TemplateBinding Content}" 
                                                                                                               TextDecorations="Underline"/>
                                                                                                </ControlTemplate>
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

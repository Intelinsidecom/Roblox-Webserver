<UserControl x:Class="Control_Panel.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="200"
             Background="{DynamicResource Background}">
    <UserControl.Resources>
    </UserControl.Resources>
    <Border Background="{DynamicResource SidebarBackground}" 
            BorderBrush="{DynamicResource BorderColor}" 
            BorderThickness="0,0,1,0">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" VerticalAlignment="Top">
                <Button Content="Dashboard" Height="40" Margin="0,2" 
                        Background="Transparent" BorderThickness="0"
                        Style="{DynamicResource SidebarButtonBlack}"
                        Click="DashboardButton_Click"/>
                <Button Content="Database" Height="40" Margin="0,2" 
                        Background="Transparent" BorderThickness="0"
                        Style="{DynamicResource SidebarButtonBlack}"
                        Click="DatabaseButton_Click"/>
                <Button Content="Users" Height="40" Margin="0,2" 
                        Background="Transparent" BorderThickness="0"
                        Style="{DynamicResource SidebarButtonBlack}"
                        Click="UsersButton_Click"/>
                <Button Content="Games" Height="40" Margin="0,2" 
                        Background="Transparent" BorderThickness="0"
                        Style="{DynamicResource SidebarButtonBlack}"
                        Click="GamesButton_Click"/>
                <Button Content="Assets" Height="40" Margin="0,2" 
                        Background="Transparent" BorderThickness="0"
                        Style="{DynamicResource SidebarButtonBlack}"
                        Click="AssetsButton_Click"/>
                <Button Content="Logs" Height="40" Margin="0,2" 
                        Background="Transparent" BorderThickness="0"
                        Style="{DynamicResource SidebarButtonBlack}"
                        Click="LogsButton_Click"/>
                <Button Content="About" Height="40" Margin="0,2" 
                        Background="Transparent" BorderThickness="0"
                        Style="{DynamicResource SidebarButtonBlack}"
                        Click="AboutButton_Click"/>
            </StackPanel>
            <Button Grid.Row="1" Content="⚙" Width="30" Height="30" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Right"
                    Style="{DynamicResource SettingsButton}"
                    Click="SettingsButton_Click"/>
        </Grid>
    </Border>
</UserControl>

<Window x:Class="Control_Panel.AssetEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Control_Panel"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Asset Edit" Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Name="HeaderTextBlock" Text="Asset Edit" 
                   Style="{StaticResource DashboardTitle}"
                   Foreground="{DynamicResource AccentPrimary}"
                   Margin="0,0,0,20"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" 
                               Style="{StaticResource DashboardSubtitle}" 
                               Foreground="{DynamicResource Foreground}"
                               Margin="0,0,0,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Name="AssetNameTextBox" 
                             Foreground="{DynamicResource Foreground}"
                             Background="{DynamicResource Background}"
                             BorderBrush="{DynamicResource SubtleText}"
                             FontSize="16"
                             Margin="0,0,0,15"
                             Padding="8,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" 
                               Style="{StaticResource DashboardSubtitle}" 
                               Foreground="{DynamicResource Foreground}"
                               Margin="0,0,0,10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Name="AssetDescriptionTextBox" 
                             Foreground="{DynamicResource Foreground}"
                             Background="{DynamicResource Background}"
                             BorderBrush="{DynamicResource SubtleText}"
                             FontSize="14"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="100"
                             Margin="0,0,0,15"
                             Padding="8,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Options:" 
                               Style="{StaticResource DashboardSubtitle}" 
                               Foreground="{DynamicResource Foreground}"
                               Margin="0,0,0,10"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,15">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="IsLimitedCheckBox" Content="Is Limited" 
                                      Style="{StaticResource ModernCheckBox}"
                                      Grid.Column="0"
                                      Checked="IsLimitedCheckBox_Checked" 
                                      Unchecked="IsLimitedCheckBox_Unchecked"/>
                            <CheckBox x:Name="PutOnSaleCheckBox" Content="Put on sale" 
                                      Style="{StaticResource ModernCheckBox}"
                                      Grid.Column="2"/>
                        </Grid>
                        <Grid x:Name="LimitedFieldsGrid" IsEnabled="False" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Available Until:" Style="{StaticResource DashboardSubtitle}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,3" FontSize="12"/>
                                <DatePicker x:Name="LimitedUntilDatePicker" 
                                           Height="25" FontSize="12"
                                           DisplayDateStart="{x:Static sys:DateTime.Today}">
                                    <DatePicker.Resources>
                                        <sys:DateTime x:Key="Today">2025-02-22</sys:DateTime>
                                    </DatePicker.Resources>
                                    <DatePicker.Style>
                                        <Style TargetType="{x:Type DatePicker}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DatePicker.Style>
                                </DatePicker>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Quantity:" Style="{StaticResource DashboardSubtitle}" 
                                           Foreground="{DynamicResource Foreground}" Margin="0,0,0,3" FontSize="12"/>
                                <TextBox x:Name="LimitedQuantityTextBox" 
                                         Height="25" FontSize="12"
                                         Foreground="{DynamicResource Foreground}"
                                         Background="{DynamicResource Background}"
                                         BorderBrush="{DynamicResource SubtleText}"
                                         Padding="4,2">
                                    <TextBox.Style>
                                        <Style TargetType="{x:Type TextBox}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Creator ID:" 
                               Style="{StaticResource DashboardSubtitle}" 
                               Foreground="{DynamicResource Foreground}"
                               Margin="0,0,0,10"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Name="CreatorIdTextBox" 
                             Foreground="{DynamicResource Foreground}"
                             Background="{DynamicResource Background}"
                             BorderBrush="{DynamicResource SubtleText}"
                             FontSize="16"
                             Margin="0,0,0,15"
                             Padding="8,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Robux Price:" 
                               Style="{StaticResource DashboardSubtitle}" 
                               Foreground="{DynamicResource Foreground}"
                               Margin="0,0,0,10"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Name="RobuxPriceTextBox" 
                             Foreground="{DynamicResource Foreground}"
                             Background="{DynamicResource Background}"
                             BorderBrush="{DynamicResource SubtleText}"
                             FontSize="16"
                             Margin="0,0,0,15"
                             Padding="8,4"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Tix Price:" 
                               Style="{StaticResource DashboardSubtitle}" 
                               Foreground="{DynamicResource Foreground}"
                               Margin="0,0,0,10"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Name="TixPriceTextBox" 
                             Foreground="{DynamicResource Foreground}"
                             Background="{DynamicResource Background}"
                             BorderBrush="{DynamicResource SubtleText}"
                             FontSize="16"
                             Margin="0,0,0,15"
                             Padding="8,4"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="File:" 
                               Style="{StaticResource DashboardSubtitle}" 
                               Foreground="{DynamicResource Foreground}"
                               Margin="0,0,0,10"/>
                    <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SelectedFileTextBox" 
                                 Foreground="{DynamicResource Foreground}"
                                 Background="{DynamicResource Background}"
                                 BorderBrush="{DynamicResource SubtleText}"
                                 FontSize="14"
                                 Height="30"
                                 Grid.Column="0"
                                 IsReadOnly="True"
                                 Padding="8,4"
                                 Text="No file selected..."/>
                        <Button Grid.Column="1" Content="Browse" 
                        Style="{DynamicResource ModernButton}"
                        Width="80" Height="30" Margin="5,0,0,0"
                        Click="BrowseButton_Click"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Name="SaveButton" Content="Save" 
                    Style="{DynamicResource ModernButton}"
                    Width="80"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="SaveButton_Click"/>
            <Button Name="CancelButton" Content="Cancel" 
                    Style="{DynamicResource ModernButton}"
                    Background="{DynamicResource SubtleText}"
                    Width="80"
                    Height="35"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- White Color Scheme - Light theme with white background -->
    <SolidColorBrush x:Key="Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Foreground" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="ForegroundLight" Color="#000000"/>
    <SolidColorBrush x:Key="SubtleText" Color="#888888"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#F8F8F8"/>
    
    
    <!-- Sidebar Hover Colors -->
    <SolidColorBrush x:Key="SidebarHover" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="SidebarPressed" Color="#D0D0D0"/>
    
</ResourceDictionary>

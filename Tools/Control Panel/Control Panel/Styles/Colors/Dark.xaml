<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Dark Color Scheme -->
    <SolidColorBrush x:Key="Background" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#252525"/>
    <SolidColorBrush x:Key="Foreground" Color="#F8F8F8"/>
    <SolidColorBrush x:Key="SubtleText" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="ForegroundLight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderColor" Color="#333333"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#252525"/>
    
    <!-- Sidebar Hover Colors -->
    <SolidColorBrush x:Key="SidebarHover" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="SidebarPressed" Color="#5A5A5A"/>
    
</ResourceDictionary>

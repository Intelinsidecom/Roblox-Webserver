<!DOCTYPE html>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using Npgsql
@using System.Text.RegularExpressions

@{
    var userAgent = ViewContext.HttpContext.Request.Headers["User-Agent"].ToString() ?? "";
    bool containsAndroid = userAgent.Contains("Android");
    bool containsRobloxAndroid = userAgent.Contains("ROBLOX Android App");
    bool containsIPhone = userAgent.Contains("iPhone");
    bool containsIPad = userAgent.Contains("iPad");
    bool containsIPod = userAgent.Contains("iPod");
    bool containsRobloxiOS = userAgent.Contains("ROBLOX iOS App");
    bool containsRobloxUWP = userAgent.Contains("EdgeWebView") || userAgent.Contains("MSAppHost") || userAgent.Contains("Windows UWP") || /*userAgent.Contains("WOW64")  breaks ie  ||*/ userAgent.Contains("Edge/");
    bool containsRobloxStudio = userAgent.Contains("RobloxStudio");

    bool isApp = containsRobloxAndroid || containsRobloxiOS || containsRobloxUWP || containsRobloxStudio;
    
    ViewBag.IsMobile = isApp;
    ViewBag.IsAndroid = containsAndroid || containsRobloxAndroid;
    ViewBag.IsIOS = containsIPhone || containsIPad || containsIPod || containsRobloxiOS;
    ViewBag.ProtocolName = (containsIPhone || containsIPad || containsIPod || containsRobloxiOS) ? "robloxmobile" : "freblx-player";
    ViewBag.DebugUserAgent = userAgent;
    ViewBag.DebugIsMobile = isApp;
}

@functions {
    private string ParseGlobalMessage(string message)
    {
        if (string.IsNullOrEmpty(message))
            return message;
        
        var pattern = @"\[([^\(\)]+)\(([^\)]+)\)\]";
        var regex = new Regex(pattern);
        
        return regex.Replace(message, match =>
        {
            var text = match.Groups[1].Value.Trim();
            var url = match.Groups[2].Value.Trim();
            if (!url.StartsWith("http://") && !url.StartsWith("https://"))
            {
                url = "https://" + url;
            }
            
            return $"<a href=\"{url}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color: #fff; text-decoration: underline;\">{text}</a>";
        });
    }
}

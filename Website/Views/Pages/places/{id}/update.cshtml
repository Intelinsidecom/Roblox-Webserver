                                <div id="ProcessingView" style="display: none">
                                    <div class="ProcessingModalBody">
                                        <p class="processing-indicator"><img
                                                src='/images/ec4e85b0c4396cf753a06fade0a8d8af.gif'
                                                alt="Saving the Game..." />
                                        </p>
                                        <p class="processing-text">Saving the Game...</p>
                                    </div>
                                </div>

                                <script type="text/javascript">
                                    if (typeof Roblox === "undefined") {
                                        Roblox = {};
                                    }
                                    if (typeof Roblox.UniverseConfigurePage === "undefined") {
                                        Roblox.UniverseConfigurePage = {};
                                    }
                                    
                                    if (typeof Roblox.AccessData === "undefined") {
                                        Roblox.AccessData = {
                                            privateServersAllowed: @(ViewBag.privateServersAllowed == true ? "true" : "false"),
                                            privateServersFree: @(ViewBag.privateServersFree == true ? "true" : "false"),
                                            isDevelopSiteForVipServersEnabled: true,
                                            vipServerConfigurationLink: "/universes/" + @(gameid) + "/configuration/vip-servers"
                                        };
                                    } else {
                                        Roblox.AccessData.privateServersAllowed = @(ViewBag.privateServersAllowed == true ? "true" : "false");
                                        Roblox.AccessData.privateServersFree = @(ViewBag.privateServersFree == true ? "true" : "false");
                                    }
                                    
                                    $(document).ready(function() {
                                        var hash = window.location.hash;
                                        if (hash && hash.includes('#developerProducts')) {
                                            sessionStorage.setItem('activeConfigureTab', 'developerProducts');
                                        }
                                        
                                        var serverTab = '@(ViewBag.ActiveTab ?? "")';
                                        if (serverTab) {
                                            sessionStorage.setItem('activeConfigureTab', serverTab);
                                        }
                                        
                                        var savedTab = sessionStorage.getItem('activeConfigureTab');
                                        if (savedTab) {
                                            var tabElement = $('[data-maindiv="' + savedTab + '"]');
                                            if (tabElement.length > 0) {
                                                sessionStorage.removeItem('activeConfigureTab');
                                                $('.verticaltab').removeClass('selected');
                                                $('.configure-tab').hide();
                                                tabElement.addClass('selected');
                                                $('#' + savedTab).show();
                                            }
                                        }
                                        
                                        var hasCustomIcon = @(ViewBag.hasCustomIcon == true ? "true" : "false");
                                        var hasGeneratedIcon = @(ViewBag.hasGeneratedIcon == true ? "true" : "false");
                                        var hasAutoGeneratedThumbnail = @(ViewBag.hasAutoGeneratedThumbnail == true ? "true" : "false");
                                        var hasCustomThumbnail = @(ViewBag.hasCustomThumbnail == true ? "true" : "false");
                                        var hasVideoThumbnail = @(ViewBag.hasVideoThumbnail == true ? "true" : "false");
                                        
                                        $('input[name="iconType"]').change(function() {
                                            if ($(this).val() === 'autogenerated') {
                                                $('#ImageUpload').hide();
                                                $('#autogenerate').show();
                                            } else {
                                                $('#ImageUpload').show();
                                                $('#autogenerate').hide();
                                            }
                                        });
                                        
                                        $('input[name="thumbnailType"]').change(function() {
                                            var selectedType = $(this).val();
                                            
                                            if (selectedType === 'image') {
                                                $('#thumbnails #ImageUpload').show();
                                                $('#thumbnails #VideoUpload').hide();
                                                $('#thumbnails #autogenerate').hide();
                                            } else if (selectedType === 'video') {
                                                $('#thumbnails #ImageUpload').hide();
                                                $('#thumbnails #VideoUpload').show();
                                                $('#thumbnails #autogenerate').hide();
                                            } else {
                                                $('#thumbnails #ImageUpload').hide();
                                                $('#thumbnails #VideoUpload').hide();
                                                $('#thumbnails #autogenerate').show();
                                            }
                                            
                                            if (selectedType === 'image' || selectedType === 'video') {
                                                $('#divSmallGalleryScrollContainer .divSmallGalleryItem').show();
                                            } else {
                                                $('#divSmallGalleryScrollContainer .divSmallGalleryItem').hide();
                                            }
                                        });
                                        
                                        if (hasCustomIcon === true) {
                                            $('#imageIcon').prop('checked', true);
                                            $('#ImageUpload').show();
                                            $('#autogenerate').hide();
                                        } else if (hasGeneratedIcon === true) {
                                            $('#autogenerated').prop('checked', true);
                                            $('#ImageUpload').hide();
                                            $('#autogenerate').show();
                                        } else {
                                            $('#autogenerated').prop('checked', true);
                                            $('#ImageUpload').hide();
                                            $('#autogenerate').show();
                                        }
                                        if (hasAutoGeneratedThumbnail === true) {
                                            $('#autogeneratedThumbnail').prop('checked', true);
                                            $('#thumbnails #ImageUpload').hide();
                                            $('#thumbnails #VideoUpload').hide();
                                            $('#thumbnails #autogenerate').show();
                                            $('#divSmallGalleryScrollContainer .divSmallGalleryItem').hide();
                                        } else if (hasCustomThumbnail === true) {
                                            $('#imageThumbnail').prop('checked', true);
                                            $('#thumbnails #ImageUpload').show();
                                            $('#thumbnails #VideoUpload').hide();
                                            $('#thumbnails #autogenerate').hide();
                                            $('#divSmallGalleryScrollContainer .divSmallGalleryItem').show();
                                        } else if (hasVideoThumbnail === true) {
                                            $('#youtubeThumbnail').prop('checked', true);
                                            $('#thumbnails #ImageUpload').hide();
                                            $('#thumbnails #VideoUpload').show();
                                            $('#thumbnails #autogenerate').hide();
                                            $('#divSmallGalleryScrollContainer .divSmallGalleryItem').show();
                                        } else {
                                            $('#autogeneratedThumbnail').prop('checked', true);
                                            $('#thumbnails #ImageUpload').hide();
                                            $('#thumbnails #VideoUpload').hide();
                                            $('#thumbnails #autogenerate').show();
                                            $('#divSmallGalleryScrollContainer .divSmallGalleryItem').hide();
                                        }
                                        
                                        var allowedGearTypes = @(Html.Raw(ViewBag.allowedGearTypes ?? "[]"));
                                        if (Array.isArray(allowedGearTypes)) {
                                            allowedGearTypes.forEach(function(gearTypeId) {
                                                $('input[name$=".Category"]').each(function() {
                                                    var category = $(this).val();
                                                    var categoryId = getGearTypeIdFromCategory(category);
                                                    if (categoryId === gearTypeId) {
                                                        $(this).siblings('input[type="checkbox"]').prop('checked', true);
                                                    }
                                                });
                                            });
                                        }
                                        function getGearTypeIdFromCategory(category) {
                                            var categoryMap = {
                                                'Melee': 1,
                                                'PowerUps': 2,
                                                'Ranged': 3,
                                                'Navigation': 4,
                                                'Explosive': 5,
                                                'Musical': 6,
                                                'Social': 7,
                                                'PersonalTransport': 8,
                                                'Building': 9
                                            };
                                            return categoryMap[category] || null;
                                        }
                                        
                                        $('input[name="iconType"]:checked').trigger('change');
                                        $('input[name="thumbnailType"]:checked').trigger('change');
                                        
                                        if (typeof Roblox.IDE.ThumbnailGallery !== 'undefined' && 
                                            typeof Roblox.IDE.ThumbnailGallery.init === 'function') {
                                            Roblox.IDE.ThumbnailGallery.init();
                                        }
                                        
                                        if (typeof Roblox.DeveloperProductsListing !== 'undefined' && 
                                            typeof Roblox.DeveloperProductsListing.init === 'function') {
                                            Roblox.DeveloperProductsListing.init();
                                        }
                                        
                                        var observer = new MutationObserver(function(mutations) {
                                            mutations.forEach(function(mutation) {
                                                if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
                                                    var target = $(mutation.target);
                                                    if (target.attr('id') === 'developerProducts' && target.css('display') !== 'none') {
                                                        initializeDeveloperProducts();
                                                    }
                                                }
                                            });
                                        });
                                        
                                        observer.observe(document.getElementById('developerProducts'), {
                                            attributes: true,
                                            attributeFilter: ['style']
                                        });
                                        
                                        function initializeDeveloperProducts() {
                                            if ($('#DevProducts').length > 0) {
                                                var requestUrl = $('#DevProducts').attr('src');
                                                $('#DevProducts').trigger('onRefreshed');
                                                
                                                if (typeof Roblox.DeveloperProductsListing !== 'undefined') {
                                                    if (typeof Roblox.DeveloperProductsListing.init === 'function') {                                                    
                                                        if (typeof Roblox.DeveloperProductsForm !== 'undefined' && typeof Roblox.DeveloperProductsForm.init === 'function') {
                                                            Roblox.DeveloperProductsForm.init();
                                                        } else {
                                                            console.log('Roblox.DeveloperProductsForm is not available');
                                                        }
                                                    } else {
                                                        console.log('Roblox.DeveloperProductsListing.init is not a function');
                                                    }
                                                } else {
                                                    console.log('Roblox.DeveloperProductsListing is undefined');
                                                }
                                            } else {
                                                console.log('DevProducts container not found');
                                            }
                                        }
                                        
                                        if ($('#developerProducts').css('display') !== 'none') {
                                            initializeDeveloperProducts();
                                        }
                                    });
                                </script>
                                <div style="clear: both"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

                                    <form id="configureUniverseForm" method="post"
                                        action="/places/doconfigure2" enctype="multipart/form-data">
                                        <input type="hidden" id="Id" name="Id" value="@gameid" />
                                        <div id="basicSettings" class="configure-tab">
                                            <div class="headline">
                                                <h2>Basic Settings</h2>
                                            </div>


                                            <div class="universe-form-label ">
                                                <label class="form-label" for="Name">Name</label>:
                                            </div>
                                            <div class="description-field-container">
                                                <input autofocus="" class="text-box text-box-medium universe-input"
                                                    id="Name" maxlength="50" name="Name" type="text"
                                                    value="@gamename" />
                                                <div class="tool-tip warning-text name-error" style="display: none">
                                                    Name cannot be empty
                                                    <img src="/images/77c4414271016f8257c136305b7888b4.png"
                                                        class="right">
                                                </div>
                                            </div>
                                            <div class="universe-form-label ">
                                                <label class="form-label" for="Description">Description</label>:
                                            </div>
                                            <div class="name-field-container">
                                                <textarea class="text-box text-area-medium universe-input" cols="80" id="Description" maxlength="1000" name="Description" rows="6">@gamedesc</textarea>
                                                <div class="tool-tip warning-text name-error" style="display: none">
                                                    Description cannot be empty
                                                    <img src="/images/77c4414271016f8257c136305b7888b4.png"
                                                        class="right">
                                                </div>
                                            </div>

                                            <div class="universe-form-label ">
                                                <label class="form-label" for="Genre">Genre</label>:
                                            </div>
                                            <select class="form-select no-margins" id="Genre" name="Genre">
                                                <option value="All"@(gamegenre == "All" ? " selected=\"selected\"" : "")>All</option>
                                                <option value="Adventure"@(gamegenre == "Adventure" ? " selected=\"selected\"" : "")>Adventure</option>
                                                <option value="Building"@(gamegenre == "Building" ? " selected=\"selected\"" : "")>Building</option>
                                                <option value="Comedy"@(gamegenre == "Comedy" ? " selected=\"selected\"" : "")>Comedy</option>
                                                <option value="Fighting"@(gamegenre == "Fighting" ? " selected=\"selected\"" : "")>Fighting</option>
                                                <option value="FPS"@(gamegenre == "FPS" ? " selected=\"selected\"" : "")>FPS</option>
                                                <option value="Horror"@(gamegenre == "Horror" ? " selected=\"selected\"" : "")>Horror</option>
                                                <option value="Medieval"@(gamegenre == "Medieval" ? " selected=\"selected\"" : "")>Medieval</option>
                                                <option value="Military"@(gamegenre == "Military" ? " selected=\"selected\"" : "")>Military</option>
                                                <option value="Naval"@(gamegenre == "Naval" ? " selected=\"selected\"" : "")>Naval</option>
                                                <option value="RPG"@(gamegenre == "RPG" ? " selected=\"selected\"" : "")>RPG</option>
                                                <option value="Sci-Fi"@(gamegenre == "Sci-Fi" ? " selected=\"selected\"" : "")>Sci-Fi</option>
                                                <option value="Sports"@(gamegenre == "Sports" ? " selected=\"selected\"" : "")>Sports</option>
                                                <option value="Town and City"@(gamegenre == "Town and City" ? " selected=\"selected\"" : "")>Town and City</option>
                                                <option value="Western"@(gamegenre == "Western" ? " selected=\"selected\"" : "")>Western</option>

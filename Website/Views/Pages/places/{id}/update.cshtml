                                    <label class="form-label check-box-label" style="margin-top: 30px; display: block;">Gear types:</label>
                                    <ul id="gearTypes" style="list-style-type: none; width: 500px; overflow: hidden; margin-bottom: 10px;">
                                    @{

                                        var allowedGearTypesJson = ViewBag.allowedGearTypes?.ToString() ?? "[]";
                                        List<string> allowedGearTypes = new List<string>();
                                        try 
                                        {
                                            if (!string.IsNullOrEmpty(allowedGearTypesJson) && allowedGearTypesJson != "[]")
                                            {
                                                var parsedTypeIds = System.Text.Json.JsonSerializer.Deserialize<List<int>>(allowedGearTypesJson) ?? new List<int>();
                                                
                                                var idToCategoryMap = new Dictionary<int, string>
                                                {
                                                    { 1, "Melee" },
                                                    { 2, "PowerUps" },
                                                    { 3, "Ranged" },
                                                    { 4, "Navigation" },
                                                    { 5, "Explosive" },
                                                    { 6, "Musical" },
                                                    { 7, "Social" },
                                                    { 8, "PersonalTransport" },
                                                    { 9, "Building" }
                                                };
                                                
                                                foreach (var typeId in parsedTypeIds)
                                                {
                                                    if (idToCategoryMap.TryGetValue(typeId, out string categoryName))
                                                    {
                                                        allowedGearTypes.Add(categoryName);
                                                    }
                                                }
                                            }
                                        }
                                        catch 
                                        {
                                            try
                                            {
                                                if (!string.IsNullOrEmpty(allowedGearTypesJson) && allowedGearTypesJson != "[]")
                                                {
                                                    var parsedTypes = System.Text.Json.JsonSerializer.Deserialize<List<string>>(allowedGearTypesJson) ?? new List<string>();
                                                    
                                                    foreach (var type in parsedTypes)
                                                    {
                                                        if (int.TryParse(type, out int typeId))
                                                        {
                                                            var legacyIdToCategoryMap = new Dictionary<string, string>
                                                            {
                                                                { "1", "Melee" },
                                                                { "2", "PowerUps" },
                                                                { "3", "Ranged" },
                                                                { "4", "Navigation" },
                                                                { "5", "Explosive" },
                                                                { "6", "Musical" },
                                                                { "7", "Social" },
                                                                { "8", "PersonalTransport" },
                                                                { "9", "Building" }
                                                            };
                                                            
                                                            if (legacyIdToCategoryMap.TryGetValue(type, out string categoryName))
                                                            {
                                                                allowedGearTypes.Add(categoryName);
                                                            }
                                                        }
                                                        else
                                                        {
                                                            allowedGearTypes.Add(type);
                                                        }
                                                    }
                                                }
                                            }
                                            catch
                                            {
                                                allowedGearTypes = new List<string>();
                                            }
                                        }

                                        var gearTypes = new[]
                                        {
                                            new { DisplayName = "Melee", Category = "Melee" },
                                            new { DisplayName = "Power ups", Category = "PowerUps" },
                                            new { DisplayName = "Ranged", Category = "Ranged" },
                                            new { DisplayName = "Navigation", Category = "Navigation" },
                                            new { DisplayName = "Explosives", Category = "Explosive" },
                                            new { DisplayName = "Musical", Category = "Musical" },
                                            new { DisplayName = "Social", Category = "Social" },
                                            new { DisplayName = "Transport", Category = "PersonalTransport" },
                                            new { DisplayName = "Building", Category = "Building" }
                                        };

                                        for (int i = 0; i < gearTypes.Length; i++)
                                        {
                                            var gearType = gearTypes[i];
                                            var isChecked = allowedGearTypes.Contains(gearType.Category) ? "checked=\"checked\"" : "";
                                            <li class="gearCheckbox" style="width: 160px; float: left; margin-bottom: 2px;">
                                                <label class="checkboxListItem">
                                                    <input @isChecked data-val="true" data-val-required="The IsSelected field is required." id="AllowedGearTypes_@(i)__IsSelected" name="AllowedGearTypes[@(i)].IsSelected" type="checkbox" value="true" />
                                                    <input name="AllowedGearTypes[@(i)].IsSelected" type="hidden" value="false" />
                                                    @gearType.DisplayName
                                                </label>
                                                <input id="AllowedGearTypes_@(i)__GearTypeDisplayName" name="AllowedGearTypes[@(i)].GearTypeDisplayName" type="hidden" value="@gearType.DisplayName" />
                                                <input data-val="true" data-val-required="The Category field is required." id="AllowedGearTypes_@(i)__Category" name="AllowedGearTypes[@(i)].Category" type="hidden" value="@gearType.Category" />
                                            </li>
                                        }
                                    }
                                    </ul>
                                    <div class="divider-bottom spacing" style="margin-top: 15px;"></div>
                                    <div class="headline" style="margin-top: 10px;">
                                        <h2 id="otherSettings">Other Permissions</h2>
                                    </div>

                                    <input id="ChatType" name="ChatType" type="hidden" value="Classic" />

                                    <fieldset>
                                        By checking this box, <b>you are granting every other user of Roblox the right to use</b> (in various ways) the content you are now sharing. <b>If you do not want to grant this right, please do not check this box</b>. For more information about sharing content, please review the Roblox <a class='text-link' href='https://www.roblox.com/info/terms' class='rbx-link'>Terms of Use</a>.
                                        <br>
                                        <label id="copyLock">
                                            <input data-val="true" data-val-required="The Allow Copying field is required." id="IsCopyingAllowed" name="IsCopyingAllowed" type="checkbox" value="true" @(ViewBag.isCopyingAllowed == true ? "checked=\"checked\"" : "") /><input name="IsCopyingAllowed" type="hidden" value="false" /> <span class="checkboxListItem">Allow Copying</span>
                                        </label>

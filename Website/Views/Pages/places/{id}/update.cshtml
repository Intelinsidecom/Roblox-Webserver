                                        <div id="AllowCopyInGame">
                                            <label id="AllowPlaceToBeCopied">
                                                <input data-val="true"
                                                    data-val-required="The AllowPlaceToBeCopiedInGame field is required."
                                                    id="AllowPlaceToBeCopiedInGame"
                                                    name="AllowPlaceToBeCopiedInGame" type="checkbox"
                                                    value="true" @(ViewBag.allowPlaceToBeCopiedInGame == true ? "checked=\"checked\"" : "")><input name="AllowPlaceToBeCopiedInGame"
                                                    type="hidden" value="false">
                                                <span class="checkboxListItem">Allow this place to be copied as
                                                    a template using the
                                                    <a href="https://developer.rbx2016.nl/en-us/api-reference/function/AssetService/CreatePlaceAsync"
                                                        target="blank">Create Place API</a>
                                                    in your game.

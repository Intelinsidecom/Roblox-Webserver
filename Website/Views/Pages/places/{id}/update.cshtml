                                <div id="permissions" class="configure-tab" style="display:none">
                                    
                                </div>
                                <div id="gameUpdate" class="configure-tab" style="display: none">


                                </div>

                                <div id="ProcessingView" style="display: none">

                                    <div class="ProcessingModalBody">
                                        <p class="processing-indicator"><img
                                                src='/images/ec4e85b0c4396cf753a06fade0a8d8af.gif'
                                                alt="Saving the Game..." />
                                        </p>
                                        <p class="processing-text">Saving the Game...</p>
                                    </div>
                                </div>

                                <script type="text/javascript">
                                    if (typeof Roblox === "undefined") {
                                        Roblox = {};
                                    }
                                    if (typeof Roblox.UniverseConfigurePage === "undefined") {
                                        Roblox.UniverseConfigurePage = {};
                                    }
                                    
                                    // Initialize AccessData to prevent JavaScript errors
                                    if (typeof Roblox.AccessData === "undefined") {
                                        Roblox.AccessData = {
                                            privateServersAllowed: true,
                                            isDevelopSiteForVipServersEnabled: true,
                                            vipServerConfigurationLink: "/universes/" + @(gameid) + "/configuration/vip-servers"
                                        };
                                    }
                                    
                                    // Game Icon functionality
                                    $(document).ready(function() {
                                        // Restore active tab from sessionStorage if available
                                        var savedTab = sessionStorage.getItem('activeConfigureTab');
                                        if (savedTab) {
                                            var tabElement = $('[data-maindiv="' + savedTab + '"]');
                                            if (tabElement.length > 0) {
                                                // Clear sessionStorage after use
                                                sessionStorage.removeItem('activeConfigureTab');
                                                // Switch to the saved tab
                                                $('.verticaltab').removeClass('selected');
                                                $('.configure-tab').hide();
                                                tabElement.addClass('selected');
                                                $('#' + savedTab).show();
                                            }
                                        }
                                        
                                        var hasCustomIcon = @(ViewBag.hasCustomIcon == true ? "true" : "false");
                                        var hasGeneratedIcon = @(ViewBag.hasGeneratedIcon == true ? "true" : "false");
                                        
                                        // Thumbnail functionality - set radio buttons based on database state
                                        var hasAutoGeneratedThumbnail = @(ViewBag.hasAutoGeneratedThumbnail == true ? "true" : "false");
                                        var hasCustomThumbnail = @(ViewBag.hasCustomThumbnail == true ? "true" : "false");
                                        var hasVideoThumbnail = @(ViewBag.hasVideoThumbnail == true ? "true" : "false");
                                        
                                        // Radio button change handler for icons
                                        $('input[name="iconType"]').change(function() {
                                            if ($(this).val() === 'autogenerated') {
                                                $('#ImageUpload').hide();
                                                $('#autogenerate').show();
                                            } else {
                                                $('#ImageUpload').show();
                                                $('#autogenerate').hide();
                                            }
                                        });
                                        
                                        // Radio button change handler for thumbnails
                                        $('input[name="thumbnailType"]').change(function() {
                                            var selectedType = $(this).val();
                                            
                                            // Show/hide upload sections
                                            if (selectedType === 'image') {
                                                $('#thumbnails #ImageUpload').show();
                                                $('#thumbnails #VideoUpload').hide();
                                                $('#thumbnails #autogenerate').hide();
                                            } else if (selectedType === 'video') {
                                                $('#thumbnails #ImageUpload').hide();
                                                $('#thumbnails #VideoUpload').show();
                                                $('#thumbnails #autogenerate').hide();
                                            } else {
                                                $('#thumbnails #ImageUpload').hide();
                                                $('#thumbnails #VideoUpload').hide();
                                                $('#thumbnails #autogenerate').show();
                                            }
                                            
                                            // Show/hide custom thumbnail gallery based on selection
                                            if (selectedType === 'image' || selectedType === 'video') {
                                                $('#divSmallGalleryScrollContainer .divSmallGalleryItem').show();
                                            } else {
                                                $('#divSmallGalleryScrollContainer .divSmallGalleryItem').hide();
                                            }
                                        });
                                        
                                        // Set icon radio button based on database state
                                        if (hasCustomIcon === true) {
                                            $('#imageIcon').prop('checked', true);
                                            $('#ImageUpload').show();
                                            $('#autogenerate').hide();
                                        } else if (hasGeneratedIcon === true) {
                                            $('#autogenerated').prop('checked', true);
                                            $('#ImageUpload').hide();
                                            $('#autogenerate').show();
                                        } else {
                                            $('#autogenerated').prop('checked', true);
                                            $('#ImageUpload').hide();
                                            $('#autogenerate').show();
                                        }
                                        
                                        // Set thumbnail radio button based on database state
                                        // Use the same priority logic as the gallery: auto-generated > custom > video
                                        if (hasAutoGeneratedThumbnail === true) {
                                            $('#autogeneratedThumbnail').prop('checked', true);
                                            $('#thumbnails #ImageUpload').hide();
                                            $('#thumbnails #VideoUpload').hide();
                                            $('#thumbnails #autogenerate').show();
                                            // Hide custom thumbnail gallery when auto-generated is selected
                                            $('#divSmallGalleryScrollContainer .divSmallGalleryItem').hide();
                                        } else if (hasCustomThumbnail === true) {
                                            $('#imageThumbnail').prop('checked', true);
                                            $('#thumbnails #ImageUpload').show();
                                            $('#thumbnails #VideoUpload').hide();
                                            $('#thumbnails #autogenerate').hide();
                                            // Show custom thumbnail gallery when image is selected
                                            $('#divSmallGalleryScrollContainer .divSmallGalleryItem').show();
                                        } else if (hasVideoThumbnail === true) {
                                            $('#youtubeThumbnail').prop('checked', true);
                                            $('#thumbnails #ImageUpload').hide();
                                            $('#thumbnails #VideoUpload').show();
                                            $('#thumbnails #autogenerate').hide();
                                            // Show custom thumbnail gallery when video is selected
                                            $('#divSmallGalleryScrollContainer .divSmallGalleryItem').show();
                                        } else {
                                            // Default to auto-generated if nothing is set
                                            $('#autogeneratedThumbnail').prop('checked', true);
                                            $('#thumbnails #ImageUpload').hide();
                                            $('#thumbnails #VideoUpload').hide();
                                            $('#thumbnails #autogenerate').show();
                                            // Hide custom thumbnail gallery when auto-generated is selected
                                            $('#divSmallGalleryScrollContainer .divSmallGalleryItem').hide();
                                        }
                                        
                                        // Trigger change events to ensure consistency
                                        $('input[name="iconType"]:checked').trigger('change');
                                        $('input[name="thumbnailType"]:checked').trigger('change');
                                        
                                        // Initialize Thumbnail Gallery functionality
                                        if (typeof Roblox.IDE.ThumbnailGallery !== 'undefined' && 
                                            typeof Roblox.IDE.ThumbnailGallery.init === 'function') {
                                            Roblox.IDE.ThumbnailGallery.init();
                                        }
                                    });
                                </script>
                                <div style="clear: both"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>



                                    <div id="thumbnails" class="configure-tab" style="display: none">
							<div class="headline">
								<h2>Thumbnails</h2>
							</div>
						<div class="thumbnail-section">
							@{
								var placeThumbnails = ViewBag.placeThumbnails as List<object> ?? new List<object>();
								var firstImageThumbnail = placeThumbnails.FirstOrDefault(t => t.GetType().GetProperty("type")?.GetValue(t)?.ToString() == "image");
								var firstThumbnailUrl = firstImageThumbnail != null ? 
									firstImageThumbnail.GetType().GetProperty("url")?.GetValue(firstImageThumbnail)?.ToString() ?? "" : "";
								
								// Use auto-generated thumbnail if it exists, otherwise use gallery thumbnail
								// Auto-generated thumbnail should ALWAYS be shown in main preview when enabled
								var mainThumbnailUrl = hasAutoGeneratedThumbnail ? 
									placeGeneratedThumbnailUrl : firstThumbnailUrl;
							}
							<div id="ThumbnailDisplayContainer" 
							     data-place-id="@gameid" 
							     data-is-place="true"
							     data-media-items-count="@(placeThumbnails.Count > 0 ? placeThumbnails.Count - 1 : 0)"
							     data-remove-url="/places/thumbnails/remove"
							     data-has-auto-generated-thumbnail="@hasAutoGeneratedThumbnail"
							     data-auto-generated-thumbnail-url="@placeGeneratedThumbnailUrl">
							<div class="thumbnail-preview">
								@if (hasVideoThumbnail == true)
								{
									// Find video thumbnail from placeThumbnails
									var videoThumbnail = placeThumbnails.FirstOrDefault(t => t.GetType().GetProperty("type")?.GetValue(t)?.ToString() == "video");
									var videoUrl = videoThumbnail?.GetType().GetProperty("videoUrl")?.GetValue(videoThumbnail)?.ToString() ?? "";
									
									if (!string.IsNullOrEmpty(videoUrl))
									{
										// Extract YouTube video ID from URL using utility
										var videoId = YouTubeUtilities.ExtractVideoId(videoUrl);
										
										if (!string.IsNullOrEmpty(videoId))
										{
											<div class="video-thumbnail-container" style="height: 18em; width: 32em; display: flex; align-items: center; justify-content: center; background: #000; overflow: hidden;">
												<iframe 
													width="100%" 
													height="100%" 
													src="https://www.youtube.com/embed/@videoId" 
													frameborder="0" 
													allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
													allowfullscreen
													style="border: none;">
												</iframe>
											</div>
										}
										else
										{
											// Fallback to image if video URL parsing fails
											<img src="@mainThumbnailUrl" alt="Thumbnail Preview" style="height: 18em; width: 32em; object-fit: contain;">
										}
									}
									else
									{
										// Fallback to image if no video URL found
										<img src="@mainThumbnailUrl" alt="Thumbnail Preview" style="height: 18em; width: 32em; object-fit: contain;">
									}
								}
								else
								{
									// Show regular image thumbnail
									<img src="@mainThumbnailUrl" alt="Thumbnail Preview" style="height: 18em; width: 32em; object-fit: contain;">
								}
							</div>
							<div class="thumbnail-gallery-bar">
								<div id="divSmallGalleryScrollContainer">
									@{
										// Show custom image thumbnails in gallery when:
										// - Image radio button is selected (regardless of auto-generated state)
										// - Video radio button is selected (show custom images alongside video)
										// Gallery should be hidden only when auto-generated is selected
										var shouldShowCustomGallery = placeThumbnails != null && placeThumbnails.Any(t => 
											t.GetType().GetProperty("type")?.GetValue(t)?.ToString() == "image");
									}
									@if (placeThumbnails != null && placeThumbnails.Count > 0)
									{
										int thumbnailIndex = 0;
										foreach (var thumbnail in placeThumbnails)
										{
											var thumbnailType = thumbnail.GetType().GetProperty("type")?.GetValue(thumbnail)?.ToString() ?? "";
											
											// Only show image thumbnails in gallery, skip videos
											if (thumbnailType != "image")
											{
												continue;
											}
											
											var thumbnailId = thumbnail.GetType().GetProperty("id")?.GetValue(thumbnail);
											var thumbnailAltText = thumbnail.GetType().GetProperty("altText")?.GetValue(thumbnail)?.ToString() ?? "";
											var thumbnailUrl = thumbnail.GetType().GetProperty("url")?.GetValue(thumbnail)?.ToString() ?? "";
											
											// Add cache-busting timestamp to prevent browser caching
											var cacheBuster = DateTime.Now.Ticks;
											var thumbnailUrlWithCache = thumbnailUrl.Contains("?") 
												? $"{thumbnailUrl}&_t={cacheBuster}" 
												: $"{thumbnailUrl}?_t={cacheBuster}";
											
											// Only add outline to first image if video is NOT selected as primary thumbnail
											// When video is primary, no image should have the outline
											var isFirstImage = thumbnailIndex == 0;
											var shouldShowOutline = isFirstImage && !hasVideoThumbnail;
											
											<div class="divSmallGalleryItem smallGalleryThumbItem @(shouldShowOutline ? "SelectedYouTubeGalleryIcon" : "")" 
												 data-thumbnailid="@thumbnailId"
												 data-place-media-item-id="@thumbnailId" 
												 data-place-media-item-alt-text="@thumbnailAltText"
												 data-place-media-item-url="@thumbnailUrl">
												<a data-remove-url="" data-thumbnailid="@thumbnailId" class="ImageButton closeBtnCircle_35h RemoveYouTubeGalleryImage"></a>
												<img src="@thumbnailUrlWithCache" alt="@thumbnailAltText" class="smallGalleryThumbImage" />
											</div>
											
											thumbnailIndex++;
										}
									}
								</div>
								<div class="thumbnail-gallery">
									<!-- Thumbnail gallery items will be added here -->
									</div>
								</div>
							</div>

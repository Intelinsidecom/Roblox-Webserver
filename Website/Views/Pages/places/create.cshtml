<script type="text/javascript">
    $(function () {
        $('#ActivePrivateServersSubscriptions').hide();
        $('#PrivateServerDetailsError').hide();
        $('#ActivePrivateServersCount').hide();

        if (typeof Roblox === "undefined") {
            Roblox = {};
        }
        if (typeof Roblox.Resources === "undefined") {
            Roblox.Resources = {};
        }
        if (typeof Roblox.Resources.GenericConfirmation === "undefined") {
            Roblox.Resources.GenericConfirmation = {};
        }
        $.extend(Roblox.Resources.GenericConfirmation, {
            yes: "Yes",
            No: "No"
        });
    });
</script>


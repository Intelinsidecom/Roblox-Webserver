<div class="messages message-detail section-content"><div class="sg-system-feedback message-confirm status-confirm"><div class=alert-system-feedback><div class="alert alert-success">{{sendMessage.sendResult.details}}</div></div><div class="alert-system-feedback message-confirm status-confirm"><div class="alert alert-warning" ng-bind-html=sendMessage.sendResult.details></div></div></div><div class=clearfix><div class="subject roblox-send-message-subject"><h3 id=rbx-message-detail-subject class=message-detail-subject>{{selectedMessage.Subject}}</h3><div class=sender><div class="roblox-avatar-image message-detail-image roblox-message-avatar" ng-class="{'avatar':selectedMessage.Sender.UserId!=messageDefaults.systemUserId,'avatar-headshot-sm':selectedMessage.Sender.UserId!=messageDefaults.systemUserId}"><a ng-if="currentStatus.activeTab!==tabs.sent.name" ng-href={{selectedMessage.SenderAbsoluteUrl}} rbx-avatar thumbnail="selectedMessage.Sender.UserId == messageDefaults.systemUserId ? messageDefaults.robloxSystemThumbnail : selectedMessage.SenderThumbnail" class=avatar-card-link ng-class="{'system-card-image':selectedMessage.Sender.UserId==messageDefaults.systemUserId}"></a> <a ng-if="currentStatus.activeTab===tabs.sent.name" ng-href={{selectedMessage.RecipientAbsoluteUrl}} rbx-avatar thumbnail=selectedMessage.RecipientThumbnail class=avatar-card-link></a></div></div><div class=roblox-send-message-content><p class=roblox-sender-link ng-if="currentStatus.activeTab!==tabs.sent.name"><a class=text-name ng-href={{selectedMessage.SenderAbsoluteUrl}}>{{selectedMessage.Sender.UserName|isEmpty:messageDefaults.robloxUserName:selectedMessage.Sender.UserName}}</a> <span class="date text-date-hint">{{selectedMessage.Created}}</span><p class=roblox-sender-link ng-if="currentStatus.activeTab===tabs.sent.name"><a class=text-name ng-href={{selectedMessage.RecipientAbsoluteUrl}}>{{selectedMessage.Recipient.UserName}}</a> <span class="date text-label xsmall">{{selectedMessage.Created}}</span></p><a ng-if="selectedMessage.IsReportAbuseDisplayed==true" ng-href={{selectedMessage.AbuseReportAbsoluteUrl}} class="abuse-button text-report roblox-abuse-btn roblox-abuse-btn abuse-report-modal">Report Abuse</a></div></div></div><div class="body clearfix"><div ng-bind-html=selectedMessage.Body></div></div><div class=message-reply ng-hide="sendMessage.disableReplyBtn==false||sendMessage.sendResult.hasError==false"><textarea rows=2 cols=20 class="messages-reply-box text-box" placeholder="Reply here..." ng-model=sendMessage.replyContent ng-disabled="sendMessage.disableSendBtn==true"></textarea><div class=message-reply-footer><div class=roblox-sendMessage-action><button class="roblox-sendMessage btn-primary-sm" ng-click=sendReply() ng-disabled="sendMessage.disableSendBtn==true||sendMessage.replyContent.length==0">Send Reply</button></div><div class=include-previous-message><div class="checkbox messageCheckbox"><input id=includePreviousMessage type=checkbox ng-checked=sendMessage.includePreviousMessage ng-model=sendMessage.includePreviousMessage> <label id=includePreviousMessage for=includePreviousMessage>Include Previous Message</label></div></div><div class="text-warning xsmall">Remember, ROBLOX staff will never ask you for your password. People who ask for your password are trying to steal your account.</div></div></div></div>
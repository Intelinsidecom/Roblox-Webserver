<div ng-switch=currentStatus.activeTab><div ng-switch-when=notifications class=notifications><div id=Notifications class="messages notifications-list"><div ng-show="notifications.TotalCollectionSize==0" class=section-content-off>You have no news.</div><div class="message-news sub-divider-bottom messageDivider" ng-repeat="notification in notifications.Collection" ng-click="showBody=!showBody" ng-class="{'opened':showBody}"><div class=clearfix><div class="roblox-avatar-image" ng-class="{'roblox-system-image':notification.IsSystemMessage,'avatar':!notification.IsSystemMessage,'avatar-headshot-sm':!notification.IsSystemMessage}"><a rbx-avatar thumbnail="notification.IsSystemMessage ? MESSAGEDEFAULTS.robloxSystemThumbnail : notification.SenderThumbnail" class=avatar-card-link></a></div><div class="roblox-message-title clearfix roblox-message-summary"><span class=roblox-message-subject><a ng-hide=showBody><span>{{notification.Sender.UserName}}</span></a> <a ng-show=showBody ng-click="showBody=false" ng-href={{notification.SenderAbsoluteUrl}}><span>{{notification.Sender.UserName}}</span></a> <br><div class=text-subject>{{notification.Subject}}</div></span> <span class="text-date-hint message-summary-date greyedout" style=float:right>{{notification.Created}}</span></div></div><div class="message-body news-body" ng-class="{'opened':showBody}" ng-hide=!showBody><span ng-bind-html=notification.Body><br></span></div></div></div></div><div ng-switch-default><div id=MessagesInbox class=messages><div ng-show="messages.TotalCollectionSize==0" class=section-content-off>You have no {{currentStatus.activeTab}} messages.</div><div class="sub-divider-bottom messageDivider read roblox-message-row" ng-class="{unread:message.IsRead==false&amp;&amp;currentStatus.activeTab!==tabs.sent.name}" ng-repeat="message in messages.Collection"><a class=messageRowAnchor></a><div class="checkbox messageCheckbox roblox-inboxCheckbox" ng-class="{robloxInvisibility:currentStatus.activeTab===tabs.sent.name}"><input type=checkbox id=inbox{{$index}} ng-checked=message.checked ng-model=message.checked class="inbox-check userCheckbox"> <label for=inbox{{$index}} id=userCheckbox ng-click=toggleSelection($index)></label></div><div class="roblox-avatar-image" ng-class="{'roblox-system-image':message.IsSystemMessage,'avatar':!message.IsSystemMessage,'avatar-headshot-sm':!message.IsSystemMessage}"><a ng-if="currentStatus.activeTab!==tabs.sent.name" ng-click="toggleMessagesBox('detail')" rbx-avatar thumbnail="message.IsSystemMessage ? MESSAGEDEFAULTS.robloxSystemThumbnail : message.SenderThumbnail | isEmpty:MESSAGEDEFAULTS.robloxUserThumbnail:message.Sender.UserId" class=avatar-card-link></a> <a ng-if="currentStatus.activeTab===tabs.sent.name" ng-href={{message.RecipientAbsoluteUrl}} rbx-avatar thumbnail=message.RecipientThumbnail class=avatar-card-link></a></div><div class="roblox-messageRow roblox-message-summary" ng-click="toggleMessagesBox('detail')"><div class="wrapped-text message-summary-body"><span class="message-summary-username positionAboveLink" ng-if="currentStatus.activeTab!==tabs.sent.name" ng-bind=message.Sender.UserName|isEmpty:MESSAGEDEFAULTS.robloxUserName:message.Sender.UserName></span> <span class="message-summary-username positionAboveLink" ng-if="currentStatus.activeTab===tabs.sent.name" ng-bind=message.Recipient.UserName></span><div class="text-overflow message-summary-content"><span class="text-subject subject" ng-bind=message.Subject>-</span> <span ng-bind-html=message.Body|htmlToPlaintext class=text-preview></span></div></div><span class="text-date-hint message-summary-date text-messageDate read" ng-bind=message.Created></span></div></div></div></div></div>
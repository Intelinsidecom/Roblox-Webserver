@{ Layout = "_Layout"; }
@{
    var userId = User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0";
    var userAgent = ViewContext.HttpContext.Request.Headers["User-Agent"].ToString() ?? "";
    bool containsRobloxAndroid = userAgent.Contains("ROBLOX Android App");
    bool containsIPhone = userAgent.Contains("iPhone");
    bool containsIPad = userAgent.Contains("iPad");
    bool containsIPod = userAgent.Contains("iPod");
    bool containsAndroid = userAgent.Contains("Android");
    bool containsRobloxiOS = userAgent.Contains("ROBLOX iOS App");
    bool containsRobloxUWP = userAgent.Contains("EdgeWebView") || userAgent.Contains("MSAppHost") || userAgent.Contains("Windows UWP") || userAgent.Contains("WOW64") || userAgent.Contains("Edge/");
    bool isMobile = containsIPhone || containsIPad || containsIPod || containsAndroid;
    bool isApp = containsRobloxAndroid || containsRobloxiOS || containsRobloxUWP;
}

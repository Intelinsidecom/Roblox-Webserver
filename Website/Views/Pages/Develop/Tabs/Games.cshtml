@model Assemblies.Common.DevelopTabViewModel
@{
    Layout = null;
    var items = Model?.Items ?? new List<Assemblies.Common.DevelopItem>();
    var fallbackThumb = "https://t7.rbxcdn.com/6bfa4d3e4d38a70d2f5b493987fe29c4";
}
@if (items.Count == 0)
{
    <div class="no-games-text">You have no games yet. Click 'Create New Game' to get started.</div>
}
else
{
    foreach (var item in items)
    {
        var startPlaceUrl = item.StartPlaceId > 0 && !string.IsNullOrEmpty(item.StartPlaceName)
            ? "/games/" + item.StartPlaceId + "/" + Assemblies.Common.DevelopSlugHelper.Slug(item.StartPlaceName)
            : "#";
        var privacyClass = item.IsPublic ? "place-active" : "place-inactive";
        <table class="item-table" data-item-id="@item.ItemId" data-rootplace-id="@item.RootPlaceId" data-type="@item.Type" data-configure-url="@item.ConfigureUrl" data-configure-localization-url="@item.ConfigureLocalizationUrl" data-create-badge-url="@item.CreateBadgeUrl" data-create-gamepass-url="@item.CreateGamepassUrl" data-developerstats-url="@item.DeveloperStatsUrl" data-advertise-url="@item.AdvertiseUrl" data-activate-universe-url="@item.ActivateUniverseUrl" data-deactivate-universe-url="@item.DeactivateUniverseUrl">
            <tr>
                <td class="image-col universe-image-col" style="text-align:center">
                    <a href="@item.ConfigureUrl" class="game-image">
                        <img src="@(item.ThumbnailUrl ?? fallbackThumb)" alt="@item.Name" />
                    </a>
                </td>
                <td class="universe-name-col">
                    <a class="title notranslate" href="@item.ConfigureUrl">@item.Name</a>
                    <table class="details-table">
                        <tr>
                            <td class="item-universe">
                                <span>Start Place:</span>
                                <a class="title notranslate start-place-url" href="@startPlaceUrl">@item.StartPlaceName</a>
                            </td>
                        </tr>
                        <tr class="activate-cell">
                            <td>
                                <a class="@privacyClass" href="@item.ConfigureUrl">@item.StatusText</a>
                            </td>
                        </tr>
                    </table>
                </td>
                <td class="edit-col">
                    <a class="roblox-edit-button btn-control btn-control-large" href="javascript:">Edit</a>
                </td>
                <td class="menu-col">
                    <div class="gear-button-wrapper">
                        <a href="#" class="gear-button"></a>
                    </div>
                </td>
            </tr>
        </table>
        <div class="separator"></div>
    }
}

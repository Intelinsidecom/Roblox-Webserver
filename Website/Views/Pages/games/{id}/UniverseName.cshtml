                            <div id=carousel-game-details class="carousel slide" data-ride=carousel data-is-video-autoplayed-on-ready=true data-is-mobile=false>
                                <div class=carousel-inner role=listbox>
                                    @{
                                        var videoUrl = ViewBag.VideoUrl as string;
                                        var placeThumbnails = ViewBag.PlaceThumbnails as List<object> ?? new List<object>();
                                        var itemIndex = 0;
                                        
                                        if (!string.IsNullOrEmpty(videoUrl))
                                        {
                                            var videoId = "";
                                            var embedUrl = "";
                                            
                                            if (Webserver.Common.YouTubeUtilities.IsYouTubeUrl(videoUrl))
                                            {
                                                videoId = Webserver.Common.YouTubeUtilities.ExtractVideoId(videoUrl);
                                                embedUrl = Webserver.Common.YouTubeUtilities.GetEmbedUrl(videoId);
                                            }
                                            
                                            <div class="item active">
                                                <div class="flex-video">
                                                    @if (!string.IsNullOrEmpty(embedUrl))
                                                    {
                                                        <iframe src="@embedUrl" frameborder="0" allowfullscreen class="carousel-video"></iframe>
                                                    }
                                                    else
                                                    {
                                                        <video controls class="carousel-video">
                                                            <source src="@videoUrl" type="video/mp4">
                                                            Your browser does not support the video tag.
                                                        </video>
                                                    }
                                                </div>
                                            </div>
                                            itemIndex++;
                                        }
                                        
                                        foreach (var thumbnail in placeThumbnails)
                                        {
                                            var thumbnailType = thumbnail.GetType().GetProperty("type")?.GetValue(thumbnail)?.ToString();
                                            var url = thumbnail.GetType().GetProperty("url")?.GetValue(thumbnail)?.ToString();
                                            
                                            if (thumbnailType == "image" && !string.IsNullOrWhiteSpace(url))
                                            {
                                                var isActive = itemIndex == 0 ? "active" : "";
                                                
                                                <div class="item @isActive">
                                                    <span>
                                                        <img class=carousel-thumb src="@url" alt="@ViewBag.Name screenshot @itemIndex">
                                                    </span>
                                                </div>
                                                itemIndex++;
                                            }
                                        }
                                        
                                        if (itemIndex == 0)
                                        {
                                            var autoGeneratedThumbnailUrl = ViewBag.AutoGeneratedThumbnailUrl as string;
                                            var fallbackUrl = !string.IsNullOrEmpty(autoGeneratedThumbnailUrl) ? autoGeneratedThumbnailUrl : "/images/DefaultPlaceIcon.png";
                                            
                                            <div class="item active">
                                                <span>
                                                    <img class=carousel-thumb src="@fallbackUrl" alt="@ViewBag.Name default thumbnail">
                                                </span>
                                            </div>
                                        }
                                    }
                                </div>
                                
                                @if (itemIndex > 1)

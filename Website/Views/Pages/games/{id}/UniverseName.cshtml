@{
    Layout = "_Layout";

    var userAgent = ViewContext.HttpContext.Request.Headers["User-Agent"].ToString() ?? "";
    bool containsAndroid = userAgent.Contains("Android");
    bool containsRobloxAndroid = userAgent.Contains("ROBLOX Android App");
    bool containsIPhone = userAgent.Contains("iPhone");
    bool containsIPad = userAgent.Contains("iPad");
    bool containsIPod = userAgent.Contains("iPod");
    bool containsRobloxiOS = userAgent.Contains("ROBLOX iOS App");
    bool containsRobloxUWP = userAgent.Contains("WOW64");

    bool isMobile = containsAndroid || containsIPhone || containsIPad || containsIPod || containsRobloxAndroid || containsRobloxiOS || containsRobloxUWP;

    ViewBag.ProtocolName = isMobile ? "robloxmobile" : "freblx-player";
    ViewBag.IsMobile = isMobile;
}

@using Assets
@functions {
    string FormatVisitCount(int count)
    {
        if (count >= 1000000000)
            return (count / 1000000000.0).ToString("0.##") + "B+";
        if (count >= 1000000)
            return (count / 1000000.0).ToString("0.##") + "M+";
        if (count >= 1000)
            return (count / 1000.0).ToString("0.##") + "K+";
        return count.ToString("N0");
    }
}

</div>
</script>

<script>
    var Roblox = Roblox || {};
    Roblox.Resources = Roblox.Resources || {};
    Roblox.Resources.GenericConfirmation = {
        yes: "Yes",
        No: "No",
        Confirm: "Confirm",
        Cancel: "Cancel"
    };
    
    Roblox.Resources.Dialog = {
        yes: "Yes",
        No: "No",
        OK: "OK",
        Confirm: "Confirm",
        Cancel: "Cancel",
        Agree: "Agree"
    };
    
    $(document).ready(function() {
        var keyword = @Html.Raw(Json.Serialize(keyword));
        var isLoading = false;
        var hasMoreResults = true;
        var currentStartRow = 0;
        var gamesPerPage = 40;
        
        if (!keyword) {
            $('.search-results-container').html('<div class="no-results">No search keyword provided</div>');
            return;
        }
        
        function loadMoreGames() {
            if (isLoading || !hasMoreResults) return;
            
            isLoading = true;
            $('.loading-spinner').show();
            
            $.ajax({
                url: '/games/advancedsearch',
                method: 'GET',
                data: {
                    keyword: keyword,
                    startRow: currentStartRow,
                    maxRows: gamesPerPage
                },
                success: function(data) {
                    $('.loading-spinner').hide();
                    isLoading = false;
                    
                    if (data.trim() === '<div class="hidden-item hidden" id=keyword></div>') {
                        hasMoreResults = false;
                        if (currentStartRow === 0) {
                            $('.search-results-container').html('<div class="no-results">No games found for "' + keyword + '"</div>');
                        }
                        return;
                    }
                    
                    if (currentStartRow === 0) {
                        $('.search-results-container').html('<ul class="hlist games game-cards game-cards-grid">' + data + '</ul>');
                    } else {
                        $('.search-results-container .game-cards').append(data);
                    }
                    
                    $('.game-card .vote-bar[data-voting-processed="false"]').each(function() {
                        var $voteBar = $(this);
                        var $voteContainer = $voteBar.find('.vote-container');
                        var upVotes = parseInt($voteContainer.data('upvotes')) || 0;
                        var downVotes = parseInt($voteContainer.data('downvotes')) || 0;
                        
                        if (typeof Roblox !== 'undefined' && Roblox.Voting && Roblox.Voting.UpdateVoteBar) {
                            Roblox.Voting.UpdateVoteBar(upVotes, downVotes, $voteBar.closest('.game-card-vote'));
                        }
                        $voteBar.attr('data-voting-processed', 'true');
                    });
                    
                    currentStartRow += gamesPerPage;
                    var gameCount = $(data).filter('.game-card').length;
                    if (gameCount < gamesPerPage) {
                        hasMoreResults = false;
                    }
                },
                error: function() {
                    $('.loading-spinner').hide();
                    isLoading = false;
                    if (currentStartRow === 0) {
                        $('.search-results-container').html('<div class="no-results">Error loading search results</div>');
                    }
                }
            });
        }
        
        loadMoreGames();
    
    
        $(window).scroll(function() {
            if ($(window).scrollTop() + $(window).height() >= $(document).height() - 100) {
                loadMoreGames();
            }
        });
    });
</script>

<div class="container">
    <div class="container-header">
        Showing results for <span class="font-bold">@keyword</span>
    </div>
    <div class="search-results-container">
        <div class="loading-spinner">Loading search results...</div>
    </div>
</div>




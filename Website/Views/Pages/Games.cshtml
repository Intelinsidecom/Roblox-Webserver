    <script>
        var requiredScripts = [
            'GamesPageContainerBehavior',
            'GamesListBehavior', 
            'GamesPageInteraction',
            'layoutLibraryProvider',
            'layoutLibraryService'
        ];
        
        requiredScripts.forEach(function(scriptName) {
            var isLoaded = false;
            if (scriptName.includes('layoutLibrary')) {
                isLoaded = typeof layoutLibrary !== 'undefined';
            } else if (typeof Roblox !== 'undefined' && Roblox[scriptName]) {
                isLoaded = true;
            }
        });
        
        function initializeGamesPage() {
            try {
                if (Roblox.GamesPage.state) {
                    if (typeof Roblox.GamesPage.state.isCreateNewAd === 'undefined') {
                        Roblox.GamesPage.state.isCreateNewAd = false;
                    }
                    if (typeof Roblox.GamesPage.state.adsRefreshInterval === 'undefined') {
                        Roblox.GamesPage.state.adsRefreshInterval = 3000;
                    }
                }
                
                if (typeof Roblox.GamesPageContainerBehavior !== 'undefined' && Roblox.GamesPageContainerBehavior.init) {
                    try {
                        Roblox.GamesPageContainerBehavior.init();
                    } catch (e) {
                        console.error('Error initializing GamesPageContainerBehavior:', e);
                    }
                }
                
                if (typeof Roblox.GamesListBehavior !== 'undefined' && Roblox.GamesListBehavior.init) {
                    try {
                        Roblox.GamesListBehavior.init();
                    } catch (e) {
                        console.error('Error initializing GamesListBehavior:', e);
                    }
                }
                
                if (typeof Roblox.GamesPage !== 'undefined') {
                    try {
                        if (typeof window.History === 'undefined') {
                            window.History = {
                                Adapter: {
                                    bind: function() { /* noop */ }
                                },
                                replaceState: function() { /* noop */ },
                                pushState: function() { /* noop */ }
                            };
                        }
                        
                        Roblox.GamesPage.init();
                    } catch (e) {
                        console.error('Stack trace:', e.stack);
                    }
                } else {
                    console.log('Roblox.GamesPage not available');
                }
                
                setTimeout(function() {
                    $('.games-list-container').each(function() {
                        var $container = $(this);
                        var containerId = $container.attr('id');
                        var $gameCards = $container.find('.game-card');
                        var hasGames = $gameCards.length > 0;
                    });
                }, 2000);
                
            $('#GamesListContainer1').removeClass('hidden');
                var dropdowns = $('.dropdown, .rbx-dropdown');
                
                if (typeof $.fn.dropdown !== 'undefined') {
                    $('.input-dropdown-btn[data-toggle="dropdown"]').dropdown();
                }
                
                
            } catch (error) {
                console.error('Error in initializeGamesPage:', error);
                console.error('Stack trace:', error.stack);
            }
        }
        
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeGamesPage);
        } else {
            initializeGamesPage();
        }
        
        if (typeof $ !== 'undefined') {
            $(document).ready(initializeGamesPage);
        }
    </script>


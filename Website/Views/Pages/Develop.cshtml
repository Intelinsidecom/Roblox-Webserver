@{ Layout = "_Layout"; }
@using Assemblies.Common
@inject Website.Services.DevelopTabService TabService
@{
    var viewParam = Context.Request.Query["view"].ToString();
    if (string.IsNullOrEmpty(viewParam))
    {
        viewParam = Context.Request.Query["View"].ToString();
    }

    var pageParam = Context.Request.Query["Page"].ToString();
    if (string.IsNullOrEmpty(pageParam))
    {
        pageParam = Context.Request.Query["page"].ToString();
    }

    if (string.IsNullOrEmpty(viewParam) && !string.IsNullOrEmpty(pageParam))
    {
        if (pageParam.Equals("universes", System.StringComparison.OrdinalIgnoreCase))
        {
            viewParam = string.Empty;
        }
    }

    if (string.IsNullOrEmpty(viewParam) && string.IsNullOrEmpty(pageParam))
    {
        viewParam = string.Empty;
    }

    var viewName = "Games";
    if (!string.IsNullOrEmpty(viewParam))
    {
        switch (viewParam)
        {
            case "9":
                viewName = "Places";
                break;
            case "10":
                viewName = "Models";
                break;
            case "13":
                viewName = "Decals";
                break;
            case "21":
                viewName = "Badges";
                break;
            case "3":
                viewName = "Audio";
                break;
            case "24":
                viewName = "Animations";
                break;
            case "4":
                viewName = "Meshes";
                break;
            case "2":
                viewName = "T-Shirts";
                break;
            case "11":
                viewName = "Shirts";
                break;
            case "12":
                viewName = "Pants";
                break;
            case "38":
                viewName = "Plugins";
                break;
            default:
                viewName = "Games";
                break;
        }
    }

    if (!User.Identity.IsAuthenticated)
    {
        Context.Response.Redirect("/");
        return;
    }

    var userIdStr = "0";
    var userName = "Guest";
    var idClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    if (!string.IsNullOrEmpty(idClaim))
    {
        userIdStr = idClaim;
    }

    var nameClaim = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
    if (!string.IsNullOrEmpty(nameClaim))
    {
        userName = nameClaim;
    }

    long.TryParse(userIdStr, out var userId);
    int assetTypeId = viewName switch
    {
        "Games" => 0,
        "Places" => 9,
        "Models" => 10,
        "Decals" => 13,
        "Badges" => 21,
        "Audio" => 3,
        "Animations" => 24,
        "Meshes" => 4,
        "T-Shirts" => 2,
        "Shirts" => 11,
        "Pants" => 12,
        "Plugins" => 38,
        _ => 0,
    };

    var tabModel = System.Threading.Tasks.Task.Run(() =>
        TabService.BuildAsync(userId, userName, viewName, groupId: null, cancellationToken: Context.RequestAborted)
    ).GetAwaiter().GetResult();
    if (tabModel.AssetTypeId == 0 && assetTypeId != 0)
    {
        tabModel.AssetTypeId = assetTypeId;
    }
}

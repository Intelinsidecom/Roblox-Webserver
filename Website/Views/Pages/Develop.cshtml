            var url = $(this).data('url') || '/develop/groups';
            window.location = url;
        });

        $('.active-only-checkbox input').on('change', function () {
            var isChecked = $(this).is(':checked');
            var container = $('#MyCreationsTab .items-container');
            var spinner = $('#MyCreationsTab .build-loading-container');
            var fetchUrl = $('#MyCreationsTab .creation-context-filters-and-sorts').data('fetchplaceurl');
            spinner.show();
            container.load(fetchUrl + '?showPublicOnly=' + isChecked, function () {
                spinner.hide();
            });
        });
    });
</script>



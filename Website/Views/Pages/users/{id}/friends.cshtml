    <div id=wrap class="wrap no-gutter-ads logged-in" data-gutter-ads-enabled=false>
        
        <script>
            var Roblox = Roblox || {};
            (function () {
                if (Roblox && Roblox.Performance) {
                    Roblox.Performance.setPerformanceMark("navigation_end");
                }
            })();
        </script>
        <div class=container-main>
            <script>
                if (top.location != self.location) {
                    top.location = self.location.href;
                }
            </script>
            
            <div class=content>
                <script src="https://www.google.com/recaptcha/api.js?render=explicit" async defer></script>
                <script>
                    Roblox.uiBootstrap = {};
                    Roblox.uiBootstrap = {
                        tooltipPopupTemplateLink: "/viewapp/common/template/tooltip/tooltip-popup.html",
                        tooltipHtmlUnsafePopupTemplateLink: "/viewapp/common/template/tooltip/tooltip-html-unsafe-popup.html"
                    };
                    Roblox.FriendsTemplates = {
                        CardMenuTemplateLink: "friend-card-menu"
                    }
                </script>
                <div id=state-properties data-userid=@ViewBag.ProfileUserId data-loggedinuserid=@ViewBag.CurrentUserId
                    data-removefriendurl=/api/friends/removefriend data-acceptfriendurl=/api/friends/acceptfriendrequest
                    data-declinefriendurl=/api/friends/declinefriendrequest
                    data-declineallfriendsurl=/api/friends/declineallfriendrequests data-followurl=/user/follow
                    data-unfollowurl=/api/user/unfollow data-unfriendurl=/api/friends/removefriend
                    data-username=@ViewBag.ProfileUserName></div>
                <div class="row page-content" ng-modules="robloxApp, ui.bootstrap, friends, robloxApp.helpers" ng-cloak
                    ng-controller=friendsController>
                    <div ng-include="'system-feedback'"></div>
                    <h1 ng-show=currentData.isMyProfile class=friends-title>My Friends</h1>
                    <h1 ng-hide=currentData.isMyProfile class=friends-title>{{ currentData.userName }}'s Friends</h1>
                    <div class=rbx-tabs-horizontal>
                        <ul id=horizontal-tabs class="nav nav-tabs" role=tablist>
                            <li id=friends class=rbx-tab
                                ng-class="{'active': currentData.activeTab == 'friends', 'subtract-item': !currentData.isMyProfile}"
                                ui-sref=friends><a class=rbx-tab-heading> <span class=text-lead>Friends</span> </a>
                            <li id=following class=rbx-tab
                                ng-class="{'active': currentData.activeTab == 'following', 'subtract-item': !currentData.isMyProfile}"
                                ui-sref=following><a class=rbx-tab-heading> <span class=text-lead>Following</span> </a>
                            <li id=followers class=rbx-tab
                                ng-class="{'active': currentData.activeTab == 'followers', 'subtract-item': !currentData.isMyProfile}"
                                ui-sref=followers><a class=rbx-tab-heading> <span class=text-lead>Followers</span> </a>
                            <li id=requests class=rbx-tab ng-show=currentData.isMyProfile
                                ng-class="{'active': currentData.activeTab == 'friend-requests', 'subtract-item': !currentData.isMyProfile}"
                                ui-sref=friend-requests><a class=rbx-tab-heading> <span class=text-lead>Requests</span>
                                </a>
                        </ul>
                        <div class=friends-content ng-class="{'hide-template': !currentData.templateVisible}">
                            <h3 class=friends-subtitle>{{ currentData.stateLabel }} ({{
                                friendsContent.friends.data.TotalFriends | number }})</h3><button
                                ng-show="currentData.activeTab == 'friend-requests' &amp;&amp; friendsContent.friends.data.TotalFriends > 0"
                                type=button class="btn-fixed-width btn-control-xs ignore-button"
                                ng-click=declineAllFriendRequests() ng-disabled=disabled>Ignore All</button> <span
                                class=tooltip-container data-toggle=tooltip data-toggle-mobile=true
                                title="{{ currentData.tooltipLabel }}"> <span class=icon-moreinfo></span> </span>
                            <div class="tab-content rbx-tab-content" ui-view>
                                <ul class="hlist avatar-cards">
                                    <li ng-repeat="friend in friendsContent.friends.data.Friends"
                                        class="list-item avatar-card friends-container"
                                        ng-show="friend.UserId &amp;&amp; !currentData.ignoreAll &amp;&amp; friend.isAvailable">
                                        <div class=avatar-card-container ng-class="{'disabled': friend.IsDeleted}">
                                            <div class=avatar-card-content>
                                                <div class=avatar-card-fullbody><a ng-href={{friend.AbsoluteURL}}
                                                        class=avatar-card-link ng-if=!friend.IsDeleted> <img
                                                            ng-class="{'online': friend.isPresenceOnline, 'game': friend.isPresenceGame, 'studio': friend.isPresenceStudio}"
                                                            class=avatar-card-image ng-src="{{ friend.AvatarUri }}"
                                                            thumbnail=friend.Thumbnail image-retry> </a> <img
                                                        ng-if=friend.IsDeleted class=avatar-card-image
                                                        ng-src="{{ friend.AvatarUri }}" thumbnail=friend.Thumbnail
                                                        image-retry>
                                                    <div ng-hide="currentData.activeTab === 'followers' || currentData.activeTab === 'friend-requests'"
                                                        ng-if=!friend.IsDeleted><a ng-href="{{ friend.AbsoluteURL}}"
                                                            class=avatar-status> <span ng-show=friend.isPresenceOnline
                                                                class=icon-online
                                                                title={{friend.LastLocation}}></span></a> <a
                                                            ng-href="{{ friend.AbsolutePlaceURL }}"
                                                            class=avatar-status><span ng-show=friend.isPresenceGame
                                                                class=icon-game
                                                                title={{friend.LastLocation}}></span></a>
                                                        <div class=avatar-status><span ng-show=friend.isPresenceStudio
                                                                class=icon-studio title={{friend.LastLocation}}></span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class=avatar-card-caption>
                                                    <div id="{{ friend.UserId }}" class=text-overflow><a
                                                            ng-href={{friend.AbsoluteURL}} title={{friend.Username}}
                                                            ng-if=!friend.IsDeleted class=avatar-name>{{ friend.Username
                                                            }}</a> <span title={{friend.Username}}
                                                            ng-if=friend.IsDeleted class=avatar-name>{{ friend.Username
                                                            }}</span></div>
                                                    <div class=avatar-status-container ng-if=!friend.IsDeleted>
                                                        <div ng-if="!(friend.isPresenceGame || friend.isPresenceStudio)"
                                                            class=avatar-card-label ng-bind=friend.lastLocation></div>
                                                        <div ng-if="friend.isPresenceGame || friend.isPresenceStudio"><a
                                                                ng-if=friend.AbsolutePlaceURL
                                                                ng-href="{{ friend.AbsolutePlaceURL }}"
                                                                class="text-link text-overflow avatar-status-link"
                                                                ng-bind=friend.lastLocation> </a> <span
                                                                ng-if=!friend.AbsolutePlaceURL
                                                                ng-bind=friend.lastLocation
                                                                class=avatar-card-label></span></div>
                                                    </div>
                                                    <div ng-show="currentData.activeTab === 'following' &amp;&amp; !friend.IsFollowed"
                                                        class="avatar-card-label fail" ng-cloak>Unfollowed</div>
                                                </div>
                                                <div class=avatar-card-menu card-menu id={{friend.UserId}}
                                                    ng-if="hasMenu(currentData, friend)"></div>
                                            </div>
                                            <div class=avatar-card-btns ng-show=currentData.hasBtns><button type=button
                                                    class="btn-control-md ignore-friend"
                                                    ng-click="declineFriendRequest(friend.UserId, friend,currentData.currentPage)">Ignore</button>
                                                <button type=button class="btn-secondary-md accept-friend"
                                                    ng-click="acceptFriendRequest(friend.UserId, friend,currentData.currentPage)">Accept</button>
                                            </div>
                                        </div>
                                </ul>
                            </div>
                        </div>
                        <div class=pager-holder>
                            <ul class=pager ng-show="currentData.totalPages > 1">
                                <li class=pager-prev ng-class="{'disabled': disablePrevious()}"><a
                                        ng-click="disablePrevious() || newPage('prev')"><span
                                            class=icon-left></span></a>
                                <li class=pager-cur><span>{{(currentData.currentPage / currentData.totalPerPage) +
                                        1}}</span>
                                <li class=pager-total><span class=fixed-spacing>of</span> <span>{{currentData.totalPages
                                        | number }}</span>
                                <li class=pager-next ng-class="{'disabled': disableNext()}"><a
                                        ng-click="disableNext() || newPage('next')"><span class=icon-right></span></a>
                            </ul>
                        </div>
                    </div>
                    <div captcha captcha-model=captchaSetting captcha-type=captchaSetting.captchaType

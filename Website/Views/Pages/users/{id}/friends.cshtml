<body id=rbx-body data-performance-relative-value=0.005 data-internal-page-name=Friends data-send-event-percentage=0>
    <div id=roblox-linkify data-enabled=true
        data-regex="(https?\:\/\/)?(?:www\.)?([a-z0-9\-]{2,}\.)*(((m|de|www|web|api|blog|wiki|help|corp|polls|bloxcon|developer|devforum|forum)\.roblox\.com|robloxlabs\.com)|(www\.shoproblox\.com))((\/[A-Za-z0-9-+&amp;@@#\/%?=~_|!:,.;]*)|(\b|\s))"
        data-regex-flags=gm

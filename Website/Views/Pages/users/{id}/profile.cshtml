                                                @{
                                                    var wornAssets = ViewBag.WornAssets as List<Dictionary<string, object?>> ?? new List<Dictionary<string, object?>>();
                                                    var perPage = 8;
                                                    var totalPages = (int)Math.Ceiling((double)wornAssets.Count / perPage);
                                                    var wearingHtml = new System.Text.StringBuilder();
                                                    for (var page = 0; page < totalPages; page++)
                                                    {
                                                        wearingHtml.Append("<ul class=accoutrement-items-container>");
                                                        for (var i = page * perPage; i < Math.Min((page + 1) * perPage, wornAssets.Count); i++)
                                                        {
                                                            var asset = wornAssets[i];
                                                            var aId = asset["assetId"];
                                                            var aName = System.Net.WebUtility.HtmlEncode(asset["name"]?.ToString() ?? "");
                                                            var aThumb = System.Net.WebUtility.HtmlEncode(asset["thumbnailUrl"]?.ToString() ?? "");
                                                            var aSlug = System.Text.RegularExpressions.Regex.Replace(aName.Trim(), @"[^a-zA-Z0-9\s-]", "").Replace(" ", "-");
                                                            wearingHtml.Append("<li class=accoutrement-item ng-non-bindable><a href=/catalog/" + aId + "/" + aSlug + "> <img title=\"" + aName + "\" alt=\"" + aName + "\" class=accoutrement-image src=\"" + aThumb + "\"> </a>");
                                                        }
                                                        wearingHtml.Append("</ul>");
                                                    }
                                                    var pageDotsHtml = new System.Text.StringBuilder();
                                                    for (var p = 0; p < Math.Max(totalPages, 1); p++)

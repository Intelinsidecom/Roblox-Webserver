@{
    Layout = "_Layout";
    var userIdStr = ViewBag.ProfileUserId as string ?? "0";
    var userName = ViewBag.ProfileUserName as string ?? "Guest";
    var userGames = ViewBag.UserGames as List<Games.UniverseListEntry> ?? new List<Games.UniverseListEntry>();
    if (userIdStr == "0")
    {
        var idClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(idClaim))
            userIdStr = idClaim;
    }
    if (userName == "Guest")
    {
        var nameClaim = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
        if (!string.IsNullOrEmpty(nameClaim))
            userName = nameClaim;
    }
}


        $(function () {
            $('#takeSnapshotButton').on('click', function (e) {
                e.preventDefault();
                try {
                    if (window.external && window.external.TakeThumbnail) {
                        var uploadUrl = '/ide/publish/newplace/thumbnail';
                        window.external.TakeThumbnail(uploadUrl);
                    } else {
                        alert('Taking Snapshot is only available in Roblox Studio');
                    }
                } catch (ex) {
                    console.error('Error calling TakeSnapshot:', ex);
                }
            });
        });

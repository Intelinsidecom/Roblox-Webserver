    <script type="text/javascript">
        $(function() {
            var loadGamesUrl = "/ide/gamelist?page=0", loadPlacesUrl = "/ide/placelist?startRow=0", gamesLoaded = !1, placesLoaded = !1;
            $("#GamesToggle").click(function() { if (!gamesLoaded) { gamesLoaded = !0; $.ajax({ url: loadGamesUrl, cache: !1, dataType: "html", success: function(html) { var list = $("#universeList"); list.find(".loading").remove(); list.append($(html)); $("[data-retry-url]").loadRobloxThumbnails() } }) } });
            $("#MyProjects").click(function() { if (!placesLoaded) { placesLoaded = !0; $.ajax({ url: loadPlacesUrl, cache: !1, dataType: "html", success: function(html) { var list = $("#assetList"); list.find(".loading").remove(); list.append($(html)); $(".place a").removeAttr("href"); $("[data-retry-url]").loadRobloxThumbnails() } }) } });
            $("#universeList").off("click", ".place").on("click", ".place", function() { Roblox.Client.isIDE() ? window.external.OpenUniverse($(this).data("universeid")) : Roblox.GenericModal.open("Edit Place", "/images/Icons/img-alert.png", "To edit this game, open to this page in ROBLOX Studio.") });
            $("#assetList").off("click", ".place").on("click", ".place", function() { Roblox.Client.isIDE() ? editTemplateInStudio($(this).data("placeid")) : Roblox.GenericModal.open("Edit Place", "/images/Icons/img-alert.png", "To edit this place, open to this page in ROBLOX Studio.") });

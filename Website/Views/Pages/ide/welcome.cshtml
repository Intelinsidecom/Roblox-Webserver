@{
    var filepaths = Context.Request.Query["filepath"];
    var filenames = Context.Request.Query["filename"];
    var files = new List<(string path, string name)>();
    var maxFiles = Math.Min(filepaths.Count, filenames.Count);
    for (int i = 0; i < maxFiles; i++)
    {
        var rawPath = filepaths[i] ?? "";
        var rawName = filenames[i] ?? "";
        files.Add((System.Net.WebUtility.UrlDecode(rawPath), System.Net.WebUtility.UrlDecode(rawName)));
    }
}
@if (files.Count > 0)
{
    <div id="StudioRecentFiles">Recent Files</div>
    <ul class="filelist">
        @foreach (var f in files)
        {
            <li><a data-js-file="@f.path">@f.name</a></li>
        }
    </ul>
}

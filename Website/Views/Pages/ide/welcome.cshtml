<body id="StudioWelcomeBody">
    <div class="header">
@if (User.Identity.IsAuthenticated)
{
    var rbxUserIdStr = User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0";
    long.TryParse(rbxUserIdStr, out long rbxUserId);
    string? rbxUserName = null;
    if (rbxUserId > 0)
    {
        var connStr = Configuration.GetConnectionString("Default");
        if (!string.IsNullOrWhiteSpace(connStr))
        {
            rbxUserName = Users.UserQueries.GetUserNameByIdAsync(connStr, rbxUserId).GetAwaiter().GetResult();
        }
    }
    rbxUserName ??= User?.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? User?.Identity?.Name ?? rbxUserIdStr;
            <div id="header-login-wrapper" class="iframe-login-signup">
                <span id="userName">
                    <p style="vertical-align:middle;position:static;top:auto">Logged in as @rbxUserName</p>
                    <a class="btn-control btn-control-large" href="/authentication/logout?returnUrl=/ide/welcome" style="vertical-align:middle; margin-top:-8px">Log Out</a>
                </span>
            </div>
}
else
{
            <div id="header-login-wrapper" class="iframe-login-signup" data-display-opened="">
                <a href="/" target="_blank" class="btn-control btn-control-large translate" id="studio-header-signup"><span>Sign Up</span></a>
                <span id="header-or">or</span>
                <span class="studioiFrameLogin">

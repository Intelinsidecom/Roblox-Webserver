@using System.Security.Claims
@using Npgsql
@using Games
@{
    Layout = "_Layout";
    ViewBag.IncludeSharedCss = true;
    ViewBag.IncludeSharedJs = true;

    if (!User.Identity.IsAuthenticated)
    {
        Context.Response.Redirect("/");
        return;
    }

    var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0";

    long parsedUserId;
    long.TryParse(userId, out parsedUserId);

    string userName = "User";
    string userStatusText = "";
    var feedEntries = new List<Users.FeedEntry>();
    var friendsList = new List<Dictionary<string, object?>>();
    int friendCount = 0;
    var featuredGameIds = new List<long>();
    var featuredGameEntries = new List<GamesQueries.GameEntry>();
    var friendActivityGames = new List<long>();
    var friendActivityGameEntries = new List<GamesQueries.GameEntry>();
    var friendActivityLiveCounts = new Dictionary<long, int>();
    if (parsedUserId > 0)
    {
        var connStr = Configuration.GetConnectionString("Default");
        if (!string.IsNullOrWhiteSpace(connStr))
        {
            try
            {
                userName = Users.UserQueries.GetUserNameByIdAsync(connStr, parsedUserId).GetAwaiter().GetResult() ?? userName;
                userStatusText = Users.UserQueries.GetUserStatusTextAsync(connStr, parsedUserId).GetAwaiter().GetResult() ?? "";
                feedEntries = Users.UserQueries.GetFeedEntriesForUserAsync(connStr, parsedUserId, 20).GetAwaiter().GetResult();
                friendsList = Users.UserQueries.GetFriendListAsync(connStr, parsedUserId, parsedUserId, 0, 10, "AllFriends").GetAwaiter().GetResult();
                friendCount = friendsList.Count;
                friendActivityGames = GamesQueries.GetFriendActivityUniverseIdsAsync(parsedUserId, connStr, 10).GetAwaiter().GetResult();
                if (friendActivityGames.Count > 0)
                {
                    var arbiterUrl = Configuration["ArbiterUrl"] ?? "http://localhost:5000";
                    friendActivityGameEntries = GamesQueries.GetGameEntriesByUniverseIdsAsync(friendActivityGames, connStr).GetAwaiter().GetResult();
                    var ids = friendActivityGameEntries.Select(g => g.UniverseId).Distinct().ToList();
                    friendActivityLiveCounts = GamesQueries.GetLivePlayerCountsForUniverseIdsAsync(ids, connStr, arbiterUrl).GetAwaiter().GetResult();
                }
                featuredGameIds = GamesQueries.GetFeaturedGameUniverseIdsAsync(connStr).GetAwaiter().GetResult();
                if (featuredGameIds.Count == 0)
                {
                    var fallbackIds = Configuration.GetSection("FeaturedGames:UniverseIds").Get<long[]>();
                    if (fallbackIds != null)
                        featuredGameIds = fallbackIds.Take(4).ToList();
                }
                if (featuredGameIds.Count > 0)
                {
                    featuredGameEntries = GamesQueries.GetGameEntriesByUniverseIdsAsync(featuredGameIds, connStr).GetAwaiter().GetResult();
                }
            }
            catch { }
        }
    }

    if (string.IsNullOrEmpty(userName) || userName == "User")
    {
        userName = User.FindFirst("RobloxUsername")?.Value ?? User.FindFirst(ClaimTypes.Name)?.Value ?? User.Identity?.Name ?? "User";
    }
}

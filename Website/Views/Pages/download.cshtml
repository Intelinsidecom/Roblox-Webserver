<script type="text/javascript">
    $(function() {
        var downloadButton = $('.download-now');
        var studiodownloadButton = $('.download-studio');
        var download = $('#download-body');
        var thanks = $('#thanks-body');
        var uwpThanks = $('#uwp-thanks-body');
        var studioThanks = $('#studio-thanks-body');

        downloadButton.bind('click', function() {
            if (confirm("Which Windows Client Do you want to download? Press OK for regular one press Cancel for UWP one")) {
                diduserdownloaduwp = false;
            } else {
                diduserdownloaduwp = true;
            }
            
            download.hide();
            if (diduserdownloaduwp === false) {
                thanks.show();
                window.location.href = "/install/setup.ashx";
            }
            if (diduserdownloaduwp === true) {
                uwpThanks.show();
                window.location.href = "@Configuration["Setup:UWPClientDownloadLocation"]";
            }
        });

        studiodownloadButton.bind('click', function() {
            
            download.hide();
            studioThanks.show();
        });
   });  


</script>   


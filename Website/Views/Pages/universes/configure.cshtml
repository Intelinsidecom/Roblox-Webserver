                            <script type="text/javascript">

                                
                                var _devProductsInitialized = false;
                                function initializeDeveloperProducts() {
                                    if (_devProductsInitialized) return;
                                    _devProductsInitialized = true;
                                    var devProductsElement = $('#DevProducts');
                                    if (devProductsElement.length > 0) {
                                        if (typeof Roblox.DeveloperProductsListing !== 'undefined' && typeof Roblox.DeveloperProductsListing.init === 'function') {
                                            Roblox.DeveloperProductsListing.init();
                                        } else {
                                            console.error('Developer Products: Roblox.DeveloperProductsListing.init not found');
                                        }

                                        if (typeof Roblox.DeveloperProductsListing.loadContent === 'function') {
                                            Roblox.DeveloperProductsListing.loadContent();
                                        } else {
                                            console.error('Developer Products: Roblox.DeveloperProductsListing.loadContent not found');
                                        }
                                        if (typeof Roblox.DeveloperProductsForm !== 'undefined' && typeof Roblox.DeveloperProductsForm.init === 'function') {
                                            Roblox.DeveloperProductsForm.init();
                                        }
                                    } else {
                                        console.error('Developer Products: #DevProducts container not found');
                                    }
                                }

                                $(document).ready(function() {
                                    var devProductsTab = $('#developerProducts');
                                    if (devProductsTab.css('display') !== 'none') {
                                        initializeDeveloperProducts();
                                    }

                                    var observer = new MutationObserver(function(mutations) {
                                        mutations.forEach(function(mutation) {
                                            if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
                                                var target = $(mutation.target);
                                                if (target.attr('id') === 'developerProducts') {
                                                    if (target.css('display') !== 'none') {
                                                        initializeDeveloperProducts();
                                                    } else {
                                                        _devProductsInitialized = false;
                                                    }
                                                }
                                            }
                                        });
                                    });
                                    
                                    var devProductsElement = document.getElementById('developerProducts');
                                    if (devProductsElement) {
                                        observer.observe(devProductsElement, {
                                            attributes: true,
                                            attributeFilter: ['style']
                                        });
                                    }

                                    if (!_devProductsInitialized) {
                                        setTimeout(function() {
                                            if ($('#developerProducts').css('display') !== 'none') {
                                                initializeDeveloperProducts();
                                            }
                                        }, 0);
                                    }
                                });

                            </script>
                            <div style="clear: both"></div>
                        </div>

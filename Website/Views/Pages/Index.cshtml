<div class="navbar navbar-landing navbar-fixed-top" role="navigation" style="background-color: rgba(0, 0, 0, 0.35);">
    <div class="container">
        <div class="row">
            <div class="navbar-header col-md-6">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#LandingNavbar">
                    Log In
                </button>
                <div class="navbar-brand hidden-xs"><img alt="Logo" class="freebloxiaLogo" src="~/images/FreebloxiaLogo.png"></div>
                <ul id="TopLeftNavLinks" class="nav navbar-nav">
                    <li id="PlayLink" class="pull-left"><a href="#RollerContainer" onclick="return scrollTo(1, &#39;#RollerContainer&#39;);">Play</a></li>
                    <li id="AboutLink" class="pull-left"><a href="#WhatsFreebloxiaContainer" onclick="return scrollTo(2, &#39;#WhatsFreebloxiaContainer&#39;);">About</a></li>
                    <li id="PlatformLink" class="pull-left"><a href="#FreebloxiaDeviceText" onclick="return scrollTo(3, &#39;#FreebloxiaDeviceText&#39;);">Platforms</a></li>
                    <li id="magic-line" style="left: 41px; width: 61px;"></li>
                </ul>
            </div>


            <div class="collapse navbar-collapse col-sm-6 ng-scope" id="LandingNavbar" ng-modules="freebloxia.formEvents">
                <form name="loginForm" action="/login" id="LogInForm" class="navbar-form form-inline navbar-right ng-pristine ng-valid" method="post" role="form" fbx-form-context="" context="RollerCoaster" novalidate="">
                    <div class="form-group" id="LoginUsernameParent">
                        <input id="LoginUsername" type="text" placeholder="Username" class="form-control" name="username" fbx-form-interaction="">
                    </div>
                    <div class="form-group" id="LoginPasswordParent">
                        <input id="LoginPassword" type="password" placeholder="Password" class="form-control" name="password" fbx-form-interaction="">
                    </div>
                    <div class="form-group">
                        <input type="submit" id="LoginButton" class="form-control" value="Log In" fbx-form-interaction="" name="submitLogin">
                    </div>
                    <a id="HeaderForgotPassword" class="navbar-link" href="/Login/ResetPasswordRequest.aspx">Forgot Username/Password?</a>
                    <input id="ReturnUrl" name="ReturnUrl" type="hidden" value="">
                </form>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <section class="row full-height-section" id="RollerContainer">
        <div class="col-md-12 inner-full-height-section" id="InnerRollerContainer">
            <div id="MainCenterContainer" class="row">
                <div class="col-xs-12 col-md-6">
                    <div id="MainLogo" class="text-right">
                        <div id="LogoAndSlogan" class="text-center">
                            <img id="MainLogoImage" title="Freebloxia" class="center-block img-responsive" src="~/images/FreebloxiaWideLogo.png">
                            <div class="clearfix"></div>
                            <h1>Powering Clients<span> ™ </span></h1>
                        </div>
                    </div>
                </div>



                <!-- Modal -->
                <div id="BootstrapConfirmationModal" data-modal-handle="bootstrap-confirmation" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" id="Freebloxia-close-btn" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
                                <h4 class="modal-title">Modal title</h4>
                            </div>
                            <div class="modal-body">
                                <div class="ImageContainer Freebloxia-item-image" data-image-size="small" data-no-overlays="" data-no-click="">
                                    <img class="GenericModalImage" alt="generic image">
                                </div>
                                <p class="modal-body-text"></p>
                                <p id="Freebloxia-captcha-error" class="text-center text-danger"></p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" id="Freebloxia-decline-btn" class="btn btn-default" data-dismiss="modal">Close</button>
                                <button type="button" id="Freebloxia-confirm-btn" class="btn btn-primary">Save changes</button>
                            </div>
                        </div><!-- /.modal-content -->
                    </div><!-- /.modal-dialog -->
                </div>


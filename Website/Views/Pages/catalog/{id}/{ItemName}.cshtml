@model RobloxWebserver.Controllers.CatalogController.CatalogItemViewModel
@{ Layout = "_Layout"; }

@section Head {
    <link rel="stylesheet" href="~/CSS/Pages/Item/ItemPage.css">
    <link rel="stylesheet" href="~/CSS/Base/CSS/LoadingSpinner.css"> 
    <link rel="stylesheet" href="~/CSS/Pages/Shared/ItemThumbnail.css">
    <link rel="stylesheet" href="~/CSS/Pages/Recommendations/Recommendations.css">
    <link rel="stylesheet" href="~/CSS/Base/CSS/jquery.mCustomScrollbar.css">
    <link rel="stylesheet" href="~/CSS/Base/CSS/Modals.css">
    <link rel="stylesheet" href="~/CSS/Base/CSS/PlaceLauncher.css">
    <link rel="stylesheet" href="~/CSS/Base/CSS/RevisedCharacterSelectModal.css">
    <link rel="stylesheet" href="~/CSS/Pages/Login/SignupOrLogInModal.css">
    <link rel="stylesheet" href="~/CSS/Base/CSS/VideoPreRoll.css">
    <link rel="stylesheet" href="~/CSS/Base/CSS/Abp.css">
    <link rel="stylesheet" href="~/CSS/2017/SiteStyle.css">
    <link rel="stylesheet" href="~/CSS/2017/LeanBaseStyle.css">
    <link rel="stylesheet" href="~/CSS/Pages/Shared/AssetStatusIcon.css">
    <link rel="stylesheet" href="~/CSS/2017/Base/CSS/StyleGuide.css">
    @if (Model.AssetTypeId == 3)
    {
        <style>
            .item-thumbnail-container { position: relative; }
            .MediaPlayerControls {
                position: absolute;
                bottom: 4px;
                right: 4px;
                cursor: pointer;
                z-index: 2;
            }
            .MediaPlayerIcon.icon-play,
            .MediaPlayerIcon.icon-pause {
                background-image: url(/images/Shared/generic_09152017.svg);
                background-repeat: no-repeat;
                background-size: auto auto;
                width: 28px;
                height: 28px;
                display: inline-block;
                vertical-align: middle;
            }
            .MediaPlayerIcon.icon-play {
                background-position: 0 -308px;
            }
            .MediaPlayerIcon.icon-pause {
                background-position: 0 -336px;
            }
        </style>
    }

    <meta name=viewport content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
    <script>
        var Roblox = Roblox || {};
        Roblox.RealTimeSettings = Roblox.RealTimeSettings || {
            NotificationsEndpoint: "https://realtime.roblox.com/",
            NotificationsTestInterval: "5000",
            MaxConnectionTime: "43200000",
            IsStateTrackingEnabled: true,
            IsEventPublishingEnabled: false,
            IsDisconnectOnSlowConnectionDisabled: true,
            IsSignalRClientTransportRestrictionEnabled: true,
            IsLocalStorageInRealTimeEnabled: true,
            UserId: "404463238"
        }
    </script>
    <script>
        var Roblox = Roblox || {};
        Roblox.WebApps = Roblox.WebApps || {};
        Roblox.WebApps.Domains = {
            chat: "https://chatsite.roblox.com"
        }
    </script>
}

<div id=rbx-body data-performance-relative-value=0.005 data-internal-page-name=CatalogItem data-send-event-percentage=0.01>

    <div id=roblox-linkify data-enabled=true data-regex="(https?:\/\/)?(?:www\.)?([a-z0-9\-]{2,}\.)*(((m|de|www|web|api|blog|wiki|help|corp|polls|bloxcon|developer|devforum|forum)\.roblox\.com|robloxlabs\.com)|(www\.shoproblox\.com))((\/[A-Za-z0-9-+&amp;\&#64;#\/%%?=~_|!:,.;]*)|(\b|\s))" data-regex-flags=gm data-as-http-regex=((wiki|[^.]help|corp|polls|bloxcon|developer|devforum)\.robloxlabs\.com)></div>

    <div id=image-retry-data data-image-retry-max-times=10 data-image-retry-timer=1500 data-ga-logging-percent=10></div>
    <div id=http-retry-data data-http-retry-max-timeout=0 data-http-retry-base-timeout=0 data-http-retry-max-times=5></div>
    <div id=TosAgreementInfo data-terms-check-needed=False></div>
    <div id=fb-root></div>
            <div class="content item-page-main">
                <div id=item-container class=page-content data-item-id="@Model.Id" data-item-name="@Model.Name" data-asset-type="@Model.AssetTypeLabel" data-userasset-id="" data-is-purchase-enabled=true data-product-id="@Model.Id" data-bc-requirement=0 data-expected-currency="1" data-expected-price="@(Model.PriceRobux ?? 0)" data-seller-name="@Model.CreatorName" data-expected-seller-id="@Model.CreatorId" data-lowest-private-sale-userasset-id="" data-is-limited-unique="@Model.IsLimitedUnique" data-user-id="@User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" data-asset-granted=False data-forward-url="" data-avatar-wear-url="/v1/avatar/assets/@Model.Id/wear" data-avatar-remove-url="/v1/avatar/assets/@Model.Id/remove" data-current-time="@DateTime.UtcNow">
                    <div class=system-feedback>
                        <div class=alert-system-feedback>
                            <div class="alert alert-success">Purchase Completed</div>
                        </div>
                        <div class=alert-system-feedback>
                            <div class="alert alert-warning">Error occurred</div>
                        </div>
                    </div>
                    <div class="section-content top-section">
                        <div class=item-name-container>
                            <h2>@Model.Name</h2>
                            <div>
                                <span class=text-label>By <a href="/users/@Model.CreatorId/profile" class=text-name>@Model.CreatorName</a></span>
                                @if (Model.IsOwned)
                                {
                                    <div class=divider>&nbsp;</div>
                                    <div class=label-checkmark><span class=icon-checkmark-white-bold></span></div><span>Item Owned</span>
                                }
                            </div>
                        </div>
                        <div class=item-thumbnail-container>
                            <div id=AssetThumbnail class="thumbnail-holder thumbnail-Large three-dee-static" data-reset-enabled-every-page@(AssetTypeNames.Is3DSupported(Model.AssetTypeId) ? " data-3d-thumbs-enabled" : "") three-dee-static data-3dtype=static data-url="/thumbnail/asset?assetId=@Model.Id&amp;thumbnailFormatId=254&amp;width=420&amp;height=420"><span class=thumbnail-span data-3d-url="/asset-thumbnail-3d/json?assetId=@Model.Id"><img src="@Model.ImageUrl"></span>

                                <div class=equipped-marker></div>@if (AssetTypeNames.Is3DSupported(Model.AssetTypeId)) {<span class="enable-three-dee three-dee-static-icon"></span>}
                                @if (Model.IsLimitedUnique)
                                {
                                    <div class=asset-restriction-icon><span class=rbx-tooltip data-toggle=tooltip data-original-title="Serialized limited release, resellable."><span class="icon-label icon-limited-unique-label"></span></span></div>
                                }
                                else if (Model.IsLimited)
                                {
                                    <div class=asset-restriction-icon><span class=rbx-tooltip data-toggle=tooltip data-original-title="Limited release, resellable."><span class="icon-label icon-limited-label"></span></span></div>
                                }
                            </div>
                            @if (Model.AssetTypeId == 3)
                            {
                                <div class="MediaPlayerControls">
                                    <div class="MediaPlayerIcon icon-play" data-mediathumb-url="/asset/?id=@Model.Id" data-jplayer-version="2.9.2"></div>
                                </div>
                            }
                            <script>
                                (function() {
                                    if (Roblox && Roblox.Performance) {
                                        Roblox.Performance.setPerformanceMark("itemReskin_thumbnail_loaded");
                                    }
                                })();
                            </script>
                        </div>
                        <div id=item-details class="content-overflow-toggle content-height content-overflow-page-loading item-details">
                            <div class="clearfix price-container">
                                <div class=price-container-text>
                                    @if (Model.IsOwned)
                                    {
                                        <div class=item-first-line>This item is available in your inventory.</div>
                                    }
                                    @if (Model.IsLimited && Model.OwnedSerialNumber.HasValue)
                                    {
                                        <div class=item-first-line>Serial Number #@Model.OwnedSerialNumber.Value</div>
                                    }
                                    @if (Model.IsOnSale && (!Model.IsLimited || Model.BestResalePrice > 0 || Model.PriceRobux > 0))
                                    {
                                    <div class="text-label field-label price-label">@(Model.IsLimited ? "Best Price" : "Price")</div>
                                    <div class=price-info>
                                        <div class="icon-text-wrapper clearfix icon-robux-price-container">
                                            <span class=icon-robux></span>
                                            <span class=text-robux-lg>
                                                @if (Model.PriceRobux.HasValue && Model.PriceRobux.Value > 0)
                                                {
                                                    @Model.PriceRobux.Value.ToString("N0")
                                                }
                                                else
                                                {
                                                    @:Free
                                                }
                                            </span>
                                        </div>
                                    </div>
                                    }
                                    else if (!Model.IsOwned)
                                    {
                                    <div class="field-content">This item is not currently for sale.</div>
                                    }

                                </div>
                                <div class=action-button>
                                    @if (Model.IsOwned && Model.AssetTypeLabel == "Plugin")
                                    {
                                        <div data-install-url="/plugins/@Model.Id/install" data-expected-currency="1" data-asset-type="Plugin" data-item-version-id="@Model.ItemVersionId" class="InstallButton btn-fixed-width-lg btn-primary-lg btn-disabled-primary" data-item-name="@Model.Name" data-item-id="@Model.Id" data-expected-price="0" data-expected-seller-id="@Model.CreatorId" data-bc-requirement="0" data-seller-name="@Model.CreatorName" data-authenticateduser-isnull="@(User?.Identity?.IsAuthenticated != true ? "True" : "False")" original-title="To install this plugin, open this page in Roblox Studio." href="javascript: return false;">
                                            Install
                                            <span class="btn-text">Install</span>
                                        </div>
                                    }
                                    else if (Model.IsOwned && AssetTypeNames.IsWearableAssetType(Model.AssetTypeId))
                                    {
                                        <a id=edit-avatar-button href="/my/character" class="btn-fixed-width-lg btn-control-md" data-button-action=avatar> Edit Avatar </a>
                                    }
                                    else if (Model.IsOwned && Model.IsLimited)
                                    {
                                        <button type=button class="btn-fixed-width-lg btn-primary-lg sell-button" id=sell-button data-asset-id="@Model.Id"> Sell </button>
                                    }
                                    else if (Model.IsOnSale && !Model.IsOwned && (!Model.IsLimited || Model.BestResalePrice > 0 || Model.PriceRobux > 0))
                                    {
                                        <button type=button class="btn-fixed-width-lg btn-primary-lg PurchaseButton" data-button-type=main data-button-action=buy data-se=item-buyforrobux data-item-name="@Model.Name" data-seller-name="@Model.CreatorName" data-item-id="@Model.Id" data-product-id="@Model.Id" data-expected-price="@(Model.PriceRobux ?? 0)" data-expected-currency="1" data-asset-type="Package" data-expected-seller-id="@Model.CreatorId" data-is-limited-unique="@Model.IsLimitedUnique" data-lowest-private-sale-userasset-id=""> Buy </button>
                                    }
                                    else if (!Model.IsOwned)
                                    {
                                        <button type=button class="btn-fixed-width-lg btn-primary-lg PurchaseButton" disabled style="opacity:0.5;cursor:not-allowed"> Buy </button>
                                    }
                                </div>
                                @if (Model.IsLimited)
                                {
                                    <div class="item-note has-price-label">See more <a id=resellersLink class="text-link" href="#resellers">Resellers</a></div>
                                }
                            </div>
                            <div class="clearfix item-mobile-description item-field-container">
                                <pre class=description-content>@Model.Description</pre>

                            </div>
                            <div class="clearfix item-type-field-container">
                                <div class="text-label field-label">Type</div><span class=field-content>@Model.AssetTypeLabel</span>

                            </div>
                            <div class="clearfix item-field-container">
                                <div class="text-label field-label">Genres</div>
                                <div class=field-content><span class="text-name item-genre">@Model.GenreLabel</span></div>

                            </div>
                            <div class="clearfix toggle-target item-field-container">
                                <div class="text-label field-label">Description</div>
                                <pre id=item-details-description class="content-overflow-toggle content-height content-overflow-page-loading field-content description-content">@Model.Description<span class="hidden toggle-content" data-container-id=item-details-description>Read More</span></pre>

                            </div>
                            <div class="hide show-more-end" data-container-id=item-details></div><button type=button class="hidden btn-full-width btn-control-md toggle-content" data-container-id=item-details>Read More</button>
                        </div>
                        <ul class="item-social-container clearfix include-favorite">
                            <li class=favorite-button-container>
                                <div class=tooltip-container data-toggle=tooltip data-original-title="Add to Favorites"><a id=toggle-favorite data-toggle-url=/favorite/toggle data-assetid=@Model.Id data-isguest=False data-signin-url="https://web.roblox.com/newlogin?returnUrl=%2Fcatalog%2F@Model.Id%2F@Model.Name"> <span class=text-favorite favoriteCount" id=result>@((Model.FavoritedCount ?? 0).ToString("N0"))</span>
                                        <div id=favorite-icon class="icon-favorite@(Model.IsFavorited ? " favorited" : string.Empty)"></div>
                                    </a></div>
                            </li>
                            @if (User?.Identity?.IsAuthenticated == true)
                            {
                                var userIdClaim = User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                                long currentUserId;
                                long.TryParse(userIdClaim, out currentUserId);
                                var isOwner = currentUserId > 0 && Model.CreatorId == currentUserId;

                                if (isOwner || Model.IsOwned)
                                {
                                    <li id=item-context-menu class=item-context-menu>
                                        <a class="rbx-menu-item item-context-menu" data-toggle=popover data-bind=popover-content> <span class=icon-more></span> </a>
                                        <div class="rbx-popover-content popover-content" data-toggle=popover-content>
                                            <ul class=dropdown-menu role=menu>
                                                @if (AssetTypeNames.IsWearableAssetType(Model.AssetTypeId))
                                                {
                                                <li><a class=toggle-wear data-toggle="@(Model.IsWorn ? "True" : "False")"> @(Model.IsWorn ? "Unwear" : "Wear") </a></li>
                                                }

                                                @if (AssetTypeNames.IsWearableAssetType(Model.AssetTypeId) && Model.IsOwned && Model.IsLimited)
                                                {
                                                <li><a id=sell data-asset-id="@Model.Id"> Sell </a></li>
                                                }

                                                @if (Model.IsOwned && !isOwner)
                                                {
                                                    <li><a id=delete-item> Delete </a></li>
                                                }

                                                @if (isOwner)
                                                {
                                                    <li><a id=configure-item href="/my/item.aspx?id=@Model.Id"> Configure </a></li>
                                                }
                                                @if (Model.IsOwned)
                                                {
                                                <li><a class=toggle-profile data-toggle=@(Model.IsOnProfile ? "True" : "False")> @(Model.IsOnProfile ? "Remove from Profile" : "Add to Profile") </a></li>
                                                }
                                            </ul>
                                        </div>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                    @if (Model.IsLimited)
                    {
                    <div class="rbx-tabs-horizontal resale-pricechart-tabs">
                        <ul id="horizontal-tabs" class="nav nav-tabs" role="tablist" style="display:none">
                            <li class="rbx-tab active">
                                <a class="rbx-tab-heading" href="#price-chart">
                                    <span class="text-lead">Price Chart</span>
                                </a>
                            </li>
                            <li class="rbx-tab">
                                <a class="rbx-tab-heading" href="#resellers">
                                    <span class="text-lead">Resellers</span>
                                    <span class="rbx-tab-subtitle">(@Model.ResellerCount)</span>
                                </a>
                            </li>
                        </ul>
                        <div class="tab-content rbx-tab-content">
                            <div id="price-chart" class="tab-pane active price-chart-section">
                                <div class="section-content">
                                    <div class="container-header">
                                        <h3>Price Chart</h3>
                                    </div>
                                    <div class="price-chart-range-dropdown">
                                        <div class="input-group-btn">
                                            <button type="button" class="input-dropdown-btn" data-toggle="dropdown">
                                                <span class="rbx-selection-label" data-bind="label">180 Days</span>
                                                <span class="icon-down-16x16"></span>
                                            </button>
                                            <ul data-toggle="dropdown-menu" class="dropdown-menu" role="menu">
                                            <li><a id="price-chart-30-days" class="price-chart-range" data-days="30">30 Days</a></li>
                                            <li><a id="price-chart-90-days" class="price-chart-range" data-days="90">90 Days</a></li>
                                            <li class="active"><a id="price-chart-180-days" class="price-chart-range" data-days="180">180 Days</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="price-chart-legend">
                                        <div class="line"></div>
                                        <div class="text-pastname legend-text">Recent Average Price</div>
                                        <div class="line volume"></div>
                                        <div class="text-pastname legend-text">Volume</div>
                                    </div>
                                    <div class="price-chart-container" data-asset-id="@Model.Id"></div>
                                    <div class="price-chart-volume-container"></div>
                                    <div class="clearfix">
                                        <div class="price-chart-info-container clearfix">
                                            <div class="text-label">Quantity Sold</div>
                                            <div id="item-quantity-sold" class="text-lead info-content">@(Model.Sales ?? 0)</div>
                                        </div>
                                        <div class="price-chart-info-container clearfix">
                                            <div class="text-label">Original Price</div>
                                            <div id="item-original-price" class="info-content">
                                                <span id="original-price-robux-icon" class="icon-robux-20x20"></span>
                                                <span class="text-robux">@(Model.OriginalPriceRobux?.ToString("N0") ?? "0")</span>
                                            </div>
                                        </div>
                                        <div class="price-chart-info-container clearfix">
                                            <div class="text-label">Average Price</div>
                                            <div class="info-content">
                                                <span class="icon-robux-20x20"></span>
                                                <span id="item-average-price" class="text-robux">@(Model.RecentAveragePrice.ToString("N0"))</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="no-price-chart-data" class="section-content-off hide">No historical data to chart.</div>
                                <div class="section-content price-chart-spinner">
                                    <div class="loading-animated"><div><div></div><div></div><div></div></div></div>
                                </div>
                            </div>
                            <div id="resellers" class="tab-pane resellers-container">
                                <div class="container-header">
                                    <h3>Resellers</h3>
                                </div>
                                <div class="section-content">
                                    <div class="resellers">
                                        <ul class="vlist resellers-list" data-asset-id="@Model.Id">
                                            <li class="reseller-template list-item">
                                                <a class="avatar avatar-headshot-md list-header">
                                                    <img class="avatar-card-image">
                                                </a>
                                                <div class="resale-info">
                                                    <a class="text-name username"></a>
                                                    <span class="separator">-</span>
                                                    <span class="serial-number"></span>
                                                    <div class="reseller-price-container">
                                                        <span class="icon-robux-20x20"></span>
                                                        <span class="icon-robux-16x16"></span>
                                                        <span class="text-robux"></span>
                                                    </div>
                                                </div>
                                                <button class="PurchaseButton btn-fixed-width btn-buy-md buy-resale-btn" data-button-type="reseller"> Buy </button>
                                            </li>
                                        </ul>
                                        <div class="loading-animated">
                                            <div><div></div><div></div><div></div></div>
                                        </div>
                                    </div>
                                    <button class="btn-control-sm see-more-resellers">See More</button>
                                    <div class="section-content-off">Sorry, no one is reselling this item at the moment.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    }
                    <div ng-modules="robloxApp, recommendations">
                        <script>
                            var Roblox = Roblox || {};
                            Roblox.InventoryData = {
                                "inventoryDomain": "https://inventory.roblox.com",
                                "useInventorySite": false
                            };
                        </script>
                        <div class=current-items ng-controller=recommendationsController ng-init="initializeWithModelValues(@Model.Id, 32, 7)" ng-show="recommendationsData.items.length > 0" ng-cloak>
                            <div class="container-list recommendations-container">
                                <div class="container-header recommendations-header">
                                    <h3>Recommended {{ recommendationsData.assetTypeName | capitalize }}</h3>
                                </div>
                                <div class=recommended-items-slider>
                                    <ul class="hlist item-cards recommended-items" ng-class="{'item-cards-embed' : recommendationsLayout.numberOfItemsToDisplay &lt; 7}">
                                        <li ng-repeat="item in recommendationsData.items" class="list-item item-card recommended-item">
                                            <div class="item-card-container recommended-item-link"><a ng-href={{item.Item.AbsoluteUrl}} class=item-card-link>
                                                    <div class="item-card-thumb-container recommended-thumb"><img ng-src={{item.Thumbnail.Url}} thumbnail=item.Thumbnail image-retry class=item-card-thumb> <span ng-show=item.AssetRestrictionIcon ng-class="'icon-' + item.AssetRestrictionIcon.CssTag + '-label'"> </span></div>
                                                    <div class="text-overflow item-card-name recommended-name" title="{{ item.Item.Name }}">{{ item.Item.Name }}</div>
                                                </a>
                                                <div ng-if=item.Item.AudioUrl class=MediaPlayerControls>
                                                    <div class="MediaPlayerIcon icon-play" data-mediathumb-url={{item.Item.AudioUrl}} data-jplayer-version=2.9.2></div>
                                                </div>
                                                <div class="text-overflow item-card-creator recommended-creator"><span class="xsmall text-label recommended-creator-by">By</span> <a class="xsmall text-overflow text-link" ng-href={{item.Creator.CreatorProfileLink}}>{{ item.Creator.Name }}</a></div>
                                                <div class="text-overflow item-card-price"><span class=icon-robux-16x16 ng-show=item.HasPrice></span> <span class=text-robux ng-show=item.HasPrice>{{ item.Item.Price | abbreviate : 1 }}</span> <span class=text-label ng-hide=item.HasPrice> <span ng-if="item.Product.NoPriceText.length > 0" ng-class="{'text-robux': item.Product.NoPriceText === 'Free'}"> {{item.Product.NoPriceText}} </span> </span></div>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (Model.AllowComments && User?.Identity?.IsAuthenticated == true)
                    {
                        <div>
                        <div id=AjaxCommentsContainer class=comments-container data-asset-id="@Model.Id" data-total-collection-size="" data-is-user-authenticated="@User.Identity.IsAuthenticated.ToString().ToLower()" data-signin-url="https://web.roblox.com/newlogin?returnUrl=%2Fcatalog%2F@Model.Id%2F@Model.Name">
                            <div class=container-header>
                                <h3>Comments</h3>
                            </div>
                            <div class="section-content AddAComment">
                                <div id=send-comment-captcha></div>
                                <div class="comment-form">
                                    <form class="form-horizontal ng-pristine ng-valid" role=form>
                                        <div class=form-group><textarea class="form-control input-field rbx-comment-input blur" placeholder="Write a comment!" rows=1></textarea>
                                            <div class=rbx-comment-msgs><span class=rbx-comment-error text-error text-overflow"></span> <span class=rbx-comment-count small"></span></div>
                                        </div><button type=button class="btn-secondary-md rbx-post-comment">Post Comment</button>
                                    </form>
                                </div>
                                <div class="comments vlist"></div>
                                <div class=comments-item-template>
                                    <div class="comment-item list-item">
                                        <div class="comment-user list-header">
                                            <div class="Avatar avatar avatar-headshot-md" data-user-id=comment-author-id data-image-size=small></div>
                                        </div>
                                        <div class="comment-body list-body"><a class=text-name>username</a>
                                            <p class="comment-content list-content">text</p><span class="xsmall text-date-hint">4 hours ago</span>
                                        </div>
                                        <div class=comment-controls><a class="rbx-comment-report-link abuse-report-modal" href="https://web.roblox.com/abusereport/comment?id=%CommentID&amp;RedirectUrl=%PageURL" title="Report Abuse"><span class=icon-flag></span></a></div>
                                    </div>
                                </div>
                                <div class=loader-template style="display:none">
                                    <div class=loading-animated>

                                        <div>
                                            <div></div>
                                            <div></div>
                                            <div></div>
                                        </div>
                                    </div>
                                </div>
                                <div id=AjaxCommentsMoreButtonContainer class=ajax-comments-more-button-container><button type=button class="btn-control-sm rbx-comments-see-more hidden">See More</button></div>
                            </div>

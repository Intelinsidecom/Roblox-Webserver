    @if (Model.IsLimited)
    {
    <style>
        .sell-dialog-wide .modal-top-body { display: flex; align-items: flex-start; gap: 16px; }
        .sell-dialog-wide .modal-image-container { flex: 0 0 auto; min-height: auto; text-align: left; }
        .sell-dialog-wide .modal-thumb { height: 120px; width: 120px; object-fit: cover; margin: 0; border-radius: 4px; }
        .sell-dialog-wide .modal-message { flex: 1; }
        .sell-dialog-wide .modal-dialog { width: 420px; }
    </style>
    <script>
        $(function() {
            var assetId = @Model.Id;
            var userId = '@(User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")';
            var isAuthenticated = '@(User?.Identity?.IsAuthenticated == true)' === 'True';

            function loadResellers(offset) {
                offset = offset || 0;
                $.get('/catalog-api/' + assetId + '/resellers?offset=' + offset + '&count=10', function(data) {
                    var list = $('.resellers-list');
                    if (offset === 0) list.empty();
                    if (data.data && data.data.length > 0) {
                        $.each(data.data, function(i, r) {
                            var serialHtml = r.serialNumber ? ' <span class=separator>-</span> <span class=serial-number>#' + r.serialNumber + '</span>' : '';
                            var item = '<li class="list-item">' +
                                '<a class="avatar avatar-headshot-md list-header" href="/users/' + r.seller.id + '/profile">' +
                                '<img class="avatar-card-image" src="/headshot-thumbnail/image?userId=' + r.seller.id + '" alt="' + r.seller.name + '">' +
                                '</a>' +
                                '<div class="resale-info">' +
                                '<a class="text-name username" href="/users/' + r.seller.id + '/profile">' + r.seller.name + '</a>' +
                                serialHtml +
                                '<div class="reseller-price-container">' +
                                '<span class="icon-robux-20x20"></span> <span class="icon-robux-16x16"></span> <span class="text-robux">' + r.price.toLocaleString() + '</span>' +
                                '</div></div>' +
                                (isAuthenticated ? '<button class="btn-fixed-width btn-buy-md buy-resale-btn" data-listing-id="' + r.listingId + '" data-price="' + r.price + '" data-seller-name="' + r.seller.name + '"> Buy </button>' : '') +
                                '</li>';
                            list.append(item);
                        });
                        if (data.data.length >= 10) {
                            $('.see-more-resellers').show();
                        } else {
                            $('.see-more-resellers').hide();
                        }
                        $('.section-content-off').hide();
                    } else if (offset === 0) {
                        $('.see-more-resellers').hide();
                        $('.section-content-off').show();
                    }
                    $('.loading-animated').hide();
                }).fail(function() {
                    $('.loading-animated').hide();
                    if (offset === 0) {
                        $('.section-content-off').show();
                    }
                });
            }

            function loadPriceChart(days) {
                days = days || 180;
                $.get('/catalog-api/' + assetId + '/pricechart?days=' + days, function(data) {
                    if (data.priceData && data.priceData.length > 0) {
                        $('#item-quantity-sold').text(data.quantitySold.toLocaleString());
                        $('#item-original-price .text-robux').text(data.originalPrice.toLocaleString());
                        $('#item-average-price').text(data.averagePrice.toLocaleString());
                    } else {
                        $('#no-price-chart-data').removeClass('hide');
                        $('.price-chart-section .section-content').hide();
                    }
                });
            }

            if ($('#resellers').length) {
                loadResellers(0);
                loadPriceChart(180);
            }

            $(document).on('click', '.see-more-resellers', function() {
                var count = $('.reseller-template').length;
                loadResellers(count);
            });

            $(document).on('click', '.buy-resale-btn', function() {
                if (!isAuthenticated) { window.location.href = '/newlogin'; return; }
                var btn = $(this);
                var listingId = btn.data('listing-id');
                var price = btn.data('price');
                var sellerName = btn.data('seller-name') || 'this seller';
                var itemName = '@Model.Name';
                Roblox.Dialog.open({
                    titleText: 'Buy Item',
                    bodyContent: 'Would you like to buy <b>' + itemName + '</b> from <b>' + sellerName + '</b> for <span class="text-robux">' + price.toLocaleString() + '</span> Robux?',
                    allowHtmlContentInBody: true,
                    onAccept: function() {
                        btn.attr('disabled', 'disabled').text('Working...');
                        $.ajax({
                            url: '/catalog-api/buyresale',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ listingId: listingId }),
                            success: function() {
                                Roblox.Dialog.close();
                                Roblox.BootstrapWidgets.ToggleSystemMessage('Purchase Completed', 2000);
                                setTimeout(function() { window.location.reload(); }, 1000);
                            },
                            error: function(xhr) {
                                var msg = xhr.responseJSON ? xhr.responseJSON.error : 'Purchase failed';
                                Roblox.Dialog.close();
                                Roblox.Dialog.open({
                                    titleText: 'Purchase Failed',
                                    bodyContent: msg,
                                    acceptText: 'OK',
                                    xToCancel: true
                                });
                                btn.removeAttr('disabled').text('Buy');
                            }
                        });
                    },
                    acceptText: 'Buy Now',
                    declineText: 'Cancel',
                    xToCancel: true
                });
            });

            $(document).on('click', '.price-chart-range', function(e) {
                e.preventDefault();
                var days = $(this).data('days');
                loadPriceChart(days);
            });

            $(document).on('click', '#sell', function(e) {
                e.stopPropagation();
                var bc = $('#ItemPurchaseAjaxData').attr('data-user-bc');
                if (bc === '0' || !bc) {
                    Roblox.Dialog.open({
                        titleText: 'Sell Your Collectible Item',
                        bodyContent: 'Only Builders Club members can re-sell collectible items. Get Builders Club today!',
                        onAccept: function() { window.location = '/premium/membership'; },
                        acceptText: 'Upgrade',
                        declineText: 'Cancel',
                        xToCancel: true
                    });
                    return;
                }
                $('#sell-modal-content').find('.form-control-label').addClass('invisible');
                var itemImage = $('#ItemPurchaseAjaxData').attr('data-imageurl') || $('#item-container img').first().attr('src');
                var rate = parseFloat($('#sell-modal-content .commission-label').data('rate')) || 0.3;
                Roblox.Dialog.open({
                    titleText: 'Sell Your Collectible Item',
                    imageUrl: itemImage,
                    cssClass: 'sell-dialog-wide',
                    bodyContent: $('#sell-modal-content').clone().attr('id', 'sell-content-wrapper').removeClass('hidden'),
                    onAccept: function() {
                        var price = parseInt($('#sell-content-wrapper').find('.sell-price').val());
                        if (!$.isNumeric(price) || Math.floor(price) != price || price <= 0) return false;
                        var avgPrice = parseInt($('#item-average-price').text().replace(/,/g, '')) || 0;
                        var warningPct = parseInt($('#sell-modal-content .below-market-warning').data('low-price-warning-percentage')) || 15;
                        var threshold = avgPrice * warningPct / 100;
                        function doSell() {
                            Roblox.Dialog.close();
                            $.post(Roblox.Endpoints.getAbsoluteUrl('/asset/toggle-sale'), {
                                assetId: assetId,
                                userAssetId: 0,
                                price: price,
                                sell: true
                            }, function(resp) {
                                if (resp.isValid) {
                                    Roblox.BootstrapWidgets.ToggleSystemMessage('Successfully placed on sale', 2000);
                                    setTimeout(function() { window.location.reload(); }, 1000);
                                } else {
                                    Roblox.BootstrapWidgets.ToggleSystemMessage('Failed to place on sale', 2000);
                                }
                            }).fail(function() {
                                Roblox.BootstrapWidgets.ToggleSystemMessage('Failed to place on sale', 2000);
                            });
                        }
                        if (avgPrice > 0 && price < avgPrice - threshold) {
                            Roblox.Dialog.open({
                                titleText: 'Sell Your Collectible Item',
                                bodyContent: $('#confirm-sell-modal').clone().attr('id', 'confirm-sell-content-wrapper').removeClass('hidden'),
                                onAccept: doSell,
                                fieldValidationRequired: true,
                                allowHtmlContentInBody: true,
                                acceptText: 'Yes',
                                declineText: 'Cancel',
                                xToCancel: true,
                                onOpenCallback: function() {
                                    var wrapper = $('#confirm-sell-content-wrapper');
                                    wrapper.find('.attempted-sell-price').text(Roblox.NumberFormatting.commas(price));
                                    wrapper.find('.average-price').text(Roblox.NumberFormatting.commas(avgPrice));
                                }
                            });
                        } else {
                            doSell();
                        }
                        return false;
                    },
                    fieldValidationRequired: true,
                    allowHtmlContentInBody: true,
                    acceptText: 'Sell Now',
                    declineText: 'Cancel',
                    xToCancel: true,
                    onOpenCallback: function() {
                        var wrapper = $('#sell-content-wrapper');
                        var input = wrapper.find('.sell-price');
                        var form = wrapper.find('.price-form');
                        var label = form.find('.form-control-label');
                        var commEl = wrapper.find('.commission');
                        var netEl = wrapper.find('.after-commission');
                        function updateCalc() {
                            var val = input.val();
                            if (!$.isNumeric(val) || Math.floor(val) != val || val <= 0) {
                                form.addClass('form-has-error');
                                label.removeClass('invisible');
                                commEl.text('');
                                netEl.text('');
                                return;
                            }
                            form.removeClass('form-has-error');
                            label.addClass('invisible');
                            var fee = Math.max(Math.round(val * rate), 1);
                            var net = val - fee;
                            commEl.text(Roblox.NumberFormatting.commas(fee));
                            netEl.text(net >= 0 ? Roblox.NumberFormatting.commas(net) : '');
                        }
                        input.on('keyup', updateCalc);
                        input.focus();
                    }
                });
            });

        });
    </script>
    }


@using RobloxWebserver.Controllers
@model List<ModelEntry>
@{
    Layout = null;
    var fallbackThumb = "/images/b35fdfe2c7856872c3695871e2efbe18.png";
}
@foreach (var item in Model)
{
    var thumbnailUrl = $"/asset-thumbnail/json?assetId={item.AssetId}";
    <div class="place asset model" data-placeid="@item.AssetId" data-name="@item.Name">
        <a class="model-image" data-retry-url="@thumbnailUrl">
            <img class="modelThumbnail" src="@(item.ThumbnailUrl ?? fallbackThumb)" alt="@item.Name" />
        </a>
        <p class="item-name-container ellipsis-overflow">@item.Name</p>
    </div>
}

@model Assemblies.Common.DevelopTabViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;
    var items = Model?.Decals ?? new List<Assemblies.Common.DevelopItem>();
    var fallbackThumb = Configuration["DefaultThumbnailUrl"] ?? "/images/default.png";
}
<div class="items-container-inner">
    <h1 class="title" style="margin-top:0 !important;margin-bottom:15px">Create Decal</h1>
    <h3 class="title" style="margin-left:15px">Don't know how? <a href="/images/Template-Decal.png">Click here</a></h3>
    <form id="decal-upload-form" method="post" enctype="multipart/form-data" action="/develop/upload-decal" style="margin-left:15px">
        <div class="form-outer" style="margin-bottom:10px">
            <div class="form-inner label-column"><span class="title">Find your decal:</span></div>
            <div class="form-inner input-column"><input type="file" id="decal-file" name="file" accept=".png, .jpg, .jpeg, .gif" required /></div>
        </div>
        <div class="form-outer" style="margin-bottom:10px">
            <div class="form-inner label-column"><span class="title">Decal Name:</span></div>
            <div class="form-inner input-column"><input type="text" id="decal-name" name="name" class="text-box" required style="margin-left:25px;width:85%" /></div>
        </div>
        <div class="form-outer">
            <div class="form-inner label-column"></div>
            <div class="form-inner input-column">
                <button type="submit" class="btn-medium btn-primary">Upload</button>
                <div id="decal-upload-error" class="text-error"></div>
            </div>
        </div>
    </form>

    <div class="models-inventory-list">
        <h1 class="header-text">Decals</h1>
        <div class="items-container">
            @if (items.Count == 0)
            {
                @await Html.PartialAsync("~/Views/Develop/Tabs/_NoItems.cshtml", "You have no Decals yet. Upload one to see it here!")
            }
            else
            {
                foreach (var item in items)
                {
                    var displayId = item.ItemId;
                    <table class="item-table" data-item-id="@item.ItemId" data-type="models" data-dropdown="#decal-dropdown-menu">
                        <tr>
                            <td class="image-col universe-image-col" style="text-align:center">
                                <a href="@item.CatalogUrl" class="game-image">
                                    <img src="@(item.ThumbnailUrl ?? fallbackThumb)" alt="Decal">
                                </a>
                            </td>
                            <td class="universe-name-col" style="padding-left:3px">
                                <a class="title notranslate" href="@item.CatalogUrl">@item.Name</a>
                                <table class="details-table">
                                    <tr>
                                        <td class="item-universe"><span>Created:</span> @item.CreatedAt.ToString("M/d/yyyy") (ID: <a href="/asset/?id=@displayId">@displayId</a>)</td>
                                    </tr>
                                </table>
                            </td>
                            <td class="edit-col" style="white-space:nowrap;padding-right:105px"><span style="color:gray">Total sales:</span> <span style="color:black">@item.Sales.ToString("N0")</span><br /><span style="color:gray">Last 7 days:</span> <span style="color:black">0</span></td>
                            <td class="menu-col">
                                <div class="gear-button-wrapper"><a href="#" class="gear-button"></a></div>
                            </td>
                        </tr>
                    </table>
                    <div class="separator"></div>
                }
            }
        </div>
        <div id="decal-dropdown-menu" class="item-dropdown-menu" style="display:none;">
            <a href="#" data-action="configure">Configure</a>
            <a href="#" data-action="advertise" class="divider-top">Advertise</a>
        </div>
    </div>
</div>